      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über die ergonomische Gestaltung des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Geräte, Maschinen, Vorrichtungen, Einrichtungen und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werkstoffe und Hilfsstoffe, ihrer Eigenschaften und Verwendungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der facheinschlägigen Normen und Vorschriften",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen von Skizzen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen und Interpretieren von technischen Unterlagen wie von Zeichnungen, Plänen, Normen, Vorschriften und Betriebsanleitungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Physik",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der allgemeinen und anorganischen Chemie",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der berufsspezifischen Mathematik wie zB Mischungsrechnungen und Rezepturberechnungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Betontechnologie wie Einteilung von Beton, Ausgangsstoffe, Betonchemie, Betoneinbau, Nachbehandlung und Kennzeichnung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betontechnologie wie Einteilung von Beton, Ausgangsstoffe, Betonchemie, Betoneinbau, Nachbehandlung, Kennzeichnung, Verfahren zur Betonherstellung, Normanforderungen (Frisch- und Festbetonprüfungen), Betonentwurf",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der schädlichen Einflüsse wie Feuchtigkeit, Kälte, Hitze, Frost, Wasser und Zugluft auf Beton",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der schädlichen Einflüsse wie Feuchtigkeit, Kälte, Hitze, Frost, Wasser und Zugluft auf Beton",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Lagerung von Feststoffen und Flüssigkeiten sowie Umgang mit den betriebsspezifischen Lagereinrichtungen für Feststoffe und Flüssigkeiten",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Wirkungsweise und Funktion von Förderanlagen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bedienen und Überwachen von Förderanlagen auch unter Verwendung rechnergestützter Systeme",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Aufbaus und der Funktion der in der Betonherstellung (Gewinnung, Aufbereitung, Produktion, Veredelung) eingesetzten Apparate und Anlagen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Verfahren zur Herstellung sowie der Einsatzmöglichkeiten von Beton und Betonerzeugnissen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Verfahren zur Herstellung von Transportbeton sowie der Einsatz- und Anwendungsmöglichkeiten von Transportbeton auf Baustellen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Materialflusses sowie des Zusammenwirkens der Apparate und Anlagen zur Produktherstellung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Maßnahmen zur Betrieb- und Arbeitssicherheit der Produktionsstätte",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Sicherstellen der Betriebs- und Arbeitssicherheit der Produktionsstätte",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus und der Funktion der Apparate und Anlagen zur Gewinnung von Rohstoffen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Einrichten, Bedienen und Überwachen der Apparate und Anlagen zur Gewinnung von Rohstoffen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einrichten, Bedienen und Überwachen der Apparate und Anlagen zur Gewinnung von Rohstoffen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus und der Funktion der Apparate und Anlagen zur mechanischen und thermischen Aufbereitung (wie zB Zerkleinern, Waschen, Klassieren, Trennen, Trocknen) von Rohstoffen sowie der Verfahrenstechniken wie Nass- und Trockenaufbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Einrichten, Bedienen und Überwachen der Apparate und Anlagen zur mechanischen oder thermischen Aufbereitung von Rohstoffen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einrichten, Bedienen und Überwachen der Apparate und Anlagen zur mechanischen oder thermischen Aufbereitung von Rohstoffen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Lagerhaltung und Lagerverwaltung (Erfassung, Abrechnung)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erfassen und Abrechnen von Lagerbeständen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Mitarbeit beim Entgegennehmen und Disponieren von Kundenbestellungen sowie beim Bestellen von evtl. notwendigen Dienstleistungen wie zB Betonpumpen, Fahrmischern oder baustofftechnischen Leistungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Entgegennehmen und Disponieren von Kundenbestellungen sowie Bestellen von evtl. notwendigen Dienstleistungen wie zB Betonpumpen, Fahrmischern oder baustofftechnischen Leistungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bestellen und Disponieren von Betonausgangsstoffen wie zB Zement, Gesteinskörnungen, Zusatzstoffen sowie auftragsgemäßes Disponieren von Mischungen mit genauer Zuteilung von Bindemitteln, Zuschlagstoffen und Wasser nach Masse- oder Raumteilen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus und der Funktion der Produktionsanlagen zur Herstellung von Transportbeton und Werkfrischmörtel",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Einrichten, Bedienen, Steuern und Überwachen der Produktionsanlagen zur Herstellung von Transportbeton und Werkfrischmörtel nach Rezepturen auch unter Verwendung rechnergestützter Systeme",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einrichten, Bedienen, Steuern und Überwachen der Produktionsanlagen zur Herstellung von Transportbeton und Werkfrischmörtel nach Rezepturen auch unter Verwendung rechnergestützter Systeme",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Einrichten, Bedienen, Steuern und Überwachen der Wiederaufbereitungsanlagen auch unter Verwendung rechnergestützter Systeme",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einrichten, Bedienen, Steuern und Überwachen der Wiederaufbereitungsanlagen auch unter Verwendung rechnergestützter Systeme",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Planen von Aufträgen gemäß Liefertermin, Liefermenge und Transportmittel",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Planen von Aufträgen gemäß Liefertermin, Liefermenge und Transportmittel",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Versand- und Lieferbegleitpapiere",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Erstellen sowie Nachbearbeiten der Versand- und Lieferbegleitpapiere",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Bedienung der Hebe- und Transporteinrichtungen (Stapler, Kräne) sowie über deren Wartung und Instandhaltung unter Berücksichtigung der von diesen Einrichtungen ausgehenden Gefahren",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Umgang mit Hebe- und Transporteinrichtungen (Stapler, Kräne) unter Berücksichtigung der von diesen Einrichtungen ausgehenden Gefahren",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Probenahme, Probenvorbereitung, Probenaufbereitung und der betriebsspezifischen Untersuchungen zur Kontrolle von Rohstoffen, Zwischen- und Endprodukten sowie Durchführen von betriebspezifischen Probenahmen und Untersuchungen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen von Prozesskontrollen und Prozessoptimierungen sowie Erfassen von Betriebsdaten sowie Protokollieren und Auswerten von Arbeitsergebnissen mit und ohne EDV-Unterstützung",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Kalibrieren von Mess- und Prüfgeräten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Messen von mechanischen und elektrischen Größen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundlegende Fertigkeiten in der Werkstoffbearbeitung von Hand und unter Verwendung von Maschinen und Geräten",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von einschlägigen lösbaren (wie zB Schrauben) und unlösbaren Verbindungen (wie zB Schweißen, Nieten, Löten, Kleben)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Elektrotechnik, Elektronik, Hydraulik und Pneumatik",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen von Reinigungs- und Wartungsarbeiten an Produktionsanlagen und –apparaten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen einfacher Instandhaltungsarbeiten sowie Erkennen und Beseitigen von Störungen an Produktionsanlagen und –apparaten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen von Gesprächen mit Vorgesetzten, Kollegen und Lieferanten unter Beachtung der fachgerechten Ausdrucksweise",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Qualitätssicherung und Qualitätskontrolle",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung des betriebsspezifischen Qualitätsmanagements einschließlich Dokumentation",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen englischen Fachausdrücke",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der betrieblichen EDV (Hard- und Software)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "46.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 des Berufsausbildungsgesetzes)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "47.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten (zB Berufsreifeprüfung)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "48.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften und Normen sowie der einschlägigen Vorschriften zum Schutz des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "49.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über die Erstversorgung bei betriebsspezifischen Arbeitsunfällen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "50.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 3
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

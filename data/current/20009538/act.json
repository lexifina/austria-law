      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachübergreifende Ausbildung (Schlüsselqualifikationen) In der Art der Vermittlung der fachlichen Kenntnisse und Fertigkeiten ist auf die Förderung folgender fachübergreifender Kompetenzen des Lehrlings Bedacht zu nehmen:",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Methodenkompetenz: zB Lösungsstrategien entwickeln, Informationen selbstständig beschaffen, auswählen und strukturieren, Entscheidungen treffen etc.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Soziale Kompetenz: zB in Teams arbeiten, Mitarbeiter/innen führen etc.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Personale Kompetenz: zB Selbstvertrauen und Selbstbewusstsein, Bereitschaft zur Weiterbildung, Bedürfnisse und Interessen artikulieren etc.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kommunikative Kompetenz: zB mit Kunden/innen, Vorgesetzten, Kollegen/innen und anderen Personengruppen zielgruppengerecht kommunizieren; Englisch auf branchen- und betriebsüblichem Niveau zum Bestreiten von Alltags- und Fachgesprächen beherrschen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeitsgrundsätze: zB Sorgfalt, Zuverlässigkeit, Verantwortungsbewusstsein, Pünktlichkeit etc.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundenorientierung: Im Zentrum aller Tätigkeiten im Betrieb hat die Orientierung an den Bedürfnissen der Kunden/innen unter Berücksichtigung der Sicherheit zu stehen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen von Gesprächen mit Vorgesetzten, Kollegen/innen, Kunden/innen und Lieferanten/innen unter Beachtung der fachgerechten Ausdrucksweise",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitwirken beim Beraten von Kunden/innen über Einsatz, Anwendung und Wartung von Schildern und Lichtwerbeanlagen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beraten von Kunden/innen über Einsatz, Anwendung und Wartung von Schildern und Lichtwerbeanlagen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Geräte, Maschinen, Vorrichtungen, Einrichtungen und Arbeitsbehelfe (Hardware und Software)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsplanung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden der berufsspezifischen Mathematik",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werkstoffe (wie zB Metalle, Kunststoffe, Verbundwerkstoffe, Glas, Holz, Papier, Textilien, Mauerwerk) und Hilfsstoffe (wie zB Lacke, Farben, Lösungsmittel, Verdünnungsmittel, Kleber), ihrer Eigenschaften sowie ihrer Verwendungsmöglichkeiten und Verarbeitungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Beschaffen, Auswählen, Annehmen Überprüfen und Lagern der betriebsspezifischen Werk- und Hilfsstoffe",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beschaffen, Auswählen, Annehmen Überprüfen und Lagern der betriebsspezifischen Werk- und Hilfsstoffe",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse über elektrotechnische Sicherheitsvorschriften",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen und Anwenden von technischen Unterlagen wie von Skizzen, Zeichnungen, Bedienungsanleitungen usw.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen von Skizzen und einfachen normgerechten technischen Zeichnungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Manuelles und maschinelles Bearbeiten von Werkstoffen wie zB durch Bohren, Schneiden, Feilen, Fräsen, Schleifen, Polieren, Umformen, Abkanten usw.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von lösbaren und unlösbaren Verbindungen (zB Schraubverbindungen, Klemm-, Löt- und Steckverbindungen)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von Schildern, Displays und sonstigen Werbeträgern (Buchstaben, Figuren, Unikate, Kunstobjekte, Spezialanfertigungen usw.)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen von Unterkonstruktionen und Trägerkonstruktionen für Schilder, Displays und sonstige Werbeträger",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der natürlichen und der künstlichen Beleuchtung insbesondere auch der Beleuchtungsgrundsätze für Werbeflächen und Leuchtbuchstabenelemente (Licht-Farbe-Form)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der berufsspezifischen Montage- und Befestigungstechniken (wie zB Dübeltechniken, Klebetechniken) unter Beachtung der rechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Montieren von Schildern, Displays und sonstigen Werbeträgern unter Beachtung der Beleuchtungsgrundsätze",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von Lichtwerbeanlagen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Montieren von Lichtwerbeanlagen unter Beachtung der Beleuchtungsgrundsätze",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Montieren von Lichtwerbeanlagen unter Beachtung der Beleuchtungsgrundsätze",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Veredelns und des Polierens von Oberflächen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Veredeln und Polieren von Oberflächen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Veredeln und Polieren von Oberflächen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Farbenlehre (Farbtechnologie), Farbordnungssysteme und Farbpsychologie",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Abstimmen, Mischen und Nachmischen von Farbtönen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Abstimmen, Mischen und Nachmischen von Farbtönen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitwirken beim Planen, Entwerfen und Gestalten (auch rechnergestützt) von Schriften und bildlichen Darstellungen unter Beachtung der Zusammenhänge von Form und Farbe nach eigenen Ideen oder nach Vorgaben",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Planen, Entwerfen und Gestalten (auch rechnergestützt) von Schriften und bildlichen Darstellungen unter Beachtung der Zusammenhänge von Form und Farbe nach eigenen Ideen oder nach Vorgaben",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Bedeutung und der Bausteine eines CI (Corporate ldentity) und CD (Corporate Design)-Konzeptes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitwirken beim Erstellen eines CI (Corporate ldentity) und CD (Corporate Design)-Konzeptes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erstellen eines CI (Corporate ldentity) und CD (Corporate Design)-Konzeptes",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der manuellen und maschinellen (auch rechnergestützten) Arbeitsverfahren zur Herstellung von Schriften und bildlichen Darstellungen wie durch Schreiben, Malen, Schneiden, Fräsen, Spritzen sowie der dazu notwendigen Werkzeuge und Geräte wie Pinsel, Schneidewerkzeug usw.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Manuelles Herstellen von Schriften und bildlichen Darstellungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim maschinellen (auch rechnergestützten) Herstellen von Schriften und bildlichen Darstellungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Maschinelles (auch rechnergestütztes) Herstellen von Schriften und bildlichen Darstellungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis von Blattmetallverarbeitungstechniken wie Vergolden und Versilbern",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Anwenden von Blattmetallverarbeitungstechniken wie Vergolden und Versilbern",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden von Blattmetallverarbeitungstechniken wie Vergolden und Versilbern",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Berufsspezifische Kenntnis des Digitaldrucks, des Siebdrucks, des Non-Impact-Drucks, der Lasertechnik und des digitalen Folienschnittes sowie der dazu notwendigen Arbeitsschritte",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus, der Funktion und der Bedienung der betriebs- und berufsspezifischen Produktionsgeräte (zB Digitaldruckanlagen, Schneideplotter, Siebdruck usw.)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Einrichten, Bedienen und Überwachen von betriebs- und berufsspezifischen Produktionsgeräten sowie beim Erkennen und Beseitigen von einfachen Ablaufstörungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einrichten, Bedienen und Überwachen von betriebs- und berufsspezifischen Produktionsgeräten sowie Erkennen und Beseitigen von einfachen Ablaufstörungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erstellen von berufsspezifischen Druckvorlagen und -daten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Herstellen von berufsspezifischen Druckprodukten mittels Digitaldruck, Siebdruck und Veredelung zB mittels digitalen Folienschnittes",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Herstellen von berufsspezifischen Druckprodukten mittels Digitaldruck, Siebdruck und Veredelung zB mittels digitalen Folienschnittes",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Prüfens, Vorbereitens und Beschichtens von Untergründen (Metalle, Kunststoffe, Verbundwerkstoffe, Glas, Holz, Mauerwerk) für Applikationen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Prüfen, Vorbereiten und Beschichten von Untergründen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Prüfen, Vorbereiten und Beschichten von Untergründen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Applizieren (mittels Malen, Lackieren, zwei- und dreidimensionalem Verkleben mit Folien, Bedrucken usw.) von Schriften und bildlichen Darstellungen auf unterschiedlichste Untergründe sowie sonstige bewegliche und stabile Werbeträger",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Applizieren (mittels Malen, Lackieren, zwei- und dreidimensionalem Verkleben mit Folien, Bedrucken usw.) von Schriften und bildlichen Darstellungen auf unterschiedlichste Untergründe sowie auf sonstige bewegliche und stabile Werbeträger",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Instandsetzen und Restaurieren von Produkten wie zB von Schildern und Lichtwerbeanlagen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "46.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kontrollieren und Prüfen der hergestellten Produkte (zB Schilder und Lichtwerbeanlagen) und der ausgeführten Arbeiten sowie Erkennen und Beheben von Mängeln",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "47.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der berufspezifischen Normen und Rechtsvorschriften",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "48.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis einschlägiger englischer Fachausdrücke",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "49.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse der Kalkulation",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "50.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 Berufsausbildungsgesetz – BAG)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "51.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "52.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "53.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften und Normen sowie der einschlägigen Vorschriften zum Schutz des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "54.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 3
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

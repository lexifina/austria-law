      "notes": [
        {
          "kind": "Beachte für folgende Bestimmung",
          "text": "Fahrzeuge, die vor dem 1. Jänner 2021 als Mietwagen unter der Verwendungsbestimmung 29 zugelassen sind und ab 1. Jänner 2021 unter die Verwendungsbestimmung 25 fallen, dürfen die bestehende Verwendungsbestimmung noch bis 31. August 2021 führen (vgl. § 14 Abs. 8)."
        }
      ],
      "links": [
        {
          "text": "BGBl. Nr. 159/1960",
          "url": "https://ogd.ris.bka.gv.at/Dokumente/BgblPdf/1960_159_0/1960_159_0.pdf"
        },
        {
          "text": "BGBl. I Nr. 6/2017",
          "url": "https://ogd.ris.bka.gv.at/eli/bgbl/I/2017/6"
        },
        {
          "text": "BGBl. I Nr. 30/2002",
          "url": "https://ogd.ris.bka.gv.at/Dokumente/BgblPdf/2002_30_1/2002_30_1.pdf"
        }
      ],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "Kennziffer",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verwendungsbestimmung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "01",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zu keiner besonderen Verwendung bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "10",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung im Rahmen eines land- und forstwirtschaftlichen Betriebes bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "19",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung für den Werkverkehr bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "20",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung für die gewerbsmäßige Beförderung bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "22",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung für die gewerbsmäßige Vermietung ohne Beistellung eines Lenkers bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "23",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung bei Spediteuren bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Beförderung von gefährlichen Gütern bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "25",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung im Rahmen des Taxigewerbes bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "26",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung von Möbeltransporten bestimmt (§ 106 Abs. 13 KFG 1967)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "27",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung als Schulfahrzeug gemäß § 112 Abs. 3 KFG 1967 bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "28",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung im Rahmen des Schaustellergewerbes bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "29",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung für die entgeltliche Personenbeförderung im Rahmen des Ausflugswagen-, Stadtrundfahrten-, Mietwagengewerbes mit Omnibussen oder Gästewagengewerbes bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "30",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung im Bereich des Straßendienstes gemäß § 27 Abs. 1 StVO 1960 BGBl. Nr. 159/1960, zuletzt geändert mit BGBl. I Nr. 6/2017 (StVO 1960) bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "31",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "ausschließlich oder vorwiegend zur Verwendung für Arbeiten des Straßendienstes auf beleuchteten Straßen bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "32",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung im Bereich der Kanalwartung und –revision gemäß § 27 Abs. 5 StVO 1960 bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "33",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur kommunalen Verwendung in einer Gebietskörperschaft oder in einem Gemeindeverband bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "40",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung für den Pannenhilfsdienst bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "41",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Begleitung von Sondertransporten durch gemäß § 97 Abs. 2 StVO 1960 beeidete Straßenaufsichtsorgane bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "50",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung für Diplomaten bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "51",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung für Konsuln bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "60",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "ausschließlich oder vorwiegend zur Verwendung für den öffentlichen Hilfsdienst bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "61",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung im Bereich der Post- und Telegraphenverwaltung bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "62",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung für den Rettungsdienst einer Gebietskörperschaft oder für einen in § 23 Abs. 1 Z 1 bis 5 Sanitätergesetz, BGBl. I Nr. 30/2002 namentlich genannten Rettungsdienst bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "63",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "ausschließlich oder vorwiegend für die Feuerwehr bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "64",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "ausschließlich oder vorwiegend für den privaten Rettungsdienst bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "65",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung im Bereich der Österreichischen Bundesbahnen bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "70",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung im Bereich der Finanzverwaltung bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "71",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung im Bereich der Steuerfahndung bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "72",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung im Bereich des öffentlichen Sicherheitsdienstes bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "74",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung im Bereich der Bergrettung bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "79",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung im Bereich des Bundesheeres oder der Heeresverwaltung bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "80",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung für Fahrten des Bundespräsidenten bei feierlichen Anlässen bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "81",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur Verwendung für Staatsfunktionäre bestimmt",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]

                "text": "Stoffe:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verwendung nur zulässig für:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Amitrol",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Obst- und Weinbau in feuchten Lagen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Daminozid",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zierpflanzenbau",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "-HCH (Lindan) mit mindestens 99,5% Reinheit",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "gewerbliche Saatgutbehandlung im Ackerbau",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "8-Hydroxychinolin und seine Salze",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rebveredelung im Weinbau",

      "source_fingerprint": "1f3139fc13dcc0f118077908b81ac05ca7099ef7a4bddf38bdaaf58a136e74c2",
      "sha256": "94ac95418f633b375cd98f5a907759c89b8f7b7a577d3e8479cb85651cb0c45e",
      "notes": [],
      "links": [
        {
          "text": "BGBl. Nr. 599/1987",
          "url": "https://ogd.ris.bka.gv.at/Dokumente/BgblPdf/1987_599_0/1987_599_0.pdf"
        }
      ],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachübergreifende Ausbildung (Schlüsselqualifikationen) In der Art der Vermittlung der fachlichen Kenntnisse und Fertigkeiten ist auf die Förderung folgender fachübergreifender Kompetenzen des Lehrlings Bedacht zu nehmen:",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Methodenkompetenz: zB Lösungsstrategien entwickeln, Informationen selbstständig beschaffen, auswählen und strukturieren, Entscheidungen treffen etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Soziale Kompetenz: zB in Teams arbeiten, Mitarbeiter/innen führen etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Personale Kompetenz, zB Selbstvertrauen und Selbstbewusstsein, Bereitschaft zur Weiterbildung, Bedürfnisse und Interessen artikulieren etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kommunikative Kompetenz: zB mit Kunden/innen, Vorgesetzten, Kollegen/innen und anderen Personengruppen zielgruppengerecht kommunizieren; Englisch auf branchen- und betriebsüblichem Niveau zum Bestreiten von Alltags- und Fachgesprächen beherrschen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeitsgrundsätze: zB Sorgfalt, Zuverlässigkeit, Verantwortungsbewusstsein, Pünktlichkeit etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundenorientierung: im Zentrum aller Tätigkeiten im Betrieb hat die Orientierung an den Bedürfnissen der Kunden/innen unter Berücksichtigung der Sicherheit zu stehen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsplanung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen von Gesprächen mit Vorgesetzten, Kollegen/innen, Kunden/innen und Lieferanten/innen unter Beachtung der fachgerechten Ausdrucksweise",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitwirken beim Beraten und Betreuen von Kunden/innen in Energie-, Klima- und Umweltfragen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beraten und Betreuen von Kunden/innen in Energie-, Klima- und Umweltfragen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Geräte, Maschinen, Vorrichtungen, Einrichtungen und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werk- (keramische Bauteile, Schamott- und Mauersteine, Natur- und Kunststeine) und Hilfsstoffe (wie zB Zement, Gips, Kleber usw.), ihrer Eigenschaften, Verwendungs-, Verarbeitungs- und Wiederverwertungsmöglichkeiten sowie über deren fachgerechte Lagerung",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der handels- und branchenüblichen Materialbezeichnungen und Fachausdrücke",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Entstehung, Entwicklung und Geschichte der Keramik und des Ofenbaues",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Brennstofflehre (feste, flüssige und gasförmige Brennstoffe) und anderer Energieträger",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Verbrennungslehre (Verbrennungsphasen, Brennwert, Heizwert, Heizwertbestimmung, Emissionen, Abgasmessung, Abgasanalysen)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Bauphysik (zB Wärme- und Feuchtigkeitsschutz, Raumklima, Luftfeuchtigkeit, U-Werte, Wärmestrahlung, Brandschutz, Schallschutz)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus und der Funktion von Öfen und Heizungsanlagen für Einzelraum-, Mehrraum- oder Ganzhausheizungen für feste, flüssige und gasförmige Brennstoffe sowie andere Energieträger (zB Kachelöfen, Kombiöfen, Heizkaminen, Küchenherden, offenen Kaminen, Sonderformen, Gas-Einsatz-Kachelöfen und Elektro-Heizungen)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Rauchfanglehre (Bauweisen, Kaminzug, Zugstörungen, Rauchfanganschluss)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Dimensionierung von wasserführenden Leitungen sowie von Rohrleitungssystemen (inklusive Sicherheits-einrichtungen) zur Verteilung von Warmwasser als Energieträger",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Auswahl, der Eingangskontrolle, des Transportes und der Lagerung von keramischen Bauteilen, Schamott- und Mauersteinen sowie von Natur- und Kunststeinen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Auftragsbezogenes Auswählen und Überprüfen der Materialien",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von technischen Unterlagen (zB Montageanweisungen, Anschlusspläne, Einbauanleitungen, Ofen- und Montagepläne)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erstellen von technischen Zeichnungen (zB Ofen- und Montagepläne, Luftleitungssysteme)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen berufsspezifischer Berechnungen (zB Wärmebedarfsberechnungen, Ofenberechnungen und Zugberechnungen, Rauchfangberechnungen, Luftleitungssystemen, Grundlagen für die Erstellung von Energieausweisen) auch unter Verwendung rechnergestützter Systeme",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Farbenlehre (Farbwahl im Hinblick auf Farbästhetik und Farbharmonie)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Manuelles und maschinelles Bearbeiten von Metallen und Kunststoffen (wie zB Bohren, Schleifen, Umformen, Trennen, Löten, Schweißen)",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Manuelles und maschinelles Bearbeiten von keramischen Bauteilen (wie zB Behauen, Schleifen, Schneiden, Lochen) und Schamott- und Mauersteinen sowie von Natur- und Kunststeinen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Elektrotechnik",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Mess-, Steuer- und Regeltechnik",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von Kleber-, Mörtel- und Putzmischungen sowie Ausführen von berufsspezifischen Maurer- und Verputzarbeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verlegen von Wand- und Bodenbelägen sowie von Stufenverkleidungen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Setzen von Kachelmänteln (inklusive Heiztüren und Putzöffnungen), Simsteilen und Abdeckungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verkleiden von Heizungsanlagen mit Natur- und Kunststeinen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Ausführen des Innenausbaus (Heizkammern auskleiden, Heizgaszüge einbauen) nach einschlägigen Berechnungs-unterlagen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Herstellen des Anschlusses der Feuerstätte an den Rauchfang",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Herstellen des Anschlusses der Feuerstätte an den Rauchfang",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Montieren von Warmluftheizungen inklusive Einbau von Komponenten wie Heizeinsätze, Luftklappen, Ventilatoren, Luftleitungsrohren",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Montieren von Elektroheizungen wie zB Einsetzen von Elektrospeicherkernen in den Kachelmantel und deren Verdrahtung sowie Einbringen des Wärmeschutzes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Montieren von Gas- und Öl-Einsätzen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Aufstellen von Küchenherden inklusive Montieren von Herdplatte, Heizbrust, Deckel, Schutzstange, Putztüre usw.",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Montieren der Bauteile von offenen Kaminen wie Rauchschürzen, Klappen, Kamineinsätzen usw.",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Montieren von Ganzhausheizungen inklusive Einbauen und Einbinden von Luft-Wasser-Wärmetauschern",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Einbauen von Mess-, Steuer- und Regelsystemen in Öfen und Heizungsanlagen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Durchführen von Funktionsanalysen (Sicherstellen der Funktion von Rohrleitungssystemen, elektronischen Regelanlagen, Durchführen von Probeheizungen) und Abgasanalysen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitarbeit beim Übergeben der Heizungsanlage und Einschulen des/der Kunden/in",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Übergeben der Heizungsanlage und Einschulen des/der Kunden/in",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anlegen von Dokumentationen über die Arbeitsabläufe sowie über Arbeitsstunden und Materialverbrauch (wie zB Bautagebücher, Pflichtenhefte) auch unter Verwendung rechnergestützter Systeme",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Anbieten und Durchführen von Instandhaltungs- und Servicearbeiten an Heizungssystemen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der berufsspezifischen Normen und Rechtsvorschriften (zB technische Bauvorschriften, Bauordnungen)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "46.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der verkaufsbezogenen rechtlichen Bestimmungen (zB Angebot, Kaufvertrag, Lieferschein, Rechnungen)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "47.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse der verkaufs-gerechten Warenpräsentation",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "48.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "49.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Qualitätssicherung einschließlich der Reklamationsbearbeitung und Durchführung von betriebsspezifischen, qualitätssichernden Maßnahmen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "50.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der betriebsspezifischen Hard- und Software",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "51.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "52.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen elektrotechnischen und hydraulischen Sicherheitsvorschriften und Normen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "53.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften insbesondere des Brandschutzes sowie der sonstigen in Betracht kommenden Vorschriften zum Schutze des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "54.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Erstversorgung bei betriebsspezifischen Arbeitsunfällen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "55.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "56.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 BAG)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "57.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 4
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

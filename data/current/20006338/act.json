        }
      ],
      "links": [
        {
          "text": "BGBl. I Nr. 33/2007",
          "url": "https://ogd.ris.bka.gv.at/eli/bgbl/I/2007/33"
        },
        {
          "text": "BGBl. I Nr. 57/2008",

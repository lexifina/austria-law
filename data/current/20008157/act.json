          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "Hat die Regelung/das Vorhaben Auswirkungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vertiefende Fragen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.1. auf die unselbstständige Erwerbstätigkeit von Frauen und Männern?",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2.1.a. Auswirkungen auf die unselbstständige Erwerbstätigkeit von Frauen und Männern (z.B. auf Vollzeit-/Teilzeitarbeitsplätze, feste Anstellungen, freie Dienstverträge, Werkverträge, Leitungspositionen)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.2. Ist das Regelungs- oder sonstige Vorhaben beziehungsweise die Maßnahme geeignet, den Zugang zur allgemeinen oder beruflichen Bildung, die Bildungswahl, die Bildungsbeteiligung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2.2.a. Auswirkungen auf die Bildungsbeteiligung von Frauen und Männern (z.B. betroffene Schultypen, geschlechtsspezifische Unterschiede, Zahl der Neuanfänge, Abschlüsse, etc.)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "und/oder den Bildungsabschluss zu beeinflussen?",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2.2.b. Gleichstellungsfördernde Maßnahmen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.3. Einkommenseffekte",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2.3.a. Erwartete Veränderung der Einkommensdifferenz",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },

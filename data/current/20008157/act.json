                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1.2.b. Wirkung der Leistung auf die Gleichstellung von Frauen und Männern",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1.2.c. Nutzerinnen/Nutzer der begünstigten Institution sowie mittelbare Leistungsempfängerinnen/Leistungsempfänger der Institution",
                "rowspan": 1,
                "colspan": 1
              }

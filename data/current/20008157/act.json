                "colspan": 1
              }
            ],
            [
              {
                "text": "Öffentliche Einnahmen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "4. Auswirkungen auf öffentliche Einnahmen (Steuern, Abgaben, Gebühren)?",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Entscheidungsprozesse und –gremien",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "5. Auswirkungen auf die Teilhabe an Entscheidungsprozessen oder die Zusammensetzung von Entscheidungsgremien?",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Körperliche und seelische Gesundheit",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "6. Auswirkungen auf die körperliche oder seelische Gesundheit von Frauen und Männern (z.B. Schutz vor Gewalt)?",

    {
      "designation": "Art. 17",
      "source_heading": "Artikel 17 - Das Recht der Kinder und Jugendlichen auf sozialen, gesetzlichen und wirtschaftlichen Schutz",
      "source_record_id": null,
      "source_locator": {
        "kind": "documentContent_index",
        "index": 17,
        "stable_identity": false
      },
      "file": "art-017.md",
      "source_context": null,
      "identity_review_required": false,
      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "d6199543d9dba800de0f15a65214199da1a71265a9c73811e669e356b1485a77",
      "sha256": "adc2c61bf568f8b54f8743f2d46cf28e306acf04f7d63ce816f707da43bb2d3c",
      "notes": [],
      "links": [],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "a)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kindern und Jugendlichen unter Berücksichtigung der Rechte und Pflichten ihrer Eltern die Betreuung, Unterstützung, Erziehung und Ausbildung zu gewährleisten, deren sie bedürfen, insbesondere dadurch, dass für diesen Zweck angemessene und ausreichende Einrichtungen und Dienste geschaffen oder unterhalten werden;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "b)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kinder und Jugendliche gegen Vernachlässigung, Gewalt und Ausbeutung zu schützen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "c)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kindern und Jugendlichen, denen vorübergehend oder endgültig die Unterstützung durch die Familie fehlt, den Schutz und die besondere Hilfe des Staates zu gewährleisten;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kindern und Jugendlichen eine unentgeltliche Schulbildung in der Primar- und Sekundarstufe zu gewährleisten sowie den regelmäßigen Schulbesuch zu fördern.",
                "rowspan": 1,
                "colspan": 2
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

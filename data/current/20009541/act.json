      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachübergreifende Ausbildung (Schlüsselqualifikationen) In der Art der Vermittlung der fachlichen Kenntnisse und Fertigkeiten ist auf die Förderung folgender fachübergreifender Kompetenzen des Lehrlings Bedacht zu nehmen:",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Methodenkompetenz, zB Lösungsstrategien entwickeln, Informationen selbstständig beschaffen, auswählen und strukturieren, Entscheidungen treffen etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Soziale Kompetenz, zB in Teams arbeiten, Mitarbeiter/innen führen etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Personale Kompetenz, zB Selbstvertrauen und Selbstbewusstsein, Bereitschaft zur Weiterbildung, Bedürfnisse und Interessen artikulieren etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kommunikative Kompetenz, zB mit Kunden/innen, Vorgesetzten, Kollegen/innen und anderen Personengruppen zielgruppengerecht kommunizieren; Englisch auf branchen- und betriebsüblichem Niveau zum Bestreiten von Alltags- und Fachgesprächen beherrschen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeitsgrundsätze, zB Sorgfalt, Zuverlässigkeit, Verantwortungsbewusstsein, Pünktlichkeit etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundenorientierung: Im Zentrum aller Tätigkeiten im Betrieb hat die Orientierung an den Bedürfnissen der Kunden/innen unter Berücksichtigung der Sicherheit zu stehen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsplanung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Maschinen, Geräte, Vorrichtungen, Einrichtungen und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Holzarten, ihrer Eigenschaften, Verwendungsmöglichkeiten und Bearbeitungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erstellen von Skizzen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen und Anwenden von Skizzen und technischer Unterlagen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Bedeutung und der Ziele des Umweltschutzes sowie der Bedeutung der Lebensräume für Mensch, Tier und Pflanzen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Bodens (Bestandteile, Eigenschaften, Humusformen) sowie der Baume und Sträucher",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beurteilen von Böden",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis von waldbaulichen Grundsätzen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Ursachen von Waldbränden; Durchführen von Maßnahmen zur Waldbrandverhütung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Pflanzens sowie des Vorbereitens von Verjüngungs- und Kulturflächen im Wald und auf Forstflächen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Pflanzen sowie beim Vorbereiten von Verjüngungs- und Kulturflächen im Wald und auf Forstflächen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Pflanzen sowie Vorbereiten von Verjüngungs- und Kulturflächen im Wald und auf Forstflächen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Maßnahmen zur Kulturpflege, zur Pflege von Jungbeständen sowie der Auszeige und der Maßnahmen zur Durchforstung im Jungbestand und auf Forstflächen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Durchführen von Maßnahmen zur Kulturpflege, Pflegen von Jungbeständen sowie bei der Auszeige und beim Durchführen von Maßnahmen zur Durchforstung im Wald und auf Forstflächen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Durchführen von Maßnahmen zur Kulturpflege, Pflegen von Jungbeständen sowie der Auszeige und Durchführen von Maßnahmen zur Durchforstung im Wald und auf Forstflächen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Schäden und Schutzmaßnahmen für Pflanzen; Mitarbeiten bei Schutzmaßnahmen im Wald und auf Forstflächen (wie zB gegen Wildschäden und Forstschädlinge)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erkennen von Schäden an Pflanzen und Durchführen von Schutzmaßnahmen für Böden und Pflanzen im Wald und auf Forstflächen (wie zB gegen Wildschäden und Forstschädlinge)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der ökologischen und ökonomischen Auswirkungen von Fällungs- und Bringungsschäden",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der nichtmechanisierten und mechanisierten Holzerntesysteme",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bestands- und bodenschonendes Durchführen von nicht-mechanisierten und mechanisierten Holzerntemaßnahmen (zB Auszeige, Anlegen und Trassieren einer Seiltrasse usw.) sowie Mitarbeiten bei der manuellen und motormanuellen Holzernte unter Beachtung der besonderen Unfallverhütungsvorschriften",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der vollmechanisierten Holzernte, Holzrückung und Holzbringung sowie der dafür besonderen Unfallverhütungsvorschriften",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Sortiervorschriften und Holzmessverfahren sowie Mitarbeiten beim Vermessen und Sortieren von Rohholz inklusive Datenerfassung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vermessen, Sortieren und marktgerechtes Aufbereiten von Rohholz",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse über Aufbau, Funktion und Bedienung von Seilgeräten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnisse über Aufbau, Funktion und Bedienung von Seilgeräten und der besonderen Unfallverhütungsvorschriften",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitarbeiten bei der Holzbringung mittels Seilgeräten unter Beachtung der besonderen Unfallverhütungsvorschriften",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Lagerungsmöglichkeiten sowie der Schutz- und Konservierungsmaßnahmen von Rohholz",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Anlegen und Instandhalten von Holzlagerplätzen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Anlegen und Instandhalten von Holzlagerplätzen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Erhalten und Wiederinstandsetzen von Wald- und Forstwegen (unter Berücksichtigung der Bestimmungen des KJBG, insb. hinsichtlich des Arbeitens mit gefährlichen Arbeitsmitteln)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erhalten und Wiederinstandsetzen von Wald- und Forstwegen (unter Berücksichtigung der Bestimmungen des KJBG, insb. hinsichtlich des Arbeitens mit gefährlichen Arbeitsmitteln)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Wiederinstandsetzen von einfachen forstlichen und jagdlichen Einrichtungen (soweit diese Tätigkeiten keinem anderem reglementierten Gewerbe vorbehalten sind)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Wiederinstandsetzen von einfachen forstlichen und jagdlichen Einrichtungen (soweit diese Tätigkeiten keinem anderem reglementierten Gewerbe vorbehalten sind)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Manuelles berufsspezifisches Bearbeiten von Werkstoffen (zB Holz)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Maschinelles berufsspezifisches Bearbeiten von Werkstoffen (zB Holz)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einfaches Zerlegen, Warten und Zusammenbauen von mechanischen Teilen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zusammenbauen, Zerlegen und Instandsetzen von Maschinen und Geräten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der elektrotechnischen Sicherheitsvorschriften",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Maschinen für Holzernte, Holzrückung und Holzbringung sowie der Maschinen zur Bodenvorbereitung und Pflanzung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Bodenvorbereitung und Pflanzung",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Überprüfen, Warten und Instandsetzen von Maschinen zur Holzernte, Holzrückung und Holzbringung sowie zur Bodenvorbereitung und Pflanzung",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lenken von land- und forstwirtschaftlichen Fahrzeugen gemäß Führerschein der Klasse F",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung einer praxisorientierten, verkehrssicheren, wirtschaftlichen, umweltbewussten und rücksichtsvollen Fahrweise",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Richtiges Verhalten bei Verkehrsunfällen, sonstigen Zwischenfällen und außergewöhnlichen Situationen im Straßenverkehr sowie Leisten Erster Hilfe",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erkennen und Beurteilen von im Fahrdienst sich ankündigenden oder auftretenden Pannen oder Schäden am Fahrzeug",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Richtiges Verhalten im Umgang mit Behörden und Kunden/innen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis relevanter einschlägiger Normen, gesetzlicher Bestimmungen und anerkannter Regeln der Technik",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitwirken bei betrieblichen Kalkulationen (zB einfache Maschineneinsatzkalkulationen)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Qualitätssicherung und Qualitätskontrolle",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung des unternehmensspezifischen Qualitätsmanagements einschließlich Dokumentation",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 Berufsausbildungsgesetz – BAG)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Beruf relevanten Maßnahmen und Vorschriften zum Schutz der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufsrelevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften und Normen sowie der einschlägigen Vorschriften zum Schutz des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Erstversorgung bei betriebsspezifischen Arbeitsunfällen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 4
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

      "tables": [
        {
          "cells": [
            [
              {
                "text": "- für Gold:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "gravimetrisch, durch Kupellation und Trennung mit Salpetersäure;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "- für Silber:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "titrimetrisch, durch Auflösung in Salpetersäure und Titrierung mit Natriumchloridlösung (nach Gay-Lussac) oder Titrierung mit Ammonium- oder Kaliumthiocyanatlösung unter Verwendung von Eisen(III)ammoniumsulfat als Indikator (nach Volhard);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "- für Platin:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "gravimetrisch, durch Auflösen in Königswasser, Fällung mit Ammoniumchlorid und Hitzereduktion zu metallischem Platin. Mitgefälltes oder mitgerissenes Iridium wird als Platin gezählt.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "- für Gold und Silber:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "bis 1 Tausendstel,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "- für Platin:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "bis 2 Tausendstel.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]

      "notes": [],
      "links": [],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "„Einsatzstaat“",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "derjenige Vertragsstaat, dessen zuständige Behörden um Hilfeleistung, insbesondere um Entsendung von Hilfsmannschaften oder -material aus dem anderen, ersuchen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "„Entsendestaat“",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "derjenige Vertragsstaat, dessen zuständige Behörden einem Ersuchen des anderen um Hilfeleistung, insbesondere um Entsendung von Hilfsmannschaften oder -material, stattgeben;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "„Ausrüstungsgegenstände“",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "das Material, die Fahrzeuge, die Güter für den Eigenbedarf (Betriebsgüter) und die persönliche Ausstattung der Hilfsmannschaften;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "„Hilfsgüter“",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die zusätzlichen Ausstattungen und Waren, die zur Abgabe an die betroffene Bevölkerung bestimmt sind.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },

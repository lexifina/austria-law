      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Der Lehrbetrieb",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "1.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "1.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen von Gesprächen mit Vorgesetzten, Kollegen, Kunden und Lieferanten unter Beachtung der fachgerechten Ausdrucksweise",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "1.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsorganisation, Arbeitsplanung und Arbeitsgestaltung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "1.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Geräte, Maschinen, Vorrichtungen, Einrichtungen und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "1.8",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Maßnahmen der Qualitätssicherung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitwirken bei der Qualitätssicherung",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "1.9",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 BAG)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "1.10",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "1.11",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutz der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Wiederverwendung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "1.12",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Bau- und Sicherheitsvorschriften (zB Baukoordinationsgesetz) und Normen sowie der einschlägigen Vorschriften zum Schutz des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "1.13",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse über die Erstversorgung bei betriebsspezifischen Arbeitsunfällen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "1.14",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der arbeitsrechtlichen Gesetze, insbesondere des KJBG (samt KJBG-VO), des ASchG und des GlBG",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachübergreifende Ausbildung (Schlüsselqualifikationen) In der Art der Vermittlung der fachlichen Kenntnisse und Fertigkeiten ist auf die Förderung folgender fachübergreifender Kompetenzen des Lehrlings Bedacht zu nehmen:",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "2.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Methodenkompetenz, zB Lösungsstrategien entwickeln, Informationen selbstständig beschaffen, auswählen und strukturieren, Entscheidungen treffen etc.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "2.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Soziale Kompetenz, zB in Teams arbeiten, Mitarbeiter/innen führen etc.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "2.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Personale Kompetenz, zB Selbstvertrauen und Selbstbewusstsein, Bereitschaft zur Weiterbildung, Bedürfnisse und Interessen artikulieren etc.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "2.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kommunikative Kompetenz, zB mit Kunden/innen, Vorgesetzten, Kollegen/innen und anderen Personengruppen zielgruppengerecht kommunizieren; Englisch auf branchen- und betriebsüblichem Niveau zum Bestreiten von Alltags- und Fachgesprächen beherrschen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "2.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeitsgrundsätze, zB Sorgfalt, Zuverlässigkeit, Verantwortungsbewusstsein, Pünktlichkeit etc.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "2.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundenorientierung: Im Zentrum aller Tätigkeiten im Betrieb hat die Orientierung an den Bedürfnissen der Kunden/innen unter Berücksichtigung der Sicherheit zu stehen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kaufmännisch-administrative Grundlagen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "3.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse über die branchen- und betriebsspezifischen Beschaffungsmöglichkeiten und über die Ermittlung des Bedarfs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden von Textverarbeitungs- und Tabellenkalkulationsprogrammen zur Erstellung von technischen Unterlagen wie zB Stücklisten und Dokumentationen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "3.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden von Informationstechnologien wie von technischer Branchensoftware, Netzwerken, Intranet, Internet und Datenbanken",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "3.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des betrieblichen Daten- und Dokumentenmanagements",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden des betrieblichen Daten- und Dokumenten-managements",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "3.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Grundlagen des Datenschutzgesetzes sowie über dessen Anwendung im eigenen Arbeitsbereich",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden von Datenschutzmaßnahmen im eigenen Arbeitsbereich",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "3.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse über die betriebsspezifischen Steuern und Abgaben",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Baugrundlagen und Baustellenorganisation",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werkstoffe und Hilfsstoffe, ihrer Eigenschaften und Verwendungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsabläufe, Zusammenhänge und Zuständigkeiten bei der Herstellung eines Bauwerkes",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Zusammenarbeit und Abstimmung der einzelnen Handwerke sowie der Schnittstellen zu diesen auf der Baustelle",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Darstellenden Geometrie anhand technisch orientierter Beispiele",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Papiergrößen, Schriftfelder, Linienarten, Linienbreiten, Liniengruppen, Kennzeichen, Symbole und Normschrift",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Bemaßung von Bauzeichnungen mit Maßlinien, Maßhilfslinien, Maßzahlen, Schalungs- und Bewehrungszeichnungen sowie Beschriftung von Bauzeichnungen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen von Skizzen und Eintragen von Maßen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen von einfachen Bauzeichnungen und Lageplänen unter Beachtung der einschlägigen Normen und Rechtsvorschriften auch unter Einsatz rechnergestützter Systeme",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.8",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen und Interpretieren von Bauzeichnungen, Lageplänen, Ausführungszeichnungen, Schalungs- und Bewehrungszeichnungen sowie von Detailzeichnungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.9",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Baukonstruktion",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse über die Wirkung von inneren und äußeren Kräften in Bauwerken",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.10",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über die am Bau verwendeten Werk- und Hilfsstoffe, ihrer Eigenschaften und Verwendungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.11",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden der persönlichen Schutzausrüstungen PSA auf Baustellen sowie Anwenden aller anderen erforderlichen Sicherheitsmaßnahmen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.12",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Baustellenorganisation (Arbeitsplanung, Personal usw.)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitwirken beim Erstellen und Abstimmen der Baustellenorganisation (Arbeitsplanung, Personal usw.)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Baubetrieb",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "5.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Normung, bautechnischen Vorschriften und des Grundbuchs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der für die Abrechnung von Bauvorhaben geltenden Vorschriften wie ÖNORMEN, Bauvertragsnormen oder Empfehlungen wie den Leitfaden zur Kostenabschätzung von Planungsleistungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "5.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Ausschreibung und Vergabe von Bauvorhaben samt deren Fachbegriffe wie zB Leistungsbeschreibung, Leistungsverzeichnis, Leistungsposition, Ausführungsposition, Grundposition, Alternativposition, Zulageposition, Eventualposition usw.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "5.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einfaches Vermessen; Aufnehmen der Naturmaße von Bauteilen und Bauobjekten und deren Umgebung auch mittels Bauaufnahmetechnik; Auswerten der Aufnahmen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "5.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen grundlegender facheinschlägiger Berechnungen wie Maßumwandlungen, Prozentrechnungen, Massen und Volumen, Flächen, Winkelfunktionen, Festigkeit unter Anwendung von Formeln und Tabellen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ermitteln von Mengen, Massen und Eigenlasten der Baustoffe und Bauteile sowie Erstellen von Stücklisten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "5.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der für Ausschreibungen und Abrechnungen notwendigen Dokumente wie Leistungsverzeichnis (Beschreiben von Leistungen, Gliedern von Kosten), Tabellen, Skizzen und Zeichnungen und den dazu gültigen Normen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Mitwirkung beim Erstellen der notwendigen Dokumente wie Leistungsverzeichnis (Beschreiben von Leistungen, Gliedern von Kosten), Tabellen, Skizzen und Zeichnungen unter Beachtung der gültigen Normen für Ausschreibungen und Abrechnungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erstellen der notwendigen Dokumente wie Leistungsverzeichnis (Beschreiben von Leistungen, Gliedern von Kosten), Tabellen, Skizzen und Zeichnungen unter Beachtung der gültigen Normen für Ausschreibungen und Abrechnungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Abrechnungen von Bauvorhaben",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Mitwirkung bei der Abrechnung von Bauvorhaben auch mittels Abrechnungssoftware",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Abrechnen von Bauvorhaben auch mittels Abrechnungssoftware",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.8",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitwirken beim Kontrollieren und Zuordnen von Lieferscheinen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kontrollieren und Zuordnen von Lieferscheinen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.9",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Abrechnungssoftware (und deren Einsatzmöglichkeiten wie Mengenermittlung/Massen-ermittlung, Leistungsbeschreibung, Ausschreibungs- Leistungsverzeichnis, Preisspiegel, Auftrags-LV, Abrechnungs-LV, Bauabrechnung, Baukostenermittlung, Kostenüberwachung, Baukosten-controlling)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Abrechnungssoftware (und deren Einsatzmöglichkeiten wie Mengenermittlung/Massenermittlung, Leistungsbeschreibung, Ausschreibungs-LV, Preisspiegel, Auftrags-LV, Abrechnungs-LV, Bauabrechnung, Baukostenermittlung, Kostenüberwachung, Baukostencontrolling)",
                "rowspan": 1,
                "colspan": 2
              }
            ]
          ],
          "merged_cells": true
        }
      ]

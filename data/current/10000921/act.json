      "sha256": "137ab4f2f53d34de59fe0187fab9a5705e46e8371d29160e58ed7bb82194d813",
      "notes": [],
      "links": [],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Schwefeldioxid in Verbindung mit Staub",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "0,2 mg SO2/m3 (0,075 ppm)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "als Tagesmittelwert",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "0,2 mg SO2/m3 (0,075 ppm)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "als Halbstundenmittelwert; drei Halbstundenmittelwerte pro Tag bis zu einer Konzentration von 0,5 mg SO2/m3 (0,185 ppm) gelten nicht als Überschreitung des Halbstundenmittelwertes",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "0,2 mg Staub/m3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "als Tagesmittelwert; dieser Wert bezieht sich auf Staub mit einem Stoke'schen Äquivalentdurchmesser kleiner als 10μm.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kohlenmonoxid",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "10 mg CO/m3 (9 ppm)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "als gleitender Achtstundenmittelwert",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "40 mg CO/m3 (34 ppm)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "als Einstundenmittelwert.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Stickstoffdioxid 0,2 mg NO2/m3 (0,105 ppm)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "als Halbstundenmittelwert.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Eine Überschreitung des Immissionswertes liegt dann vor, wenn auch nur einer der unter Punkt 1 bis 3 genannten Werte – unter Berücksichtigung der in Punkt 1.2 für den SO2-Halbstundenmittelwert festgelegten Ausnahme – überschritten wird.",
                "rowspan": 1,
                "colspan": 2
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    }

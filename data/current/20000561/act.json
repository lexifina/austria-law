      "tables": [
        {
          "cells": [
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Der Mensch im Spannungsfeld verschiedener Zeitströmungen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Religion als Urphänomen und ihre Bedeutung für Individuum und Gesellschaft.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Religion und Glaube als Wertorientierung und Hilfe zu sinnerfülltem Leben.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Menschliches Schaffen und personale Würde.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gottes- und Menschenbild in Bibel und Tradition.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Jesus, der Christus.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kirche als Ort religiöser Erfahrung und Sozialisation.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Spiritualität menschlicher Existenz.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verantwortung des Christen:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "im persönlichen Bereich,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "in Familie, Beruf und Gesellschaft,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "als Mitgestalter der Schöpfung,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "im Umgang mit Wirtschaft, Technik und Kultur.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zeitgemäße Formen der Glaubensvermittlung.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    }
  ]

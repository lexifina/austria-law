                "colspan": 1
              },
              {
                "text": "Kenntnis in Mechanik, Pneumatik, Elektrik",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse in der Optik",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Optik",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Typografie und Schriften",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden von Schriften",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Farbenlehre",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "Anwenden von Farbraummodellen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Druckfarben und Toner",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über reprografische Materialien einschließlich der anzuwendenden Chemikalien",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "Handhaben und Weiterverarbeiten von reprografischen Materialien einschließlich der Anzuwendenden Chemikalien",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen und Anwenden technischer Unterlagen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der elektronischen Datenverarbeitung im Hinblick auf reprografische Techniken",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der elektronischen Datenverarbeitung im Hinblick auf reprografische Techniken",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der berufsspezifischen Hardware und Software",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden von berufsspezifischer Hardware und Software",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Dateneingabe, Datenverarbeitung und Datenausgabe durchführen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Planen der Datenorganisation und Datenarchivierung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Datenkompression und Datenkonvertierung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Daten übernehmen, transferieren, konvertieren, sichern und archivieren",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Trägermaterialien einschließlich der Formate Grammaturen bei Papieren (Normen)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Richtiges Verwenden von Trägermaterialien",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachgerechte Behandlung der Trägermaterialien (wie Klimatisierung, Luftfeuchtigkeit, Lagerung)",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beurteilen und Vorbereiten von reprografischen Vorlagen und Dateitypen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verwenden und Bearbeiten von reprografischen Vorlagen und Dateitypen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über das Digitalisieren von reprografischen Vorlagen und Dateitypen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Digitalisieren von reprografischen Vorlagen und Dateitypen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über die Reprografie: Desktop Publishing (DTP) Publishing, Bildbearbeitungs- und CAD-Programme, Fremddatenübernahme (mit und ohne Bearbeitung) Datenspeicherung, Datenarchivierung, Scannen, Plotten, Vekrorisieren",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden und Durchführen von Desktop Publishing (DTP), Bildbearbeitungs- und CAD-Programmen, Fremddatenübernahme (mit und ohne Bearbeitung), Datenspeicherung, Datenarchivierung, Scannen, Plotten, Vektorisieren",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über verschiedene reprografische Techniken: Drucktechniken (Digitaldruck, Offset), Plandruck, Mikroverfilmung, Fotografie, Vervielfältigungsverfahren, Kopierverfahren (Xerografie), Plankopie (Lichtpause), Mikrografie",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden verschiedener reprografischer Techniken: wie Drucktechniken (Digitaldruck, Offset), Plandruck, Mikroverfilmung, Fotografie, Vervielfältigungsverfahren, Kopierverfahren (Xerografie), Plankopie(Lichtpause), Mikrografie",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über die in der Reprografie verwendeten Maschinen: wie Planvervielfältiger, Kopierer, Hochleistungskopierer schwarz/weiß und Farbe, Großflächenkopierer, Plotter, Kleinoffset-Druckmaschinen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einsetzen der in der Reprografie verwendeten Maschinen (Planvervielfältiger, Kopierer, Hochleistungskopierer in schwarz/weiß und Farbe, Großflächenkopierer, Plotter, Kleinoffset-Druckmaschinen)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Weiterverarbeitung der Vervielfältigungsprodukte: wie Sortierer, Bindegerät, Falzmaschine, Schneidmaschine",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Weiterverarbeitung der Vervielfältigungsprodukte: wie Sortierer, Bindegerät, Falzmaschine, Schneidmaschine",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Weiterverarbeiten der Vervielfältigungsprodukte",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Auftragsabwicklung (Planen, Organisieren, Durchführen) und Kundenbetreuung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Auftragsabwicklung (Planen, Organisieren, Durchführen) und Kundenbetreuung",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der bei der Anwendung der Fertigkeiten erforderlichen Maßnahmen zum Qualitätsmanagement",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Mitarbeit beim Qualitätsmanagement",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung englischer Fachausdrücke",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse über Urheberrecht und Wettbewerbsrecht",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse über die ergonomische Gestaltung des Arbeitsplatzes; Kenntnis über die funktionelle Gestaltung des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Beruf relevanten Maßnahmen und Vorschriften zum Schutz der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufsrelevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften und Schutzmaßnahmen sowie der sonstigen in Betracht kommenden Vorschriften und Maßnahmen zum Schutze des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 des Berufsausbildungsgesetzes)",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 5
              }
            ]
          ],
          "merged_cells": true
        }
      ]

      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "17ca00f6fb2633629092c0fa8f479a771f17f5dcbf6335004449efab5833bbe9",
      "sha256": "d1047c6dcbbc53a4d6d6c716759e19613b708835b4e89795166188ec6858b5db",
      "notes": [],

      "tables": [
        {
          "cells": [
            [
              {
                "text": "Inhaltliche Schwerpunkte – Lernziele",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Auswählbare biblische Schriftstellen ua.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Arbeit als Beitrag zu meiner Entfaltung und zu einer Mitwelt sehen – Schöpferisch mit Gott Neues wagen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Wert der verschiedenen Berufe achten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Berufe in der Bibel: Altes und Neues Testament zB Gen 4,2. 17.20 ff",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Der eine Leib und die vielen Glieder",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1 Kor 12,12–31a",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Arbeitstugenden entwickeln (Verlässlichkeit, Freude am Gelungenen)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Durchhalten, Umgang mit Frust",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Jonageschichte Jona 2,1–11",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Zu Entscheidungen stehen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Das Gleichnis von den ungleichen Söhnen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mt 21,28–32",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Das Selbstwertgefühl der Schülerinnen und Schüler stärken/festigen – Von Gott her ICH – Stärke gewinnen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Sich seiner Einmaligkeit bewusst werden",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "„Noch ehe ich dich im Mutterleib formte ...“ Jer 1,5 „Ich habe dich eingezeichnet in meine Hände ...“ Jes 49,16 „Ich habe dich beim Namen gerufen ...“ Jes 43,1",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Stärken (her)zeigen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Das Gleichnis vom anvertrauten Geld.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mt 25,14–30",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Schwächen akzeptieren",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Der Gang Jesu auf dem Wasser. Mt 14,22–33",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die Verleugnung durch Petrus. Mk 14,66–72",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– in (kleinen) Bereichen Verantwortung für sich selbst übernehmen",
                "rowspan": 2,
                "colspan": 1
              },
              {
                "text": "Die Berufung Jeremias zum Propheten. Jer 1,6–9",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "„Bittet, dann wird euch gegeben ...“ Mt 7,7–8",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die Heilung einer kranken Frau. Mk 5,24 ff",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Eigenständige Wege entdecken – Gott will, dass mein Leben glückt",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Visionen entwickeln",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vom Leben in Fülle. Joh 10,10",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Das Gleichnis vom königlichen Hochzeitsmahl. Mt 22,1–14",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Lebensziele benennen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die Heilung eines Blinden. Mk 10,46–52",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Schritte überlegen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Jesus im Haus des Zöllners Zachäus. Lk 19,1–10 7,24–27",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vom Haus auf dem Felsen. Mt 7,24–27",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Selbstverantwortete Entscheidungen wagen – wie Jesus entschieden seinen Weg gehen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Freiräume und Abhängigkeiten erkennen und unterscheiden können",
                "rowspan": 2,
                "colspan": 1
              },
              {
                "text": "Die Versuchung Jesu. Mt 4,1–11",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Das Beispiel von der falschen Selbstsicherheit des reichen Mannes. Lk 12,16–21",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Entscheidungen treffen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die Spaltung unter den Jüngern. Joh 6,60–71",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Der zwölfjährige Jesus im Tempel. Lk 2,41–52",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Von den zwei Wegen. Mt 7,13–14",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Grenzen setzen und anerkennen lernen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Von den wahren Verwandten Jesu. Lk 8,19–21",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Heilung des Besessenen. Lk 8,28–39",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die Tempelreinigung. Mt 21,12–17",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Konsequenzen bedenken",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Das Gleichnis von den zehn Jungfrauen. Mt 25,1–13",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die Berufung der ersten Jünger. Lk 5,1–11",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Das Gleichnis vom Schatz und von der Perle. Mt 13,44–46",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Lösungsmöglichkeiten für Konflikte finden",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die Versammlung der Apostel und der Ältesten mit der Gemeinde. Apg 15,6–21",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Abraham und Lot. Gen 13,5 ff",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Orientierungshilfen erkennen und annehmen – Gottes Weisung beachten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Lebensregeln, Goldene Regel",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die zehn Gebote. Ex 20,1–17, Dtn 5,6–22",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Das Liebesgebot. Mt 5,43 ff",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Lebensbilder/Vorbilder – kritische Auseinandersetzung",
                "rowspan": 2,
                "colspan": 1
              },
              {
                "text": "Lebensbilder; Christophorus, Helen Keller;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Aktuelle Vorbilder aus dem Sozial- und Sportbereich.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Jugendkultur/Drogen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die Paradieserzählung. Gen 3,1 ff",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die Versuchung Jesu. Mt 4,1–11",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Merkmale guter Freundschaften kennen lernen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Jonatans Freundschaft mit David. 1 Sam 18,1 ff",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Nach dem Sinn des Lebens fragen – Gottes Liebe als Lebens- und Sinnquelle entdecken",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Lebenssituationen (Geburt, Leben, Gesundheit, Krankheit, Sakramente, Trauerarbeit, Freude, Leid, Schicksal, Tod)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "„Alles hat seine Zeit ...“ Koh 3,1 ff",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Menschen in verschiedenen Lebensphasen begegnen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "David- Zyklus. 1 Sam 16–2, Kö 2",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Grundbedürfnisse zur Sprache bringen – Sinnvolles im eigenen Leben entdecken",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Erwachsen werden – sich den Herausforderungen des Lebens stellen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "David und Goliath. 1 Sam 17",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die Berufung der ersten Jünger. Lk 5,1 ff",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Werke der Barmherzigkeit. Mt 25,31 ff",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Positive Beziehungen aufbauen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Das Gleichnis vom unbarmherzigen Gläubiger. Mt 18,23–35",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "„Das Größte aber ist die Liebe ...“ 1 Kor 13,1 ff",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Von der Verantwortung für den Bruder. Mt 18,15–20",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Sexualität schätzen lernen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Das Hohelied (Auswahl).",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Möglichkeiten des aktiven Mitwirkens in der Gesellschaft ergreifen – den Einsatz der Kirche für Menschen kennen lernen und dabei mitwirken",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Auftreten lernen und sich seiner persönlichen Wirkung auf andere klar werden",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– In Vereinen, Gemeinschaften mitwirken",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Das Leben der jungen Gemeinde. Apg 2,43–47",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Kirchliche Beratungsstellen kennen lernen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Der hl. Severin – Begründer eines sozialen Netzes.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Beziehungen zur eigenen Pfarre entwickeln",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "– Freizeit gestalten – Feste feiern",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kirchenjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    }
  ]
}

                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "DSK",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "15-stellig, alphanumerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Datensatzkennung, Identifizierungsnummer (keine Sozialversicherungsnummer)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "SJ",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "7-stellig, alphanumerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "laufendes Schuljahr (Bsp.: 2012/13 – mit Schrägstrich getrennt)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "MO",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2-stellig, numerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Berichtsmonat",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "SKZ",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "6-stellig, numerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Schulkennzahl der Stammschule (gemäß der von der Bundesministerin für Unterricht, Kunst und Kultur zur Verfügung gestellten österreichischen Schulendatei)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "BL",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1-stellig numerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bundesland: 1 – Burgenland 2 – Kärnten 3 – Niederösterreich 4 – Oberösterreich 5 – Salzburg 6 – Steiermark 7 – Tirol 8 – Vorarlberg",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "SART",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1-stellig numerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Schulart: 6 – land- und forstwirtschaftliche Berufsschule 7 – land- und forstwirtschaftliche Fachschule 8 – Sonderformen 0 – wenn keine Möglichkeit für eine Zuordnung vorhanden ist",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "GEB_Jahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "4-stellig, Datum",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Geburtsjahr (JJJJ), vierstellig, z. B. 1970",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "SEX",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1-stellig, alphanumerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Geschlecht: M – männlich, W – weiblich",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "ART1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1-stellig, alphanumerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Art des Dienstverhältnisses: 1 – öffentlich – rechtliches 2 – vertraglich – unbefristet 3 – vertraglich – befristet",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "ART2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1-stellig, alphanumerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zuordnung zu einem Dienstgeber K – kirchlich bestellter Religionslehrer (öffentlicher Dienstgeber) O – Land P – privat gemäß § 5 Abs. 2 Land- und forstwirtschaftliches Privatschulgesetz R – kirchlich bestellter Religionslehrer mit privatem Dienstgeber Z – Zuweisung gemäß § 5 Abs. 1 Land- und forstwirtschafltiches Privatschulgesetz",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "ART 3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2-stellig, alphanumerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Art des Dienstverhältnisses: PE – im Monat der Erhebung pensioniert AU – im Monat der Erhebung neu aufgenommen AK – im Monat der Erhebung aktiv AG – im Monat der Erhebung ausgeschieden NV – Nachverrechnung, vor dem Monat der Erhebung bereits ausgeschieden oder pensioniert DZ – Dienstzuteilung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "STAT",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2-stellig, alphanumerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Status mit Stichtag: KU – Karenziert FH – Familienhospizfreistellung gemäß § 66d Abs. 1 Z 3 LLDG 1985 MU – Mutterschutz AK – Aktive SO – Sonderurlaub (keine Einzelfälle) DF – Dienstfreistellung gemäß § 15 Abs. 3 LLDG 1985 AD – Außerdienststellung gemäß § 66b LLDG 1985 SU – Suspendiert NV – Nachverrechnung, vor dem Monat der Erhebung bereits ausgeschieden oder pensioniert LS – betrauter und aktiver Landesschulinspektor FS – betrauter und aktiver Fachinspektor/Schulinspektor",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "SABD",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2-stellig, numerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "00 – kein Sabbatical 02 – Sabbatical 2 Schuljahre 03 – Sabbatical 3 Schuljahre 04 – Sabbatical 4 Schuljahre 05 – Sabbatical 5 Schuljahre 06 – Sabbatical 6 Schuljahre 07 – Sabbatical 7 Schuljahre 08 – Sabbatical 8 Schuljahre 09 – Sabbatical 9 Schuljahre 10 – Sabbatical 10 Schuljahre",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "SABZ",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1-stellig, numerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Sabbatical Freistellung im laufenden Schuljahr: 1 = ja, 0 = nein",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "SCHEMA 1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "7-stellig, alphanumerisch (max. Anzahl)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Besoldungsrechtliche Einstufung an der Stammschule (z. B. L1, L2a2, L2a1, L2b1, L3, l1, l2a2, l2a1, l2b1, l3, IILl1, … oder Sondervertragslehrer ILSV, IILSV)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "SCHEMA 2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "6-stellig, numerisch (NK)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Sondervertrag in welchem Ausmaß in % einer Vollbeschäftigung (kaufmännisch gerundet)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "STUFE 1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2-stellig, numerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Besoldungs- bzw. Gehaltsstufe",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "TEILB_1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2-stellig, numerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Merkmal des Beschäftigungsausmaßes: 01 – volles Beschäftigungsausmaß 02 – Teilbeschäftigung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "TEILB_2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2-stellig, numerisch",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Weiteres Merkmal des Beschäftigungsausmaßes: 01 – Herabsetzung gemäß § 45 LLDG 1985 02 – Dienstfreistellung gemäß § 15 LLDG 1985 03 – Dienstfreistellung gemäß § 66a LLDG 1985 04 – Dienstfreistellung gemäß § 66c LLDG 1985 05 – Familienhospizfreistellung gemäß § 66d Abs. 1 Z 2 LLDG 1985 06 – Dienstfreistellung Personalvertreter gem. § 25 Bundes-Personalvertretungsgesetz 07 – Dienstfreistellung gemäß § 29g iVm. § 47d VBG 08 – Lehrpflichtermäßigung gemäß § 44 Abs. 1 Z 1 LLDG 1985 09 – Lehrpflichtermäßigung gemäß § 44 Abs. 1 Z 2 LLDG 1985 10 – Lehrpflichtermäßigung gemäß § 44 Abs. 1 Z 3 LLDG 1985 11 – Lehrpflichtermäßigung gemäß § 46 LLDG 1985 12 – Altersteilzeit gemäß § 27 AIVG 13 – Verminderung der Unterrichtsverpflichtung gemäß § 54 LLDG 1985 14 – Verminderung der Unterrichtsverpflichtung gemäß § 56 LLDG 1985 15 – Teilzeit nach dem Mutterschutzgesetz 1979 (§ 15 MSchG) 16 – Teilbeschäftigung gemäß § 121 Abs. 1 LLDG 1985 17 – Vertragslehrer mit Teilbeschäftigung gemäß § 20 Abs. 3 VBG",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "BAUSM",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "6-stellig, numerisch (NK)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beschäftigungsausmaß ohne Mehrdienstleistungen in % einer Vollbeschäftigung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "BAUSM_WE",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "6-stellig, numerisch (NK)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beschäftigungsausmaß (in Werteinheiten)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "MDL",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "6-stellig, numerisch (NK)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gesamtstundenzahl der besoldungsrelevanten Mehrdienstleistungen (einschließlich Einzelsupplierungen) im Berichtszeitraum",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "SUP",
                "rowspan": 1,
                "colspan": 1
              },

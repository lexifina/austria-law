                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "EINSEITIGE ERKLÄRUNG DER REGIERUNG LIECHTENSTEINS ZUM ADDENDUM ZU PROTOKOLL 38A",

      "file": "art-001.md",
      "source_context": null,
      "identity_review_required": false,
      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "aefcbbf04012ad6282fe05a2fde36e8206a03ee089d8199930bcaf5c1a1402a8",
      "sha256": "dada837daea2193d71b406201486a159e8c8badae378174fb530d741526d0720",
      "notes": [],
      "links": [],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "Grenzgewässer:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die Gewässer des Inn, des Schalklbachs, des Zandersbachs und des Malfragbachs jeweils im Bereich der gemeinsamen Staatsgrenze",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Anlagen:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die zum Ausbau und zur Nutzung der Wasserkraft notwendigen Bauten samt allen Nebeneinrichtungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Berechtigung:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "das Recht, die Wasserkraft zu nutzen, und weitere auf dem Wasserrecht beruhende Bewilligungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Berechtigter:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "der Inhaber der Berechtigung",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },

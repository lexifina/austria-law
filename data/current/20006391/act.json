            ],
            [
              {
                "text": "1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Stoffe mit östrogener (ausgenommen 17-ß-Östradiol und seine esterartigen Derivate) androgener oder gestagener Wirkung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Nutztiere, ausgenommen Nutztiere gemäß § 1 Z 2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Brunstsynchronisation; Vorbereitung von Spender- oder Empfängertieren für Embryotransfer",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verabreichung an eindeutig identifizierte und untersuchte Nutztiere",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Stoffe mit androgener Wirkung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Brütlinge und Setzlinge in der Aquakultur (nicht während der Mast)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zur sexuellen Inversion während der ersten drei Lebensmonate",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwendung nur durch Tierärztin/Tierarzt oder unter deren/dessen Aufsicht",
                "rowspan": 1,
                "colspan": 1
              }
            ],

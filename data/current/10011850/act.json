      "tables": [
        {
          "cells": [
            [
              {
                "text": "Vn",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die Wasserverdrängung in m3 bis zur Eintauchtiefe Tn ,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "L",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die Länge des Schiffsrumpfes in der Schwimmebene in m,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "B",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die Breite des Schiffsrumpfes in der Schwimmebene an der breitesten Stelle in m,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Tn",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die Eintauchtiefe des Fahrzeuges bei 0,5 L bis zur bezogenen Schwimmebene,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "der Völligkeitsgrad der Verdrängung.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]

    {
      "designation": "§ 1",
      "source_heading": "Gebühren für Aufsichtstätigkeiten",
      "source_record_id": null,
      "source_locator": {
        "kind": "documentContent_index",
        "index": 1,
        "stable_identity": false
      },
      "file": "par-0001.md",
      "source_context": null,
      "identity_review_required": false,
      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "ac03081933730ee4d094b7a9934a1a6786e16dc7f4f0ef77d951eabb9b594ef4",
      "sha256": "5b3ff604b35de19df8e343bef0d70ad5c1aac79e2dd44b14d9c6c46ee70cb8b8",
      "notes": [],
      "links": [],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Analyse der Konformitätsbewertungsberichte gemäß Art. 17 Abs. 4 lit. b iVm Art. 20 Abs. 1 und Art. 21 Abs. 1 Verordnung (EU) Nr. 910/2014 über elektronische Identifizierung und Vertrauensdienste für elektronische Transaktionen im Binnenmarkt und zur Aufhebung der Richtlinie 1999/93/EG (im Folgenden: eIDAS-VO), ABl. Nr. L 257 vom 28.08.2014 S. 73, in der Fassung der Berichtigung ABl. Nr. L 257 vom 29.01.2015 S. 19 im Sinne § 3 Abs. 1 Z 1 SVG",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2 500 Euro;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführung von Überprüfungen der qualifizierten VDA gemäß Art. 17 Abs. 4 lit. e iVm Art. 20 Abs. 2 erster Fall eIDAS-VO",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "a) bei Überprüfungen aufgrund sicherheitsrelevanter Anlässe",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "4 500 Euro;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "b) bei Überprüfungen ohne sicherheitsrelevante Anlässe",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1 000 Euro;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verleihung des Qualifikationsstatus an VDA und die von ihnen erbrachten Dienste sowie Entzug dieses Status gemäß Art. 17 Abs. 4 lit. g iVm Art. 20 und 21 eIDAS-VO",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "700 Euro;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erteilung von Auflagen gemäß Art. 17 Abs. 4 lit. j eIDAS-VO",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "700 Euro;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Überprüfung des Vorliegens und der ordnungsgemäßen Anwendung von Vorschriften über Beendigungspläne (§ 9 SVG) gemäß Art. 17 Abs. 4 lit. i iVm Art. 24 Abs. 2 lit. h eIDAS-VO",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1 500 Euro;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Weiterführung der Zertifikatsdatenbank durch die Aufsichtsstelle (§ 9 SVG): pro Jahr und Zertifikat, das in der Zertifikatsdatenbank geführt wird",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1 Euro;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "jedoch insgesamt pro Jahr nicht mehr als",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "5 000 Euro;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führung der Vertrauensliste bei der Aufsichtsstelle (§ 14 Abs. 1 SVG):",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "pro aufgenommenen VDA und Jahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "300 Euro.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },

                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Oberst",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Brigadier",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Generalmajor",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Generalleutnant",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "sowie je nach Verwendung bei den Dienstgraden Oberleutnant bis Oberst die Zusätze „…arzt“, „…apotheker“, „…veterinär“, „…experte“,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "„des Generalstabsdienstes“,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "„des Intendanzdienstes“,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "„des höheren militärfachlichen Dienstes“,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "„des höheren militärtechnischen Dienstes“ sowie",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "für Militärseelsorger die dienstrechtlich vorgesehenen Verwendungsbezeichnungen",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false

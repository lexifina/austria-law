      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachübergreifende Ausbildung (Schlüsselqualifikationen) In der Art der Vermittlung der fachlichen Kenntnisse und Fertigkeiten ist auf die Förderung folgender fachübergreifender Kompetenzen des Lehrlings Bedacht zu nehmen:",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Methodenkompetenz: zB Lösungsstrategien entwickeln, Informationen selbstständig beschaffen, auswählen und strukturieren, Entscheidungen treffen etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Soziale Kompetenz: zB in Teams arbeiten, Mitarbeiter/innen führen etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Personale Kompetenz: zB Selbstvertrauen und Selbstbewusstsein, Bereitschaft zur Weiterbildung, Bedürfnisse und Interessen artikulieren etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kommunikative Kompetenz: zB mit Kunden/innen, Vorgesetzten, Kollegen/innen und anderen Personengruppen zielgruppengerecht kommunizieren; Englisch auf branchen- und betriebsüblichem Niveau zum Bestreiten von Alltags- und Fachgesprächen beherrschen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeitsgrundsätze: zB Sorgfalt, Zuverlässigkeit, Verantwortungsbewusstsein, Pünktlichkeit etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundenorientierung: im Zentrum aller Tätigkeiten im Betrieb hat die Orientierung an den Bedürfnissen der Kunden/innen unter Berücksichtigung der Sicherheit zu stehen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsplanung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus, der Funktion und der Anwendung von Zimmererwerkzeug, Handmaschinen, stationären Holzbearbeitungsmaschinen und CNC-gesteuerten Maschinen (wie zB Abbundmaschinen)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben, Warten, Pflegen und Instandhalten der zu verwendenden Werkzeuge, Maschinen, Geräte, Vorrichtungen, Einrichtungen und Arbeitsbehelfe unter fachgerechter Verwendung der Schutzausrüstung",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Werkstoffes Holz und anderer Bau- und Bauhilfsstoffe, ihrer Eigenschaften, Bearbeitungsmöglichkeiten, Verarbeitungsmöglichkeiten und Verwendungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über die Lagerung Pflege und Auswahl des Werkstoffes Holz und anderer Bau- und Bauhilfsstoffe sowie über die schädlichen Einflüsse auf die Werkstoffe und deren Abwehr",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitwirken beim Lagern, Pflegen und Auswählen des Werkstoffes Holz und anderer Bau- und Bauhilfsstoffe",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lagern, Pflegen und Auswählen des Werkstoffes Holz und anderer Bau- und Bauhilfsstoffe",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Verladung und des Transports von Holzbauteilen und Holzkonstruktionen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitarbeiten beim Verladen und Transportieren von Holzbauteilen und Holzkonstruktionen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Einrichten und Absichern von Baustellen und Arbeitsplätzen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Einrichten und Absichern von Baustellen und Arbeitsplätzen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Erstellens (Aufstellen, Instand halten, Bedienen, Abtragen) von Arbeits-, Schutz- und Traggerüsten",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Erstellen von Arbeits-, Schutz- und Traggerüsten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von Skizzen und Zeichnungen samt Stücklisten sowie Anwenden von Materiallisten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen von Skizzen und einfachen Zeichnungen auch unter Verwendung rechnergestützter Systeme",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Anfertigen von Zeichnungen auch unter Verwendung rechnergestützter Systeme",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Messen mit einfachen Messgeräten",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Messen mit Spezialgeräten (zB Laser und Nivelliergeräte)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Prüfen (Ebenheit, Höhenlage, Maßhaltigkeit, Feuchtigkeit) und Vorbereiten von Untergründen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der diversen Dachformen sowie des Aufbaus von Dachkonstruktionen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsweisen und Arbeitsschritte (Anreißen, Bearbeiten, Zusammenpassen und Kennzeichnen) des traditionellen, zeichnerischen, rechnerischen und computergestützten (inklusive Abbundsoftware) Abbindens zur Herstellung verschiedenster Holzkonstruktionen (zB Dachkonstruktionen, Wände, Decken, Treppen, Türen, Tore, Türme, Brücken)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Anrisszeichen (zB Bundzeichen, Abschnitt, Mauer- oder Kantenriss, Mittel- bzw. Achsriss oder Fehlriss) und der Abbundzeichen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Manuelles und maschinelles Bearbeiten von Holz durch Sägen, Stemmen, Schlitzen, Hobeln, Raspeln, Schleifen, Bohren, Graten, Fasen, Behauen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von Holzverbindungen durch Dübeln, Nageln, Schrauben, Blatt, Versatz und Zapfen sowie Kleben",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim traditionellen und zeichnerischen Abbinden zur Herstellung von Holzkonstruktionen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Traditionelles und zeichnerisches Abbinden zur Herstellung von Holzkonstruktionen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitarbeiten beim rechnerischen und computer-gestützten Abbinden zur Herstellung von Holzkonstruktionen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechnerisches und computer-gestütztes Abbinden zur Herstellung von Holzkonstruktionen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Holztrocknung und Holzfeuchtemessung",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bearbeiten von Holzoberflächen mit handgeführten Maschinen sowie konstruktives und chemisches Schützen von Holzkonstruktionen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Anwendung von Befestigungs- und Montagehilfsmittel wie Dübel, Verankerungen, Abstandhalter, Stahlblechverbindungsmittel usw.",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Einbauen von Holzkonstruktionen wie zB Dachkonstruktionen, Wände und Decken",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Einbauen von Holzkonstruktionen wie zB Dachkonstruktionen, Wände und Decken mittels verschiedener Befestigungs- und Montagemethoden",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Berechnen und Ausführen von Dachlattungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Einbaus von vorgefertigten Bauteilen wie zB Türen und Fenster, Treppen, Wand- und Deckenverkleidungen und Holzfußböden mittels verschiedener Befestigungs- und Montagemethoden",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Einbauen von vorgefertigten Bauteilen wie zB Türen und Fenster, Treppen, Wand- und Deckenverkleidungen und Holzfußböden mittels verschiedener Befestigungs- und Montagemethoden",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Ausbildens von Fugen und Ecken bei Holzkonstruktionen (Schlagregen, Winddichtigkeit) sowie des Herstellens von Anschlüssen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Ausbilden von Fugen und Ecken bei Holzkonstruktionen sowie beim Herstellen von Anschlüssen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Ausbilden von Fugen und Ecken bei Holzkonstruktionen sowie beim Herstellen von Anschlüssen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Durchführen von Erhaltungs- und Instandsetzungsarbeiten an Holzkonstruktionen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Trockenbaus wie Herstellen von Unterkonstruktionen, Verarbeiten von Gipskarton- und Gipsfaserplatten, Verspachteln, Herstellen der Anschluss- und Bewegungsfugen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Ausführen des Trockenbaus wie Herstellen von Unterkonstruktionen, Verarbeiten von Gipskarton- und Gipsfaserplatten, Verspachteln, Herstellen der Anschluss- und Bewegungsfugen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Bauökologie und der Bauphysik inklusive Statik",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis des Wärme-, Kälte-, Feuchte-, Brand- und Schallschutzes inklusive An- und Abschlüssen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Einbauen von Dämmstoffen zum Wärme-, Kälte-, Feuchte-, Brand- und Schallschutz sowie von Abdichtungsmaterialien",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis des Einbaus bzw. der Montage von Energieanlagen wie zB Photovoltaik- und Solaranlagen und der von solchen Anlagen ausgehenden Gefahren",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einbauen bzw. Montieren von Energieanlagen (ohne Anschlussarbeiten) wie zB Photovoltaik und Solaranlagen unter Beachtung der von solchen Anlagen ausgehenden Gefahren",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Herstellung von Schalungen (zB für Fundamente, Stützen, Wände)",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Herstellen von Schalungen, Lattungen und Eindeckungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von Schalungen, Lattungen und Eindeckungen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kontrollieren und Prüfen der ausgeführten Arbeiten sowie Erkennen und Beheben von Mängeln",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der berufspezifischen Normen und Rechtsvorschriften (zB technische Bauvorschriften, Bauordnungen)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "46.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Qualitätssicherung einschließlich der Reklamationsbearbeitung und Durchführung von betriebsspezifischen, qualitätssichernden Maßnahmen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "47.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "48.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften, insbesondere über den Brandschutz, sowie der sonstigen in Betracht kommenden Vorschriften zum Schutze des Lebens und der Gesundheit, insbesondere Erste-Hilfe-Maßnahmen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "49.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "50.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 BAG)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "51.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 4
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

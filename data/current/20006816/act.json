      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "719fb7a3b74271eb5405beb49e4e03f93b1597f2d1c27b03f2221457e0585c8e",
      "sha256": "5e4f8484d75d1d930e68bc52cda96414a7c83d43533d4131e051dc8f33b63872",
      "notes": [],

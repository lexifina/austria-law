      "source_fingerprint": "5f18ce12bb2eaa2a01342f7b96245dfd0d50e1f28e614b6cfe4255977d20c682",
      "sha256": "97d4a0a5870874c5d9d8174b040fd9c759bbbdf9f94142df6eb526d1c18b2062",
      "notes": [],
      "links": [],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erstmaliger Besuch einer Nachschulung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Wiederholter Besuch einer Nachschulung desselben Kurstyps innerhalb von fünf Jahren",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Nachschulung gemäß §§ 2 oder 4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "mindestens vier Gruppensitzungen zu insgesamt 15 Kurseinheiten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mindestens fünf Gruppensitzungen zu insgesamt 18 Kurseinheiten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Nachschulung gemäß § 3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "mindestens vier Gruppensitzungen zu insgesamt zwölf Kurseinheiten sowie eine Fahrprobe, die hinsichtlich des Aufwandes einer Gruppensitzung von insgesamt drei Kurseinheiten entspricht",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "mindestens fünf Gruppensitzungen zu insgesamt 15 Kurseinheiten sowie eine Fahrprobe, die hinsichtlich des Aufwandes einer Gruppensitzung von insgesamt drei Kurseinheiten entspricht",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Nachschulung gemäß § 4a",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "mindestens zwei Gruppensitzungen zu insgesamt sechs Kurseinheiten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "mindestens zwei Gruppensitzungen zu insgesamt sechs Kurseinheiten sowie ein Einzelgespräch im Ausmaß von einer Kurseinheit",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]

                "colspan": 1
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Aufbringen und Schleifen von Füll-, Grund- und Deckmaterial",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zubereiten und Mischen gebrauchsfertiger Materialien",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",

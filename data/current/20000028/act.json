                "colspan": 1
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Qualitätsmanagements",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Kenntnis des betrieblichen Qualitätsmanagements, Durchführen von Qualitätskontrollen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundenorientiertes Verhalten und Kundenberatung",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung englischer Fachausdrücke",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sonstigen einschlägigen Sicherheitsvorschriften sowie der sonstigen in Betracht kommenden Vorschriften zum Schutz des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Beruf relevanten Maßnahmen und Vorschriften zum Schutz der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufsrelevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 des Berufsausbildungsgesetzes)",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 7
              }
            ]

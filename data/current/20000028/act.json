              },
              {
                "text": "4. Lehrjahr",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Einrichtungen, Werkzeuge, Maschinen, Anlagen, Vorrichtungen, Einrichtungen und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werkstoffe und Hilfsstoffe, ihrer Eigenschaften, Verarbeitungsmöglichkeiten und Bearbeitungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundlegende Fertigkeiten in der Werkstoffbearbeitung: Messen, Anreißen, Schneiden, Sägen, Schleifen, Bohren, Senken, Gewindeschneiden, Nieten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fertigkeiten in der Werkstoffbearbeitung:Messen, Anreißen, Schneiden, Sägen, Schleifen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Fertigkeiten in der Werkstoff- bearbeitung: Messen, Anreißen, Schneiden, Schleifen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Fertigkeiten in der Werkstoff-bearbeitung: Messen, Anreißen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Autogenes Brennschneiden",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kaltbearbeitungsverfahren: Richten, Stauchen, Schweifen, Treiben, Schlichten, Bördeln, Abkanten, Absetzen, Spannen, Sicken, Runden, Aufziehen, Einziehen",
                "rowspan": 1,
                "colspan": 6
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von lösbaren und unlösbaren Verbindungen: Schraubverbindungen, Kleben, Löten, Gasschmelzschweißen ohne Zwangslage, Widerstandsschweißen, Schutzgasschweißen",
                "rowspan": 1,
                "colspan": 6
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verwenden von Meßgeräten und Prüfgeräten",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Anschlagen und Einpassen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Reparatur von Kunststoffteilen",
                "rowspan": 1,
                "colspan": 6
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausbau und Einbau von Fahrzeugteilen und Kraftfahrzeugteilen, Ausrüstung und Zubehör",

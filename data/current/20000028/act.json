            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Polieren und Ausfertigen",
                "rowspan": 1,
                "colspan": 6
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der natürlichen und künstlichen Trocknung",

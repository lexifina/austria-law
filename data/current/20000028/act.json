                "colspan": 5
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen von Lackierungen nach Schablone und Pausen; Zeichnen und Malen einfacher Schmuckformen, Beschriftungen, Linieren",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Anfertigen von Lackierungen nach Schablone und Pausen;Zeichnen und Malen einfacher Schmuckformen, Beschriftungen, Linieren, auch in Luftpinseltechnik",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse kraftfahrzeugtechnischer Vorschriften",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "-",

                "rowspan": 1,
                "colspan": 6
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Feststellen von Schäden an der Karosserie",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von einfachen Werkzeichnungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von Werkzeichnungen",
                "rowspan": 1,
                "colspan": 6
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen von Skizzen",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über einfache Störungen an der elektrischen Anlage und deren Beseitigung",
                "rowspan": 1,
                "colspan": 6
              }
            ],
            [
              {
                "text": "16.",

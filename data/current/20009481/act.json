            [
              {
                "text": "Z 5",
                "rowspan": 3,
                "colspan": 1
              },
              {
                "text": "Katastralgemeinde und Grundstücksnummer(n), auf die sich die Adresse bezieht",
                "rowspan": 3,
                "colspan": 1
              },
              {
                "text": "Katastralgemeindename",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "BEV",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Katastralgemeindenummer (KGNR)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "BEV",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Grundstücksnummer (GNR)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "BEV",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Z 6",
                "rowspan": 3,
                "colspan": 1
              },
              {
                "text": "Repräsentative Koordinate im System der Landesvermessung als räumliche Referenz der Adresse",
                "rowspan": 3,
                "colspan": 1
              },
              {
                "text": "Der Referenzpunkt soll in einem unmittelbaren Naheverhältnis zur adressgebenden Straße oder Ortschaft stehen. Wenn es auf dieser Adresse Gebäude gibt, soll der Referenzpunkt innerhalb eines Gebäudes (Gebäudekomplexes) zu liegen kommen.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gemeinde",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Art der Bestimmung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gemeinde",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Angabe, ob die Adresse inner- oder außerhalb eines in der Digitalen Katastralmappe (DKM) dargestellten Gebäudes liegt",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gemeinde",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Z 7",
                "rowspan": 6,
                "colspan": 1
              },
              {
                "text": "Postleitzahl, Zustellort und etwaige sonstige Bezeichnungen zum leichteren Auffinden der Adresse, wie Vulgo- und Hofnamen",
                "rowspan": 6,
                "colspan": 1
              },
              {
                "text": "Postleitzahl (PLZ)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "BEV",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Zustellort – grundsätzlich Gemeindename; wenn es in einer Gemeinde mehrere gleichlautende Straßennamen gibt, dann kann der Zustellort der Ortschaftsname sein oder er setzt sich aus Gemeinde- und Ortschaftsnamen zusammen (von der Gemeinde auswählbar)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gemeinde-BEV",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Vulgoname, Hofname oder andere ortsübliche Bezeichnung von landwirtschaftlichen Gehöften",
                "rowspan": 2,
                "colspan": 1
              },
              {
                "text": "Gemeinde",
                "rowspan": 2,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Zählsprengelname (ZSP)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "STAT",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Zählsprengelnummer (ZSPNR)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "STAT",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Z 8",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Eignung für Wohnzwecke",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Adresse für Wohnzwecke geeignet: ja/nein",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gemeinde",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Z 9",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Von der Gemeinde allenfalls gemachte sonstige Angaben",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bisher in der Gemeinde verwendeter Adressschlüssel und weitere erläuternde Angaben",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gemeinde",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Z 10",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vom Adressregister vergebener Adresscode",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Österreichweit eindeutiger, nicht systematisch aufgebauter Schlüssel für jede Adresse (ADRCD)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "BEV",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": true
        }

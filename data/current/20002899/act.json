              },
              {
                "text": "Tätigkeiten;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Inhaber oder verantwortlicher Leiter;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.8",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Forschungstätigkeit;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.9",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Standort(e) der Forschungsstätte(n) des Unternehmens, gegliedert nach Bundesländern.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beschäftigte:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gesamtzahl der Beschäftigten im Jahresdurchschnitt nach Geschlecht;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gesamtzahl der Beschäftigten in F&E im Jahresdurchschnitt nach Geschlecht;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.2.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zahl der Beschäftigten in F&E gegliedert nach Beschäftigtenkategorien (Wissenschaftlerinnen und Wissenschaftler sowie Ingenieurinnen und Ingenieure, höherqualifiziertes nichtwissenschaftliches Personal, sonstiges nichtwissenschaftliches Personal), jeweils nach der höchsten abgeschlossenen Ausbildung und getrennt nach dem Geschlecht;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.2.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beschäftigte in Vollzeitäquivalenten für F&E (Gesamtstunden im Berichtsjahr) gegliedert nach Beschäftigtenkategorien (Wissenschaftlerinnen und Wissenschaftler sowie Ingenieurinnen und Ingenieure, höherqualifiziertes nichtwissenschaftliches Personal, sonstiges nichtwissenschaftliches Personal), jeweils nach der höchsten abgeschlossenen Ausbildung und getrennt nach dem Geschlecht;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Prozentuelle Verteilung des F&E-Personals auf die Forschungsstätten.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gesamtumsatz",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Interne F&E-Ausgaben (Intramurale F&E-Ausgaben):",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Personalausgaben;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "laufende Sachausgaben;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "nvestitionsausgaben für Anlagen und Ausstattung;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Investitionsausgaben für Gebäude und Grundstücke;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Interne F&E-Ausgaben gegliedert nach Forschungsarten (Grundlagenforschung, angewandte Forschung, experimentelle Entwicklung) und sozio-ökonomischen Zielsetzungen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausgaben für F&E-Aufträge, die an inländische oder ausländische Einrichtungen außerhalb der Erhebungseinheit vergeben wurden (Extramurale F&E-Ausgaben):",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "an andere Unternehmen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "an universitäre Einrichtungen/Hochschulinstitute/Fachhochschulen oder Fachhochschul-Studiengänge oder einzelne Angehörige von solchen Einrichtungen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "an staatliche Einrichtungen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "an private Institutionen ohne Erwerbscharakter;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "an kooperative F&E-Einrichtungen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "an internationale Organisationen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herkunft der finanziellen Mittel für F&E:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "eigene Mittel;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mittel von anderen inländischen Unternehmen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mittel aus dem öffentlichen Sektor;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mittel von der Europäischen Union;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mittel aus dem privaten gemeinnützigen Sektor;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mittel von internationalen Organisationen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "sonstige Mittel aus dem Ausland.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },
    {
      "designation": "Anl. 2",
      "source_heading": "Anlage II Merkmale über die Erhebungseinheiten gemäß § 4 Z 2 bis 7",
      "source_record_id": null,
      "source_locator": {
        "kind": "documentContent_index",
        "index": 17,
        "stable_identity": false
      },
      "file": "anl-2.md",
      "source_context": null,
      "identity_review_required": false,
      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "f83fb0833ee02444f1264ec2438c37925202ce00231b940ae40511785fb3506b",
      "sha256": "bf3cd871ef9b328e694eba297339e504e68925f91d192bad86c33d7a18d76b0d",
      "notes": [],
      "links": [],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Identifikationsmerkmale:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Name (Bezeichnung);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Standort (Anschrift);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Umsatzsteuernummer (wenn umsatzsteuerpflichtig);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Dienstgeberkontonummer inklusive Versicherungsträger (wenn sozialversicherungsrechtlich Dienstgeberfunktion ausgeübt wird);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Firmenbuchnummer (wenn im Firmenbuch eingetragen);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechtsform;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Leiter der Erhebungseinheit (Vor- und Zuname, akademischer Grad, Titel, Funktionsbezeichnung);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.8",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "hauptsächliche Arbeitsgebiete nach Wissenschaftszweigen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.9",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Forschungstätigkeit;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.10",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Standort(e) der Forschungsstätte(n) der Erhebungseinheit gegliedert nach Bundesländern.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Forschungsschwerpunkte oder Forschungsprojekte (gegliedert nach):",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "sozio-ökonomischen Zielsetzungen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Forschungsarten (Grundlagenforschung, angewandte Forschung, experimentelle Entwicklung);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gewicht der einzelnen Schwerpunkte oder Projekte im Rahmen der gesamten Forschungstätigkeit der Erhebungseinheit in Prozent.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beschäftigte, Personalausgaben:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gesamtzahl der Beschäftigten im Jahresdurchschnitt nach dem Geschlecht;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beschäftigte der Erhebungseinheit, die direkt in F&E tätig sind oder die direkte Dienstleistungen für F&E erbringen:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.2.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gesamtzahl des wissenschaftlichen Personals (Akademiker und gleichwertige Kräfte);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.2.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gesamtzahl des höherqualifizierten nichtwissenschaftlichen Personals (Maturanten und gleichwertige Kräfte, Techniker, höherqualifizierte Laboranten);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.2.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gesamtzahl des sonstigen nichtwissenschaftlichen Personals (Hilfspersonal);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bruttojahresgehalts- bzw. -lohnsumme für das gesamte Personal der Erhebungseinheit;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "gesetzliche Sozialbeiträge des Dienst- oder Arbeitgebers für das gesamte Personal der Erhebungseinheit;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "sonstiger Personalaufwand, insbesondere freiwillige Sozialleistungen, für das gesamte Personal der Erhebungseinheit;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Daten der einzelnen Beschäftigten gemäß 3.2.1 bis 3.2.3:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Sozialversicherungsnummer;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Geburtsjahr;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Geschlecht;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "akademischer Grad und Studienrichtung, Ausbildung, Fachrichtung;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beschäftigungsdauer und -ausmaß;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "durchschnittliche Gesamtarbeitszeit in Wochenstunden, aufgeteilt nach Tätigkeitskategorien (Verwaltung, Forschung und Entwicklung, sonstige Tätigkeiten);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bruttojahresgehalts- bzw. -lohnsumme;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.8",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bei Erhebungseinheiten gemäß § 4 Z 3 (Institute, Kliniken, usw.) zusätzlich:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.8.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Funktion, dienstrechtliche Stellung;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.8.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zu wem das Dienst- bzw. Angestelltenverhältnis besteht (Bund, Land, sonstiges);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.8.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Refundierung von Personalausgaben;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.8.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gliederung der Gesamtarbeitszeit (3.6.6) zusätzlich nach der Tätigkeitskategorie „Lehre und Ausbildung“.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Laufende Sachausgaben:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gesamte laufende Sachausgaben der statistischen Einheit, gegliedert nach Tätigkeitskategorien [Verwaltung, Forschung und Entwicklung, sonstige Tätigkeiten; bei Erhebungseinheiten gemäß § 4 Z 3 (Institute, Kliniken usw.) zusätzlich gegliedert nach der Tätigkeitskategorie „Lehre und Ausbildung“];",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "bei Instituten, Kliniken und sonstigen Einrichtungen von Universitäten zusätzlich:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.2.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die gesamten über die Quästur (Haushaltsführung) verrechneten laufenden Sachausgaben, gegliedert nach Tätigkeitskategorien (Verwaltung, Lehre und Ausbildung, Forschung und Entwicklung, sonstige Tätigkeiten) sowie",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.2.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die gesamten nicht über die Quästur (Haushaltsführung) verrechneten laufenden Sachausgaben für F&E (einschließlich der im Rahmen der Teilrechtsfähigkeit getätigten).",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Investitionsausgaben:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gesamte Investitionsausgaben, gegliedert nach Tätigkeitskategorien (Verwaltung, Forschung und Entwicklung, sonstige Tätigkeiten; bei Privatuniversitäten, Fachhochschulen und Fachhochschul-Studiengängen zusätzlich gegliedert nach der Tätigkeitskategorie „Lehre und Ausbildung“) und nach Investitionsarten (Ausrüstungsinvestitionen, Bauinvestitionen, Erwerb von Liegenschaften);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "bei Instituten, Kliniken und sonstigen Einrichtungen von Universitäten zusätzlich:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.2.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "gesamte über die Quästur (Haushaltsführung) verrechnete Investitionsausgaben, gegliedert nach Tätigkeitskategorien (Verwaltung, Lehre und Ausbildung, Forschung und Entwicklung, sonstige Tätigkeiten) und nach Investitionsarten (Ausrüstungsinvestitionen, Bauinvestitionen, Erwerb von Liegenschaften);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.2.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "gesamte nicht über die Quästur (Haushaltsführung) verrechnete Investitionsausgaben für F&E (einschließlich der im Rahmen der Teilrechtsfähigkeit getätigten) gegliedert nach Investitionsarten (Ausrüstungsinvestitionen, Bauinvestitionen, Erwerb von Liegenschaften).",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herkunft der finanziellen Mittel:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Im Berichtsjahr insgesamt und für F&E (aus F&E-Aufträgen, aus Forschungsförderungsmitteln, sonstigen Mitteln) zur Verfügung gestandene Mittel, bei teilrechtsfähigen Einrichtungen einschließlich der Einnahmen im Rahmen der Teilrechtsfähigkeit, gegliedert nach finanzierenden Bereichen:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.1.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "eigene Mittel;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.1.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Unternehmenssektor;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.1.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "öffentlicher Sektor (§ 2 Z 7);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.1.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Europäische Union;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.1.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "privater gemeinnütziger Sektor;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.1.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "internationale Organisationen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.1.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausland.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.2",
                "rowspan": 1,
                "colspan": 1
              },
              {

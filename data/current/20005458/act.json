      "source_fingerprint": "3fc29fe5aa8fc0e10c2518137206a77d83a1f42cf0cfc7a15219928ca3dcd789",
      "sha256": "149a2ea7906c6237ce2f03b62adfa680fd00f010ffe30bf344830d71fab8ba62",
      "notes": [],
      "links": [],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "Ausbildungs- und Prüfungsfach",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Richtstunden-anzahl",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lehrinhalte – Schwerpunkte",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Österreichisches Verfassungsrecht und Behördenorganisation sowie Recht der Europäischen Union",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "30",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundprinzipien der Verfassung, Stufenbau der Rechtsordnung, Kompetenzverteilung zwischen Bund und Ländern, Weg der Bundesgesetzgebung, Organisation der Verwaltung und Gerichtsbarkeit, Selbstverwaltung, Rechtsschutz und Kontrolle, Grund- und Freiheitsrechte, Rechtsgrundlagen und Strukturen der Europäischen Union insbesondere im Bereich der Europäischen Sicherheits- und Verteidigungspolitik",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Dienst- und Besoldungsrecht der Bundesbediensteten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "27",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Darstellung der Rahmenbedingungen des Öffentlichen Dienstes und Unterschiede zur Privatwirtschaft, Unterschiede der Dienstverhältnisse innerhalb des Öffentlichen Dienstes unter gezielter Berücksichtigung der Besonderheiten im Ressort, Rechte und Pflichten im Dienstverhältnis, Besoldungsrecht im Öffentlichen Dienst, Darstellung weiterer relevanter Rechtsbereiche insbesondere des Bundesgleichbehandlungsrechtes, des Bundesbediensteten-schutzes, der ressortbezogenen Aspekte der Lehrlings-ausbildung sowie der Aspekte des Pensions- und Sozialversicherungsrechtes, Personalvertretungsrecht",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Verwaltungsverfahrens-recht I",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "25",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführungsgesetz zu den Verwaltungsverfahrensgesetzen, Allgemeines Verwaltungsverfahrensgesetz, Verwaltungs-strafgesetz, Zustellgesetz",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Wehrrecht I",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "36",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Wehrverfassung, Wehrgesetz, Heeresdisziplinargesetz, Heeres-gebührengesetz, Auslandseinsatzrecht, Militärbefugnisgesetz, Grundzüge des Sperrgebietsgesetzes, des Munitionslager-gesetzes und des Militärauszeichnungsgesetzes",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Grundlagen des Haushaltsrechtes des Bundes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "20",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundlagen der Staatsverrechnung und der wichtigsten Haushaltsvorschriften des Bundes, Grundzüge der bundessportrechtlichen Förderungsverwaltung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Zusätzliches Ausbildungsfach",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Richtstunden-anzahl",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lehrinhalte – Schwerpunkte",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Grundsätze der Führung und der Kommunikation sowie Organisationslehre",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "24",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Wahrnehmung, Körpersprache und Kommunikation, Teamentwicklung und Führungsstile, Grundlagen der Argumentation, Grundsätze der Organisationsformen, „New Public Management“, „Gender Mainstreaming“",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },

      "notes": [
        {
          "kind": "Langtitel",
          "text": "EUROPÄISCHES üBEREINKOMMEN üBER DEN SOZIALEN SCHUTZ DER LANDWIRTE StF: BGBl. Nr. 224/1983 (NR: GP XV RV 1081 AB 1237 S. 126. BR: AB 2574 S. 428.)"
        },
        {
          "kind": "Vertragsparteien",
          "text": "*Belgien 224/1983 *Italien 224/1983 *Liechtenstein 224/1983 *Luxemburg 224/1983 *Niederlande 224/1983 *Schweiz 224/1983 *Vereinigtes Königreich 224/1983"

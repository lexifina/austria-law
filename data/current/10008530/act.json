      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "Belgien:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "vom Anwendungsbereich dieses übereinkommens eine oder mehrere der folgenden Personengruppen auszuschließen:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Personen, welche als selbständig Erwerbstätige ihre Tätigkeit ausschließlich oder vorwiegend einem Beruf der Landwirtschaft, der Forstwirtschaft, des Gartenbaus, des Weinbaus oder einem ähnlichen Berufe widmen, die jedoch aus dieser Tätigkeit nicht den wesentlichen Teil ihres Einkommens beziehen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Personen, welche ihre Tätigkeit ausschließlich der Forstwirtschaft widmen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– die Bestimmungen des Art. 5 Abs. 3 nicht anzuwenden.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Liechtenstein:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die Bestimmungen des Art. 5 Abs. 1 lit. b, c und d sowie des Art. 5 Abs. 3 nicht anzuwenden.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Luxemburg:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die Bestimmungen des Art. 5 Abs. 3 nicht anzuwenden.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Niederlande:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "vom Anwendungsbereich dieses übereinkommens die folgenden Personengruppen auszuschließen:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Personen, welche als selbständig Erwerbstätige ihre Tätigkeit ausschließlich oder vorwiegend einem Beruf der Landwirtschaft, der Forstwirtschaft, des Gartenbaus, des Weinbaus oder einem ähnlichen Berufe widmen, die jedoch aus dieser Tätigkeit nicht den wesentlichen Teil ihres Einkommens beziehen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Personen, welche ihre Tätigkeit ausschließlich der Forstwirtschaft widmen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– die Bestimmungen des Art. 5 Abs. 3 nicht anzuwenden.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Schweiz:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die Bestimmungen des Art. 5 Abs. 1 lit. b, c und d sowie des Art. 5 Abs. 3 nicht anzuwenden.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Vereinigtes Königreich:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "vom Anwendungsbereich dieses übereinkommens eine oder mehrere der folgenden Personengruppen auszuschließen:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Personen, welche als selbständig Erwerbstätige ihre Tätigkeit ausschließlich oder vorwiegend einem Beruf der Landwirtschaft, der Forstwirtschaft, des Gartenbaus, des Weinbaus oder einem ähnlichen Berufe widmen, die jedoch aus dieser Tätigkeit nicht den wesentlichen Teil ihres Einkommens beziehen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Personen, welche ihre Tätigkeit ausschließlich der Forstwirtschaft widmen;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– die Bestimmungen des Art. 5 Abs. 1 lit. c und d nicht anzuwenden.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Italien:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "den Nutzen des Europäischen übereinkommens über den sozialen Schutz der Landwirte unter der Bedingung der Gegenseitigkeit auf alle in Italien wohnhaften Staatsangehörige der anderen Vertragsparteien auszudehnen.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]

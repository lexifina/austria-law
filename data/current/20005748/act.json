            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit bei der Auswahl, Annahme, Prüfung auf Verwendbarkeit und Lagerung der betriebs-spezifischen Roh-, Zusatz- und Hilfsstoffe",
                "rowspan": 1,
                "colspan": 6
              },
              {
                "text": "Auswahl, Annahme, Prüfung auf Verwendbarkeit und Lagerung der betriebsspezifischen Roh-, Zusatz- und Hilfsstoffe",

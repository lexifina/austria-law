            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Anlagen zur Erzeugung von Energieträgern (wie zB Druckluft, Dampf, Kälte) sowie Mitarbeit beim Umgang mit betriebsspezifischen Energieträgern",
                "rowspan": 1,
                "colspan": 7
              },
              {
                "text": "Kenntnis der Anlagen zur Erzeugung von Energieträgern (wie zB Druckluft, Dampf, Kälte) sowie Umgang mit betriebsspezifischen Energieträgern",
                "rowspan": 1,
                "colspan": 8
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Produktions-anlagen zur Lebensmittel-verarbeitung und -herstellung",
                "rowspan": 1,
                "colspan": 1
              },
              {

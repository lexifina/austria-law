                "text": "-",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 9
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 12
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der ergonomischen Gestaltung des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Arbeits-organisation, Arbeitsplanung und Arbeitsgestaltung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Arbeitsorganisation, Arbeitsplanung und Arbeitsgestaltung",
                "rowspan": 1,
                "colspan": 10
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der allgemeinen, anorganischen und organischen Chemie sowie der Mikrobiologie",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "Kenntnis der berufsspezifischen allgemeinen und organischen Chemie sowie der Mikrobiologie",
                "rowspan": 1,
                "colspan": 10
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse der Lebensmittelchemie, Ernährungslehre und der Verfahrenstechnik in der Lebensmittelverarbeitung und -herstellung",
                "rowspan": 1,
                "colspan": 10
              },
              {
                "text": "Kenntnis der berufsspezifischen Lebensmittelchemie und der Verfahrenstechnik in der Lebensmittelverarbeitung und -herstellung",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der berufsspezifischen Physik wie Mechanik, Kalorik und Elektrotechnik",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 7
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grund-kenntnisse der Mess-, Steuer- und Regelungs-technik",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 7
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der berufsspezifischen Mathematik wie zB Mischungsrechnungen, Rezepturberechnungen und Ausbeuteberechnungen",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 7
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der berufsspezifischen chemischen und physikalischen Mess- und Prüfverfahren sowie von mikrobiologischen Arbeitsweisen",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "Durchführen betriebsspezifischer chemischer, physikalischer und mikrobiologischer Mess- und Prüfverfahren",
                "rowspan": 1,
                "colspan": 10
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Mitarbeit bei betriebs-spezifischen Kontroll- und Analysemethoden",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "Durchführen von betriebsspezifischen Kontroll- und Analysemethoden",
                "rowspan": 1,
                "colspan": 9
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Protokollierung und grafische Auswertung von Arbeitsergebnissen sowie deren Dokumentation auch unter Anwendung der betriebsspezifischen EDV und Methoden der Statistik",
                "rowspan": 1,
                "colspan": 14
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der branchenspezifischen Rechtsvorschriften und Normen",
                "rowspan": 1,
                "colspan": 11
              },
              {
                "text": "Kenntnis der branchenspezifischen Rechtsvorschriften insbesondere Lebensmittelkennzeichnungsverordnung und Normen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Vorschriften zur Personal- und Betriebshygiene (Hygiene-verordnung) und der Wichtigkeit von Hygiene-maßnahmen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden der betriebsspezifischen Maßnahmen zur Personal- und Betriebshygiene (Hygieneverordnung) unter Beachtung der vorgeschriebenen Anwendungsrichtlinien und Schutzmaßnahmen im Umgang mit Reinigungs- und Desinfektionsmitteln",
                "rowspan": 1,
                "colspan": 14
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus und der Funktion von automatischen Reinigungsanlagen",
                "rowspan": 1,
                "colspan": 11
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Verfahren zur Lebensmittelverarbeitung und –herstellung",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Rohstoffes Wasser (zB Inhaltsstoffe, Wasserhärte und ihre Bedeutung für die Lebensmittelverarbeitung und -herstellung), Aufbereitungsverfahren, Anforderungen an Wasserqualitäten, Analysemethoden",
                "rowspan": 1,
                "colspan": 10
              },
              {
                "text": "Kenntnis der Wasseraufbereitungsverfahren (Wasserenthärtung und Wasserentkeimung) und Bedienen der betriebsspezifischen Wasseraufbereitungsanlagen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der branchenspezifischen Roh-, Zusatz- und Hilfsstoffe ihrer Gewinnung, Eigenschaften und Verwendungsmöglichkeiten",

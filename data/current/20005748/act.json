                "colspan": 8
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Förderung und Lagerung von Feststoffen, Flüssigkeiten und Gasen sowie Umgang mit den betriebsspezifischen Förder- und Lagereinrichtungen",
                "rowspan": 1,
                "colspan": 7

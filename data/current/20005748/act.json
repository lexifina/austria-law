              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 9
              },
              {
                "text": "Kenntnis von Methoden zur kontinuierlichen Qualitätsverbesserung",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von technischen Zeichnungen wie zB Verfahrensschaubildern, Verrohrungsplänen und Schaltplänen",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werkstoffe (wie Metalle und Kunststoffe) und Hilfsstoffe, ihrer Eigenschaften, Verwendungsmöglichkeiten und Bearbeitungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Geräte, Maschinen und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundfertigkeiten in der Bearbeitung von Werkstoffen wie Metallen und Kunststoffen",
                "rowspan": 1,
                "colspan": 8
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der frühzeitigen Erkennungs-möglichkeiten von Störungen an Maschinen, Geräten und Anlagen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Kenntnis der frühzeitigen Erkennungsmöglichkeiten von Störungen an Maschinen, Geräten und Anlagen",
                "rowspan": 1,
                "colspan": 10
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der vorbeugenden Wartung (Wartungspläne) und Instandhaltung sowie Mitarbeit bei der Wartung, Pflege und Instandhaltung der betriebsspezifischen Maschinen, Geräte und Anlagen",
                "rowspan": 1,
                "colspan": 8
              },
              {
                "text": "Wartung, Pflege und einfache Instandhaltung der betriebsspezifischen Maschinen, Geräte und Anlagen",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "Mitarbeit bei der Störungsaufzeichnung und bei der Erstellung von Wartungsplänen",
                "rowspan": 1,
                "colspan": 7
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 8
              },
              {
                "text": "Kenntnis der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen von Gesprächen mit Vorgesetzten, Kollegen, Kunden und Lieferanten unter Beachtung der fachgerechten Ausdrucksweise",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen englischen Fachausdrücke",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der betrieblichen EDV",
                "rowspan": 1,
                "colspan": 8
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "46.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufsrelevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "47.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des betrieblichen Brand- und Explosionsschutzes sowie der vorbeugenden Brand- und Explosionsschutzmaßnahmen",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "48.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften und Normen sowie der einschlägigen Vorschriften zum Schutz des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "49.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Erstversorgung bei betriebsspezifischen Arbeitsunfällen",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "50.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 Berufsausbildungsgesetz)",
                "rowspan": 1,
                "colspan": 15
              }
            ],
            [
              {
                "text": "51.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 15
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

      "file": "art-002.md",
      "source_context": null,
      "identity_review_required": false,
      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "6f185f572f6dcb94d7d6da49f0bb29470c51b90db290cbfbe73e98fd9ac7e89f",
      "sha256": "5c069439967b9f13564f13affd94dbd818d3d7bb9ff5e9f3a772d497fd95479a",
      "notes": [],
      "links": [],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "Verzeichnis der Erkrankungen und Giftstoffe:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verzeichnis der entsprechenden Gewerbe und Verfahren:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Vergiftungen durch Blei, dessen Legierungen und Verbindungen, sowie unmittelbare Folgen dieser Vergiftungen.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Behandlung bleihaltiger Erze einschließlich bleihaltiger Rückstände in Zinkwerken.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einschmelzen von altem Zink und Blei zu Barren.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellung von Gegenständen aus geschmolzenem Blei oder bleihaltigen Legierungen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Polygraphische Gewerbe.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellung von Bleiverbindungen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellung und Ausbesserung elektrischer Akkumulatoren.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zubereitung und Verwendung von bleihaltigen Emaillen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Polieren mit Bleispänen oder bleihaltigen Stoffen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anstreicharbeiten, bei denen bleihaltige Streichmittel, Kitte oder Farben zubereitet oder gebraucht werden.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Vergiftungen durch Quecksilber, dessen Legierungen und Verbindungen, sowie unmittelbare Folgen dieser Vergiftungen.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Behandlung von quecksilberhaltigen Mineralien.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellung von Quecksilberverbindungen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellung von Meß- und Laboratoriumsapparaten.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zubereitung der Rohstoffe für die Hutmacherei.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Feuervergoldung.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verwendung von Quecksilberpumpen für die Herstellung von Glühlampen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellung von Knallquecksilberzündern.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Ansteckung durch Milzbrand.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeiten bei milzbrandverseuchten Tieren.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Behandlung von Tierleichen oder tierischen Abfällen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ein- und Ausladen sowie Beförderung solcher Waren.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },

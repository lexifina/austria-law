      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "4. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des wesentlichen technischen Arbeitsablaufes in einem Luftfahrttechnik-Betrieb",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des arbeitsorganisatorischen Ablaufes in einem Luftfahrttechnik-Betrieb",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachübergreifende Ausbildung (Schlüsselqualifikationen) In der Art der Vermittlung der fachlichen Kenntnisse und Fertigkeiten ist auf die Förderung folgender fachübergreifender Kompetenzen des Lehrlings Bedacht zu nehmen:",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Methodenkompetenz: zB Lösungsstrategien entwickeln, Informationen selbstständig beschaffen, auswählen und strukturieren, Entscheidungen treffen etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Soziale Kompetenz: zB in Teams arbeiten, Mitarbeiter/innen führen etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Personale Kompetenz: zB Selbstvertrauen und Selbstbewusstsein, Bereitschaft zur Weiterbildung, Bedürfnisse und Interessen artikulieren etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kommunikative Kompetenz: zB mit Kunden/innen, Vorgesetzten, Kollegen/innen und anderen Personengruppen zielgruppengerecht kommunizieren; Englisch auf branchen- und betriebsüblichem Niveau zum Bestreiten von Alltags- und Fachgesprächen beherrschen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeitsgrundsätze: zB Sorgfalt, Zuverlässigkeit, Verantwortungsbewusstsein, Pünktlichkeit etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundenorientierung: Im Zentrum aller Tätigkeiten im Betrieb hat die Orientierung an den Bedürfnissen der Kunden/innen unter Berücksichtigung der Sicherheit zu stehen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Grundstrukturen des nationalen und internationalen Luftfahrtrechtes",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis, Sinnverständnis und Anwendung der einschlägigen englischen Fachausdrücke und Fachtexte",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Berufsspezifische Kommunikation in der englischen Sprache",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Elektrotechnik",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Elektronik und Digitaltechnik",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Pneumatik und Hydraulik",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Manuelles Bearbeiten von Werkstoffen wie zB Messen, Anreißen, Feilen, Bohren, Nieten, Richten, Biegen, Kleben",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Maschinelles Bearbeiten (auch an rechnergestützen Maschinen) von Werkstoffen wie zB Drehen und Fräsen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausführen von Arbeiten in der Luftfahrzeuginstandhaltung gemäß Der Verordnung (EU) Nr. 1321/2014, Anhang III an Luftfahrzeugen (Die zu vermittelnden Kenntnisse und Fertigkeiten sind gemäß der von der Austro Control vorgegebenen und auf ihrer Website publizierten Anlage – 02 zu EASA FORM 19B.1 – Liste für den Nachweis der praktischen Tätigkeiten im Lehrberuf Luftfahrzeugtechnik, in der jeweils gültigen Fassung, auszubilden)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnisse der Qualitätssicherung einschließlich der Reklamationsbearbeitung und Durchführung von betriebsspezifischen, qualitätssichernden Maßnahmen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der betrieblichen EDV (Hard- und Software)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 Berufsausbildungsgesetz – BAG)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften sowie der elektrotechnischen Sicherheitsvorschriften (ÖVE) und Normen sowie der einschlägigen Vorschriften zum Schutz des Lebens und der Gesundheit unter besonderer Beachtung der von den Versorgungseinrichtungen ausgehenden Gefahren",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über den Umgang mit gesundheitsschädlichen Stoffen auch unter Verwendung der Sicherheitsdatenblätter",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über die Erstversorgung bei betriebsspezifischen Arbeitsunfällen und den innerbetrieblichen Brandschutz",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 4
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

      "tables": [
        {
          "cells": [
            [
              {
                "text": "Grenzübergangsstelle",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zone",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Bemerkungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1. Nickelsdorf I – Hegyeshalom",
                "rowspan": 2,
                "colspan": 1
              },
              {
                "text": "Die Zone für die österreichischen Bediensteten umfasst:",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Die gesamte Grenzabfertigung kann auf dem Staatsgebiet Ungarns durchgeführt werden.",
                "rowspan": 2,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "den Abschnitt der öffentliche ungarische Straße M1 von der gemeinsamen Staatsgrenze bis zum Straßenkilometer 170 samt den im Zuge dieses Straßenabschnittes befindlichen Abstellflächen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2. Nickelsdorf I – Hegyeshalom (LKW–Terminal Nord und Süd)",
                "rowspan": 2,
                "colspan": 1
              },
              {
                "text": "Die Zone für die ungarischen Bediensteten umfasst:",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Die gesamte Grenzabfertigung kann auf dem Staatsgebiet der Republik Österreich durchgeführt werden",
                "rowspan": 2,
                "colspan": 1
              }

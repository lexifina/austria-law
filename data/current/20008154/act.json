      "tables": [
        {
          "cells": [
            [
              {
                "text": "Hat das Vorhaben Auswirkungen auf",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vertiefende Fragen Hat das Vorhaben Auswirkungen auf",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "I.1 Schutz, Förderung der Gesundheit und Entwicklung von Kindern und jungen Erwachsenen?",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "I.1.1 das Risiko von Kindern oder jungen Erwachsenen, körperlich oder seelisch verletzt zu werden oder auf sonstige Art gesundheitlichen Schaden zu nehmen? I.1.2 die aktive Förderung der Gesundheit von Kindern und jungen Erwachsenen? I.1.3 die Entwicklung und Entfaltung des geistigen, körperlichen und seelischen Wohles von Kindern und jungen Erwachsenen?",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "Hat das Vorhaben Auswirkungen auf",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vertiefende Fragen Hat das Vorhaben Auswirkungen auf",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "II.1 Betreuung von Kindern und Bildung von Kindern und jungen Erwachsenen?",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "II.1.1 die Verfügbarkeit von Betreuungsangeboten für Kinder? II.1.2 die Leistung einer fachgerechten und altersentsprechenden Betreuung von Kindern? II.1.3 den Zugang von Kindern und jungen Erwachsenen zu Bildung und das Erreichen eines Bildungsziels?",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "II.2 Unterhaltsversorgung, Kinderkosten oder den Ausgleich für Kinderkosten?",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "II.2.1 die Deckung des Unterhaltsbedarfs von Kindern und unterhaltsberechtigten jungen Erwachsenen? II.2.2 die Kinderkosten sowie auf den Ausgleich von Kinderkosten?",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },

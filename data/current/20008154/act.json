      "tables": [
        {
          "cells": [
            [
              {
                "text": "Wirkungsdimension Kinder und Jugend",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fragen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "I. Schutz, Förderung und Entwicklung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Wird der Anspruch von Kindern und jungen Erwachsenen auf Schutz, Förderung der Gesundheit, Entwicklung und Entfaltung ihres geistigen, körperlichen und seelischen Wohles tangiert?",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "II. Betreuung, Unterhaltsversorgung und Kinderkosten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ist mit Auswirkungen auf die Betreuung von Kindern, die Unterhaltsversorgung für Kinder und junge Erwachsene mit Anspruch auf Unterhalt; auf Kinderkosten bzw. auf den Ausgleich für Kinderkosten zu rechnen?",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "III. Zukunftssicherung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ist mit Auswirkungen auf die Zukunftssicherung von Kindern und jungen Erwachsenen in mittelfristiger Perspektive zu rechnen?",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },

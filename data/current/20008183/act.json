      "tables": [
        {
          "cells": [
            [
              {
                "text": "Wirkungsdimension Konsumentenschutzpolitik",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fragen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1) Verhältnis der KonsumentInnen zu Unternehmen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Hat die Regelung/das Vorhaben - Auswirkungen auf das Verhältnis zwischen KonsumentInnen und Unternehmen? Wieviele KonsumentInnen werden voraussichtlich direkt und/oder potenziell betroffen sein? - unmittelbare finanzielle Auswirkungen auf KonsumentInnen in ihrem Verhältnis zu Unternehmen? Welches Ausmaß werden diese finanziellen Auswirkungen haben?",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2) Konsumentenschutz-Einrichtungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Hat die Regelung/das Vorhaben rechtliche oder finanzielle Auswirkungen auf Konsumentenschutz-Einrichtungen einschließlich staatlich anerkannter Schuldenberatung?",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3) Gesundheit und Sicherheit in Zusammenhang mit Produkten oder Dienstleistungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Hat die Regelung/das Vorhaben Auswirkungen auf die Gesundheit oder die Sicherheit von KonsumentInnen in Zusammenhang mit Produkten oder Dienstleistungen?",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },

          "cells": [
            [
              {
                "text": "1. die theoretische Fahrprüfung je Antritt zu einem Modul",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "5,50 Euro",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2. die praktische Fahrprüfung für die Klassen A(A1,A2), B, BE, und F je Klasse",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "60 Euro",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3. die praktische Fahrprüfung für die Klassen C(C1), D(D1), CE(C1E) und DE(D1E) gemäß § 11 Abs. 4 Z 3 FSG je Klasse",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "90 Euro",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4. die praktische Fahrprüfung für die Klassen C(C1) und D(D1) gemäß § 11 Abs. 4a FSG",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "180 Euro",

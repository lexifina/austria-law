      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "c264cfdc9450d2a7b5e659404c3804a98bafc6083675661928be1d95e1682a26",
      "sha256": "e29e8f33d800d48eb87639b2a1f34480be3720a8fc192adec2f458e2411bc929",
      "notes": [],

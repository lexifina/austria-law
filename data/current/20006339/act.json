      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsplanung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über die ergonomische Gestaltung des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen von Gesprächen mit Vorgesetzten, Kollegen, Kunden und Lieferanten unter Beachtung der fachgerechten Ausdrucksweise",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Maschinen, Geräte, Vorrichtungen, Einrichtungen und Arbeitsbehelfe unter fachgerechter Verwendung von Schutzausrüstungen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Rohstoffe, Werkstoffe (Steingut, Steinzeug, Porzellan) und Hilfsstoffe, ihrer Eigenschaften, Verwendungsmöglichkeiten und Verarbeitungsmöglichkeiten sowie über deren fachgerechte Lagerung",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von technischen Unterlagen wie von Skizzen, Zeichnungen, Plänen, usw.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit bei der Auswahl und Prüfung auf Verwendbarkeit der betriebsspezifischen Roh- und Hilfsstoffe",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Auswahl und Prüfung auf Verwendbarkeit der betriebsspezifischen Roh- und Hilfsstoffe",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Masseherstellung (Rezepturen, Lagerung) sowie Aufbereiten von Masserohstoffen durch Abwiegen, Mischen, Zerkleinern und Homogenisieren; Einlagern von Massen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der berufsspezifischen Mathematik wie zB Berechnen von Flächen und Volumen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gips aufbereiten und Herstellen von Formen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Oberflächenbehandlung der Arbeitsformen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von Modellen unter Berücksichtigung der Schwindung sowie Herstellen von einfachen und mehrteiligen Gipsformen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen von Modellzeichnungen mit Schwindungszugabe",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Garnieren und Nachbereiten von keramischen Rohlingen (zB Anpassen, Aufrauen, Anschlickern, Ansetzen von Formteilen, Abdrehen, Retuschieren, Verputzen und Verschwammen von Rohlingen)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Zusammensetzung und Herstellung von Glasuren, Engoben und Farben",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Abwiegen, Mischen und Aufbereiten von Glasuren, Engoben und Farben",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Veredeln keramischer Oberflächen durch plastisches und flächiges Dekorieren mit Glasuren, Engoben und Farben",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Trocken- und Brennvorganges (Ofenbeschickung, Brand, Ofenausnehmung) sowie der Trocknungs-, Setz- und Brennfehler",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Trocknen von keramischen Rohlingen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einsetzen von Brenngut sowie Mitarbeit beim Bedienen und Überwachen des Brennofens",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Materialgerechte Verpackung, und Lagerung der Produkte",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Überwachung, Kontrolle und Prüfung der Produkte auf die häufigsten Fehler an keramischen Erzeugnissen wie zB Haarrisse, Blasenbildung, Fremdeinschlüsse usw.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Qualitätssicherung einschließlich der Reklamationsbearbeitung und Durchführung von betriebsspezifischen, qualitätssichernden Maßnahmen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der betriebsspezifischen Hard- und Software",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Beruf relevanten Maßnahmen und Vorschriften zum Schutz der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufsrelevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften insbesondere über den Brandschutz sowie der sonstigen in Betracht kommenden Vorschriften zum Schutze des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 Berufsausbildungsgesetz)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse über die Erstversorgung bei betriebsspezifischen Arbeitsunfällen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 3
              }
            ]
          ],
          "merged_cells": true
        },
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gießen von Hohlkörpern",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Drehen und Formen einfacher Gegenstände",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Drehen und Formen mittelschwieriger Gegenstände (wie zB Vorbereiten, Einteilen, Zentrieren, Aufbrechen und Hochziehen der Drehmasse, Formen des Fußes, Bauches und Halses)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Drehen und Formen schwieriger Gegenstände (wie zB Formen von schwierigen Rändern und Tüllen, Drehen und Fertigmachen von Deckeln)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ein- und Überdrehen (Vorbereiten, Einteilen, Ein- und Auflegen der Masse, Vorformen der Masse mit der Hand, Fertigformen der Masse per Schablone)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Abdrehen des Rohlings mittels Abdrehwerkzeugen; Abdrehabfall wiederverwerten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vorbereiten der Henkelmasse (Kneten, Walken, Rollen), Herstellen der Henkel (Ziehen, Rollen, Pressen) und Angarnieren",
                "rowspan": 1,
                "colspan": 2
              }
            ]
          ],
          "merged_cells": true
        },
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gießen von Baukeramik",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Formen vom Blätterstock (Vorbereiten der Masse, Stock aufschlagen, Schneiden der Blätter von Stock, Ausformen, Aufbauen und Überschlagen mit dem Masseblatt)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Formen vom Massestrang (Vorbereiten der Masse, Kachelzeug mit Schablone ziehen und auf Gehrung zuschneiden, Herstellen von Schablonen)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Modellieren von Baukeramik durch Vorbereiten der Masse, freies Modellieren der Baukeramik sowie der Verzierteile, Auflegen und Angarnieren der Verzierteile",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fertigmachen von Baukeramik (Verstegen, Angarnieren, Anbringen von Befestigungs- und Verbindungs-vorrichtungen, Ausschneiden)",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": true
        },
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsvorgänge und des Arbeitsablaufes beim Formen (Drehen, Gießen, Pressen) von Gegenständen in der Serienfertigung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Manuelles Formen von keramischen Rohlingen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus und der Funktion von Formgebungs-maschinen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von Arbeitsformen aus Gips oder Kunststoff sowie Einsetzen der Arbeitsformen in die Formgebungsmaschinen und Prüfen der Pass-genauigkeit",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Umrüsten und Einrichten von Formgebungsmaschinen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bedienen und Überwachen von Formgebungsmaschinen zum Formen (Gießen, Pressen) von keramischen Rohlingen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Wartung, Pflege und einfache Instandhaltung der Formgebungsmaschinen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Protokollierung und grafische Auswertung von Arbeitsergebnissen sowie deren Dokumentation auch unter Anwendung der betriebsspezifischen EDV",
                "rowspan": 1,
                "colspan": 2
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

      "source_fingerprint": "f73693ce96d23a21c7d757cee4551d4492d53d041fde3eed25545a8f204feb25",
      "sha256": "e8df2a6223d4876c1e2866140c1c777b9d6d264e7b5e614982a9b515a0bef44f",
      "notes": [],

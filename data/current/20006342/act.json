      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Der Lehrbetrieb",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "1.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Aufgaben und Marktstellung des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "1.1.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Gesundheitswesens, der betriebsspezifischen Kontakte zu den jeweiligen Auftragnehmern, Kunden, Patienten oder Klienten und deren Verhalten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "1.1.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus sowie der innerbetrieblichen Abläufe des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "1.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Betriebseinrichtung, Hygiene, Arbeitssicherheit und Unfallverhütung",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "1.2.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und funktionsgerechte Anwendung der betrieblichen Einrichtungen und der technischen Betriebsmittel und Hilfsmittel",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "1.2.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der ergonomischen Gestaltung des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "1.2.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der wichtigsten medizinischen Einrichtungen einer zahnärztlichen Ordination",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.2.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der für den Arbeitsplatz erforderlichen Hygienemaßnahmen wie Desinfektion und Sterilisation",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwendung der für den Arbeitsplatz erforderlichen Hygienemaßnahmen wie Desinfektion und Sterilisation",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "1.2.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Pflege und Wartung der Handinstrumente",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "1.2.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erste Hilfe-Ausbildung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwendung von Erste-Hilfe-Maßnahmen im Notfall",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "1.2.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Unfallgefahren sowie der einschlägigen Sicherheitsvorschriften und der sonstigen in Betracht kommenden Vorschriften zum Schutze des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "1.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausbildung im dualen System",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "1.3.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 des Berufsausbildungsgesetzes)",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "1.3.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Inhalts und Ziels der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verwaltung, Organisation, Kommunikation und EDV",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "2.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsorganisation und Arbeitsgestaltung",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des fachgerechten Verhaltens und der fachgerechten Kommunikation mit Auftraggebern, Auftragnehmern, Kunden, Patienten, Klienten oder Lieferanten",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "2.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fach- und funktionsgerechte Verwendung und Pflege der betrieblichen, bürotechnischen Organisations-, Arbeits- und Kommunikationsmittel",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "2.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einschlägige Schriftverkehrsarbeiten sowie Arbeiten mit Formularen und Vordrucken, Arbeiten bei Postein- und -ausgang, Ablage, Evidenz und Registratur",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "2.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anlegen, Führen und Archivieren von Dateien, Statistiken, Karteien und Akten",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "2.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der betrieblichen Einrichtungen der EDV (Hardware, Software und Betriebssysteme) und von speziellen medizinischen EDV-Programmen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "2.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen arbeitsplatzspezifischer EDV-Anwendungen (wie Textverarbeitung, Kalkulation, Internet, E-Mail, Buchhaltung, Terminüberwachung und Ablage)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "2.8",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Qualitätswesens",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Kenntnis des betriebsüblichen Qualitätsmanagements",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "2.9",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Vermeidung, umweltgerechten Trennung und Entsorgung von im Betrieb anfallenden Abfall- und Reststoffen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "2.10",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der behördlichen Aufsichtsorgane, Sozialversicherungen und Interessenvertretungen, sowie der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "2.11",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Sozialrechtes (wie z. B. Kranken-, Pensions-, Arbeitslosenversicherung)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "2.12",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Patientenan- bzw. -aufnahme",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Patienten an- bzw. aufnehmen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "2.13",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der administrativen Aufgaben während und nach Abschluss der Patientenbehandlung (Behandlungsdokumentation)",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "Administrative Arbeiten im Zusammenhang mit der Patientenbehandlung durchführen (Behandlungsdokumentation)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.14",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Terminvereinbarung und -koordination mit Patienten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Empfang der Patienten",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.15",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Datenschutzes und der Geheimhaltung von Patientenunterlagen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "2.16",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des fachgerechten Umgangs mit besonderen Patientengruppen wie z. B. mit Kindern, schwierigen Patienten, Schmerzpatienten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachgerechter Umgang mit besonderen Patientengruppen wie z. B. mit Kindern, schwierigen Patienten, Schmerzpatienten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Betriebliches Rechnungswesen, Beschaffung und Angebot",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "3.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des betrieblichen Warenbestellwesens (Bestellmengen, Bestellzeitpunkte), der Wareneingangskontrolle und der Warenbewegung sowie der sich daraus ergebenden Belege",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Warenbestellungen in der betriebsüblichen Kommunikationsform durchführen sowie Kontrollieren der Warenlieferungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Verwaltung und Kontrolle von Lagerbeständen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitwirken bei der Verwaltung und Kontrolle von Lagerbeständen, Ermittlung des Lagerbedarfes und Überwachung des Lagerbestandes, unter Verwendung betrieblicher EDV-Systeme",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "3.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Überprüfen allfälliger Verbrauchsfristen und Ablauftermine",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "3.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Verrechnung mit Patienten, privaten Versicherungen und Sozialversicherungsträgern",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Durchführung der Verrechnung mit Patienten, privaten Versicherungen und Sozialversicherungsträgern",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Zahlungsverkehrs mit Lieferanten, Kunden, Behörden, Post, Geld- und Kreditinstituten",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Kenntnis des betriebsspezifischen Zahlungsverkehrs mit Lieferanten, Kunden, Behörden, Post, Geld- und Kreditinstituten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "3.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Kassaführung und des Kassabuchs",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Kenntnis der Kassaführung",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "3.8",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Zahlungsverkehrs und des betriebsüblichen Verfahrens bei Zahlungsverzug, Mahnwesen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Mitarbeit beim Zahlungsverkehr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.9",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Buchführung und der betrieblichen Buchungsunterlagen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachliche Grundlagen und Fachkunde",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachliche Grundlagen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.1.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Anatomie/Histologie/Physiologie",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.1.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der zahnspezifischen Anatomie (Histologie, Physiologie)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der zahnspezifischen Anatomie, Histologie, Physiologie",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.1.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Befundlehre und Krankheitslehre",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.1.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der spezifischen Erkrankungen der Mundhöhle und des stomatognathen Systems",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.1.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Pharmakologie und der wichtigsten Arzneimittelformen und –gruppen sowie deren Verabreichung",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.1.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse über Medizinprodukte sowie Grundlagen über deren Aufbereitung",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachkunde",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.2.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Röntgen-maßnahmen unter Beachtung des Strahlenschutzes",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Mitarbeit bei Röntgen-maßnahmen unter Beachtung des Strahlenschutzes",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.2.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der konservierenden Zahnheilkunde",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der konservierenden Zahnheilkunde (insbesondere Kariesursachen und -entstehung, Kariesdiagnostik, Füllungstherapie, Wurzelbehandlung)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Absaugtechnik",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.2.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitarbeit beim Legen und Entfernen von provisorischen Füllungen, plastischen Füllungen, Einlagefüllungen und Kronen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.2.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführung begleitender Maßnahmen bei der zahnärztlichen Diagnostik und Therapie",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.2.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der prothetischen Zahnheilkunde",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der prothetischen Zahnheilkunde (Abformung, Bissnahme, festsitzender und abnehmbarer Zahnersatz, Versorgung des zahnlosen Mundes, Situationsabdrücke, Provisorienherstellung, Implantatprothetik)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des zahntechnischen Labors",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des zahntechnischen Labors und der dort anfallenden Laborarbeiten",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Herstellen von Modellen und von Provisorien für festsitzenden Zahnersatz sowie Durchführen einfacher Reparaturen von gebrochenen oder gesprungenen Prothesen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.2.8",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der zahnärztlichen Chirurgie",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der zahnärztlichen Chirurgie (Chirurgische Instrumente und Materialien, chirurgische Eingriffe, Implantate, Anästhesie, Komplikationen bei chirurgischen Eingriffen)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2.9",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen eines sterilen Operationsumfeldes",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2.10",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Kieferorthopädie",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Kieferorthopädie (Zahnstellungs- und Kieferanomalien, kieferorthopädische Diagnostik und Behandlung)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2.11",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Prophylaxe und Parodontologie",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Prophylaxe und Parodontologie (Befunderhebung, Diagnostik und Therapie von Parodontalerkrankungen, Ernährungsrichtlinien, Mundhygienemaßnahmen, Dentalhygienehilfsmittel)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2.12",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit bei der Prophylaxe (Sichtbarmachen von Belägen, Belagkontrolle, Reinigung und Politur der Zähne, lokale Fluoridierung)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2.13",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführung begleitender Maßnahmen bei der Mundhygiene",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2.14",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit bei Kariesindizes und Kariesrisikobestimmungen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.2.15",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit bei der Erstellung des Parodontalstatus",
                "rowspan": 1,
                "colspan": 4
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

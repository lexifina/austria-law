      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werk- und Hilfsstoffe, ihrer Eigenschaften, Lagerung, Bearbeitungs- und Verarbeitungsmöglichkeiten sowie deren Verwendungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten sowie funktionsgerechtes Anwenden der zu verwendenden Werkzeuge, Maschinen, Geräte und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Farbenlehre (Farbtechnologie), Farbordnungssysteme, Farbpsychologie",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen von Gesprächen mit Vorgesetzten, Kollegen, Kunden und Lieferanten unter Beachtung der fachgerechten Ausdrucksweise",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erstellen von Skizzen und Zeichnungen auch unter Verwendung von im Betrieb vorhandenen rechnergestützten Systemen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von Polier- und Verlegeplänen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Entwickeln von eigenen Gestaltungsideen unter Berücksichtigung von Muster, Form und Farbe",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausmessen von Räumen und Ermitteln des Materialbedarfes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Herstellens (Aufstellen, Instandhalten, Bedienen, Abtragen) von einfachen Gerüsten und Arbeitsbühnen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von einfachen Bockgerüsten und Arbeitsbühnen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beurteilen, Überprüfen der Beschaffenheit von Böden, Decken und Wänden sowie Vorbereiten der Untergründe zB durch Säubern, Bürsten, Schleifen, Absaugen, Ausbessern von Fehlstellen, Vorstreichen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Materialgerechtes Lagern sowie auftragsbezogenes Auswählen von Werk- und Hilfsstoffen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zuschneiden von Tapeten, Wandbelägen, Stoffen und anderen Hilfsmaterialien",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausführen von Näharbeiten von Hand an unterschiedlichen Werkstoffen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausführen von Näharbeiten mit Maschine an unterschiedlichen Werkstoffen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gestalten und Anfertigen von Vorhängen und Dekorationen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden von facheinschlägigen Montage- und Befestigungstechniken (wie zB Dübeltechniken, Klebetechniken) unter Beachtung der rechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Karniesen- und Vorhangsysteme",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Montieren von Karniesen- und Vorhangsystemen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Reparieren und Warten von Karniesen- und Vorhangsystemen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arten, der Funktion und der Montage von Licht-, Sicht- und Sonnenschutzanlagen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen und Montieren von Licht-, Sicht- und Sonnenschutzanlagen wie zB durch Bespannen von Sonnenschutzanlagen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Reparieren und Warten von textil- und bespann-technischen Komponenten sowie aller industriell gefertigter Teile von Licht-, Sicht- und Sonnenschutzanlagen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vorbereiten und Bearbeiten von Wand- und Deckenbeschichtungsstoffen wie Tapeten, Wandbelägen, Wandbespannungs- und Wandbeschichtungsstoffen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anbringen von Wand- und Deckenbeschichtungsstoffen wie Tapeten, Wandbelägen, Wandbespannungs- und Wandbeschichtungsstoffen durch Spalieren, Verlegen, Verkleben, Ver- und Bespannen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Prüfen und Vorbereiten des Untergrundes für Mal- und Spalierarbeiten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Malen und Spalieren von Wänden und Decken",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vorbereiten von Untergründen und Verlegen von Bodenbelägen, insbesondere Teppichböden, Spannteppiche, elastische Bodenbeläge sowie Parkett- und Laminatböden",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einpassen und Verkleben von Bodenbelägen sowie Herstellen von Anschlussfugen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arten und des Aufbaus von Polstermöbeln",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vorbereiten der Gestelle für Polstermöbel",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Festlegen der Maße für die Polsterung sowie Auswählen und Anbringen des Polstergrundes und der Unterfederung",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Begurten, Füllen und Garnieren",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Aufbauen von klassischen Polstermöbeln durch Begurten, Federstellen, Schnüren, Füllen, Garnieren, Pikieren, Beziehen mit Bezugsstoff, Ausführen von Abschlussarbeiten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einbringen von Federkernen und Schaumstoffkombinationen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Aufbauen von modernen Polstermöbeln durch Begurten, Einbringen von Federkernen und/oder Schaumstoffkombinationen, Bepolstern sowie Beziehen mit Bezugsstoff, Ausführen von Abschlussarbeiten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Reparieren von Polstermöbeln",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beziehen und Herstellen von Bettwaren",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kontrollieren und Prüfen der durchgeführten Arbeiten auf Fehler sowie Beseitigen der Fehler im Anlassfall",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausfüllen von Ausmaß- und Arbeitsbestätigungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Qualitätssicherung einschließlich der Reklamationsbearbeitung und Durchführung von betriebsspezifischen, qualitätssichernden Maßnahmen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 BAG)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften und Normen sowie der einschlägigen Vorschriften zum Schutz des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 3
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

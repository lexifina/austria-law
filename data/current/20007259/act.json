      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "2d85cc4358585787a15e267c8d43fe5926edccfdca19c00fbb820f0b0fae9d0e",
      "sha256": "6a0b69b3a7527ef4011d7c31045cb556ea1843b5064221d7e4bf041a6552a72a",
      "notes": [],

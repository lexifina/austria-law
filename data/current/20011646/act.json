      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "Bedeutung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Erklärung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Bild",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Achtung Beginn der Einweisung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Arm gestreckt hochhalten",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Halt",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Beide Arme seitlich waagrecht ausstrecken und in dieser Lage halten. Im Bedarfsfall darf das Zeichen auch einarmig gegeben werden.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Halt – Gefahr",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Beide Arme waagrecht abwechselnd ausstrecken und anwinkeln.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Langsam",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Unterarm nach unten gestreckt langsam nach links und rechts schwenken, solange die vorsichtige Bewegung erforderlich ist. Dieses Zeichen gilt für alle Bewegungsrichtungen der mechanischen Einrichtung oder des Betriebsmittels.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Abstandszeichen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Der zurückzulegende Weg wird durch den horizontalen Abstand der Handflächen angezeigt. Nach Erreichen des gewollten Abstandes ist das Handzeichen „Halt“ zu geben.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Bewegung in Richtung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Den der Bewegungsrichtung zugeordneten Arm anwinkeln und seitlich hin und her bewegen.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Heben",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mit einem nach oben zeigenden Arm kreisen.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Senken",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mit einem nach unten zeigenden Arm kreisen.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Ausladung verkleinern",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mit beiden erhobenen Armen kreisen.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Ausladung vergrößern",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mit beiden herabhängenden Armen kreisen.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Öffnen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arm mit nach unten halb geöffneter Hand seitlich gestreckt halten.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Schließen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arm mit nach unten geschlossener Hand seitlich gestreckt halten.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Herkommen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mit beiden Armen und den zum Körper zugekehrten Handflächen heranwinken.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Entfernen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mit beiden Armen und den vom Körper abgekehrten Handflächen wegwinken.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Abfahren",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mit hochgestrecktem Arm und nach vorn gekehrter Handfläche wegwinken.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Ende der Einweisung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Unterarme in Brusthöhe kreuzen.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    }

      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "4. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Ziele und der Marktposition des Lehrbetriebes sowie der Standorteinflüsse",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der für den Betrieb maßgeblichen Standorteinflüsse und des Kundenverhaltens",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Auswirkungen von Trends, Wertschöpfung und wirtschaftlicher Ziele der Branche",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachübergreifende Ausbildung (Schlüsselqualifikationen) In der Art der Vermittlung der fachlichen Kenntnisse und Fertigkeiten ist auf die Förderung folgender fachübergreifender Kompetenzen des Lehrlings Bedacht zu nehmen:",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Methodenkompetenz, zB Lösungsstrategien entwickeln, Informationen selbstständig beschaffen, auswählen und strukturieren, Entscheidungen treffen etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Soziale Kompetenz, zB in Teams arbeiten, Mitarbeiter führen etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Personale Kompetenz, zB Selbstvertrauen und Selbstbewusstsein, Bereitschaft zur Weiterbildung, Bedürfnisse und Interessen artikulieren etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kommunikative Kompetenz, zB mit Kunden, Vorgesetzten, Kollegen und anderen Personengruppen zielgruppengerecht kommunizieren; Englisch auf branchen- und betriebsüblichem Niveau zum Bestreiten von Alltags- und Fachgesprächen beherrschen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeitsgrundsätze, zB Sorgfalt, Zuverlässigkeit, Verantwortungsbewusstsein, Pünktlichkeit etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundenorientierung: Im Zentrum aller Tätigkeiten im Betrieb hat die Orientierung an den Bedürfnissen der Kunden unter Berücksichtigung der Sicherheit zu stehen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Arbeitsplanung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsplanung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der einschlägigen gesetzlichen Bestimmungen (zB Seilbahngesetz, Schleppliftverordnung) sowie Kenntnis und Anwendung der Betriebsvorschriften und Beförderungsbedingungen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Kenntnis der spezifischen gesetzlichen Bestimmungen und deren Anwendung (zB Seilbahngesetz, Verordnungen)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Ablaufes des Fahrgastverkehrs",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Technische Grundkenntnisse der angewandten Kassensysteme und der Zutrittskontrolle",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Technische Kenntnisse der angewandten Kassensysteme und der Zutrittskontrolle",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben, Reinigen und Instandhalten der zu verwendenden Werkzeuge, Maschinen, Geräte, Vorrichtungen, Einrichtungen und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werkstoffe und Hilfsstoffe, ihrer Eigenschaften, Verwendungsmöglichkeiten und Bearbeitungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von technischen Unterlagen wie von Skizzen, Zeichnungen, Plänen, Schaltplänen usw.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen von Skizzen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Anfertigen von normgerechten Werkzeichnungen einfacher Bauteile und von Schaltplänen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben von Mess- und Prüfgeräten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Messen von mechanischen und elektrischen Größen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Messen und Prüfen von seilbahntechnischen Einrichtungen (mechanisch und elektrisch)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fertigkeiten in der Werkstoffbearbeitung (Metall, Kunststoff) von Hand und unter Verwendung von Maschinen und Geräten (zB Drehen, Fräsen)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Anfertigen von einfachen Hilfswerkzeugen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von einschlägigen lösbaren (wie zB Schrauben) und unlösbaren Verbindungen (wie zB Schweißen, Nieten, Löten, Kleben) unter Beachtung der Gefahren und unter Anwendung der Maßnahmen zur Unfallverhütung",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der wichtigsten Arten des Oberflächenschutzes zur Verhinderung der Korrosion",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der wichtigsten Arten des Oberflächenschutzes zur Verhinderung der Korrosion",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausbauen und Einbauen von Maschinenelementen und Bauteilen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Elektrotechnik und Elektronik",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Gefahren des elektrischen Stromes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Betriebes und der Anwendung elektrischer und elektronischer Bauteile und Baugruppen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beheben von einfachen Fehlern und Austauschen einfacher elektrischer und elektronischer Bauteile",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erkennen und Beheben von komplexen Fehlern elektrischer und elektronischer Bauteile",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Bustechnik und der freiprogrammierbaren Steuerungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Bustechnik und der freiprogrammierbaren Steuerungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der elektrischen Seilbahnausrüstungen und -steuerungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der komplexen Zusammenhänge von elektrischen Steuereinrichtungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Hydraulik und Pneumatik",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der hydraulischen und pneumatischen Steuerungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der hydraulischen und pneumatischen Steuerungen hinsichtlich möglicher Störungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Kraft-, Kühl- und Schmierstoffe und anderer Betriebsflüssigkeiten sowie über deren Eigenschaften",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der Sicherheitsvorschriften über die Lagerung und den Umgang mit brennbaren Flüssigkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Instandhaltungs- und Wartungspläne sowie des Betriebstagebuchs und Hauptuntersuchungsberichtes",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitarbeiten beim Führen des Betriebstagebuchs und der Revisionsberichte",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen des Betriebstagebuchs und der Revisionsberichte",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Aufbaus und der Funktion von Standseil- und Seilschwebebahnen (Pendelseilbahn, Umlaufseilbahn), ihrer Stationseinrichtungen sowie von Schleppliften",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Aufbaus und der Funktion der baulichen Einrichtungen von Seilbahnen bzw. Schleppliften im Bereich der Seilbahnstützen, Stützenfundamente und -ausrüstungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus und der Funktion sowie Mitarbeit beim Warten, Instandhalten und Überprüfen der baulichen Einrichtungen von Seilbahnen bzw. Schleppliften im Bereich der Stationen und bei Stützenfundamenten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus und der Funktion sowie Mitarbeit beim Bedienen, Warten, Instandhalten und Überprüfen der Funktion von seilbahntechnischen Einrichtungen wie zB Kabinen, Türsystemen, Bremsen, Klemmen, Gehängen, Laufwerken, Antrieben, Kraftübertragungseinrichtungen, Getrieben, Kupplungen und Schaltungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Bedienen, Warten, Instandhalten und Überprüfen der Funktion von seilbahntechnischen Einrichtungen wie zB Kabinen, Türsystemen, Bremsen, Klemmen, Gehängen, Laufwerken, Antrieben, Kraftübertragungseinrichtungen, Getrieben, Kupplungen und Schaltungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Seile, Seilpflege, Seilkontrolle, Seilmeldebögen und Seilabspannungen sowie Mitarbeit beim Pflegen von Seilen sowie beim Warten, Instandhalten und Überprüfen von Seilen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Pflegen von Seilen sowie Warten, Instandhalten und Überprüfen von Seilen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen von Vorbereitungsarbeiten zur Reparatur von Seilen (zB Abspannen von Seilen)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Funktionsweise sowie Mitarbeit beim Bedienen der Seilbahn- bzw. Schleppliftanlage und der Not-, Hilfs- und Bergeantriebe",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Bedienen der Seilbahn- bzw. Schleppliftanlage und der Not-, Hilfs- und Bergeantriebe im Anlassfall",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Suchen und Beheben von Störungen an Seilbahnen bzw. Schleppliften",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Suchen und Beheben von Störungen an Seilbahnen bzw. Schleppliften",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus und der Funktion der betrieblichen Signal- und Kommunikations-anlagen wie zB Funksysteme",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden der betrieblichen Signal- und Kommunikationsanlagen wie zB von Funksystemen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des betrieblichen Bergeplans sowie des Umganges mit den Bergeeinrichtungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden des betrieblichen Bergeplans sowie der Bergeeinrichtungen im Anlassfall",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Krisenpräventions-maßnahmen und der Krisenkom-munikationspläne",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim betrieblichen Krisenmanagement im Anlassfall",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden des betrieblichen Krisenmanagements im Anlassfall",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Pistenbaus und der Pistenerhaltung unter den Aspekten Sicherheit, Ökologie und Wirtschaftlichkeit",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Pistenbaus unter den Aspekten Sicherheit, Ökologie und Wirtschaftlichkeit sowie Grundkenntnisse der Beschneiung von Pisten, des Aufbaus und der Funktion von Beschneiungsgeräten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Mitarbeit bei der Pistenerhaltung unter den Aspekten Sicherheit, Ökologie und Wirtschaftlichkeit",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Pistensicherungs-systeme wie zB Pistenleitsysteme, Absperrnetzen usw.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Pistensicherungs-systeme wie zB Pistenleitsysteme, Absperrnetzen usw.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Umsetzen von Vorgaben der Pistensicherungssysteme",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Wetterentwicklung, Wettertrends und Lawinenkunde",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Wetterentwicklung, Wettertrends und Lawinenkunde",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erkennen und Reagieren auf die Wetterentwicklung hinsichtlich des sicheren Betriebes (Sturm, Wind, Gewitter und Lawinen)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Qualitätssicherung und Qualitätskontrolle",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung des betriebsspezifischen Qualitätsmanagements einschließlich Dokumentation",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des betrieblichen Brandschutzes sowie der vorbeugenden Brandschutzmaßnahmen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der betrieblichen EDV (Hard- und Software)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen sowie der Verrechnungssysteme",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen sowie der Verrechnungssysteme",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Analysieren der betrieblichen Kosten in Bezug auf mögliche Verbesserungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "45",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erste Hilfe-Ausbildung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden von Erste-Hilfe-Maßnahmen im Anlassfall",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "46.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 BAG)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "47.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "48.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen maschinenbautechnischen und elektrotechnischen Bau- und Sicherheitsvorschriften und Normen sowie der einschlägigen Vorschriften zum Schutz des Lebens und der Gesundheit unter besonderer Beachtung der von den Versorgungseinrichtungen ausgehenden Gefahren",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "49.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 4
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

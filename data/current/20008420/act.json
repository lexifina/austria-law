      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "4. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachübergreifende Ausbildung (Schlüsselqualifikationen) In der Art der Vermittlung der fachlichen Kenntnisse und Fertigkeiten ist auf die Förderung folgender fachübergreifender Kompetenzen des Lehrlings Bedacht zu nehmen:",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Methodenkompetenz (zB Lösungsstrategien entwickeln, Informationen selbstständig beschaffen, auswählen und strukturieren, Entscheidungen treffen etc.)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Soziale Kompetenz ( zB in Teams arbeiten, Mitarbeiter führen etc.)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Personale Kompetenz (zB Selbstvertrauen und Selbstbewusstsein, Bereitschaft zur Weiterbildung, Bedürfnisse und Interessen artikulieren etc.)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kommunikative Kompetenz (zB mit Kunden/innen, Vorgesetzten, Kollegen/innen und anderen Personengruppen zielgruppengerecht kommunizieren; Englisch auf branchen- und betriebsüblichem Niveau zum Bestreiten von Alltags- und Fachgesprächen beherrschen)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeitsgrundsätze (zB Sorgfalt, Zuverlässigkeit, Verantwortungsbewusstsein, Pünktlichkeit etc.)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundenorientierung: Im Zentrum aller Tätigkeiten im Betrieb hat die Orientierung an den Bedürfnissen der Kunden/innen unter Berücksichtigung der Sicherheit zu stehen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsplanung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Maschinen, Geräte und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von technischen Unterlagen wie von Skizzen, Zeichnungen, Plänen, Diagrammen, Fließschematas usw.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einfaches manuelles und maschinelles Bearbeiten von Werkstoffen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Roh- und Ausgangsstoffe (textile Rohstoffe, Garne, Zwirne) für die Textilindustrie, ihrer Eigenschaften sowie Erkennungsmerkmale, Verwendungs- und Verarbeitungsmöglichkeiten auch im Hinblick auf Ökologie und Nachhaltigkeit",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Garnnummerierung, Garnbestimmung und Garnberechnung",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Grundbindungen bzw. Konstruktion von Linien- und Flächenprodukten",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Grundbindungen bzw. Konstruktion von Linien- und Flächenprodukten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Eigenschaften und Verwendungsmöglichkeiten der betriebsspezifischen Produkte",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Eigenschaften und Verwendungsmöglichkeiten der betriebsspezifischen Produkte",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der textilen Fertigungskette",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Veredelungsprozesse wie zB Färben, Drucken, Beschichten, Appretieren, der Arbeitsschritte und (wie zB Temperatur, pH-Wert, Redoxwert usw.), der Qualitätsmerkmale der veredelten Produkte sowie des Aufbaus und der Funktion der dazu benötigten Geräte, Maschinen und Anlagen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "-",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der in den Veredelungsprozessen eingesetzten Chemikalien wie Farbstoffe, Pasten, Druckmittel, Entschlichtungs-, Bleich- und Appreturmittel, ihrer Eigenschaften, Qualitätsmerkmale, Verwendungs- und Verarbeitungsmöglichkeiten, Einsatzgebiete, der möglichen Auswirkungen auf die Gesundheit der Konsumenten sowie über den Umgang mit Sicherheitsdatenblättern und den daraus abzuleitenden Maßnahmen und Verhaltensweisen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Auswählen, Annehmen, Prüfen auf Verwendbarkeit und Lagern der betriebsspezifischen Chemikalien",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Auswählen, Annehmen, Prüfen auf Verwendbarkeit und Lagern der betriebsspezifischen Chemikalien",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der berufsspezifischen Mathematik wie zB Mischungsrechnungen und Rezepturberechnungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Ansetzen von Pasten (zB Farb- oder PVC-Pasten) bzw. Ansetzens von Flotten (zB Farbflotten) sowie des Aufbaus und der Funktion der dazu benötigten Geräte und Maschinen (zB Dreiwalzenstuhl, Disolver, Planetenrührer, Dosieranlagen usw.)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Anwenden von Rezepturen und Ansetzen von Mischungen, Pasten und Flotten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden von Rezepturen und Ansetzen von Mischungen, Pasten und Flotten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des optimalen Materialflusses (Roh- und Ausgangsstoffe) für die Produktion",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Zusammenstellen und Vorbereiten von Veredelungspartien",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zusammenstellen und Vorbereiten von Veredelungspartien",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Rüsten, Anfahren, Bedienen, Überwachen (zB Prozessbedingungen wie Temperatur, pH-Wert, Redoxwert usw.) und Ab- bzw. Umstellen der Geräte, Maschinen und Anlagen zur Veredelung von Textilien",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Rüsten, Anfahren, Bedienen, Überwachen (zB Prozessbedingungen wie Temperatur, pH-Wert, Redoxwert usw.) und Ab- bzw. Umstellen der Geräte, Maschinen und Anlagen zur Veredelung von Textilien",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechnergestütztes Prozessüberwachen und Durchführen von Prozesskontrollen und Prozessoptimierungen sowie Erfassen von Betriebsdaten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Dokumentieren der produktionsrelevanten Daten (zB Störungsaufzeichnungen) sowie deren Überprüfung auf Vollständigkeit und Richtigkeit",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Überwachen, Kontrollieren und Prüfen der Produkte sowie beim Einleiten von Korrekturmaßnahmen im Anlassfall",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Überwachen, Kontrollieren und Prüfen der Produkte sowie Einleiten von Korrekturmaßnahmen im Anlassfall",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erkennen und Beheben von Störungen an Maschinen und Anlagen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Wartens und Instandhaltens sowie Mitarbeiten beim Warten, Pflegen und einfachem Instandhalten der betriebsspezifischen Maschinen und Anlagen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Warten, Pflegen und einfaches Instandhalten der betriebsspezifischen Maschinen und Anlagen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der vor- und nachgelagerten Produktionsstufen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der in der Textilindustrie verwendeten Prüfvorschriften und Prüfnormen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden der in der Textilindustrie verwendeten Prüfvorschriften und Prüfnormen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der berufsspezifischen anorganischen und organischen Chemie sowie der Physik",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der berufsspezifischen Chemie der Polymere",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis einfacher labortechnischer Grundoperationen wie Wägen, Abmessen, Filtrieren, Herstellen von Lösungen, Temperaturmessungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen einfacher labortechnischer Grundoperationen wie Wägen, Abmessen, Filtrieren, Herstellen von Lösungen, Temperaturmessungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der textilphysikalischen und analytischen Arbeitstechniken wie Dichtebestimmungen, pH-Wert- und Viskositätsbestimmungen, fotometrische Bestimmungen, Maßanalyse, Wasseranalyse und des Aufbaus von Versuchsapparaturen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten bei textilphysikalischen und analytischen Arbeitstechniken wie Dichtebestimmungen, pH-Wert- und Viskositätsbestimmungen, fotometrische Bestimmungen, Maßanalyse, Wasseranalysen und beim dazu notwendigen Aufbau von Versuchsapparaturen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Durchführen von textilphysikalischen und analytischen Arbeitstechniken wie Dichtebestimmungen, pH-Wert- und Viskositätsbestimmungen, fotometrische Bestimmungen, Maßanalyse, Wasseranalysen und des dazu notwendigen Aufbau von Versuchsapparaturen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen von Faseranalysen mittels Mikroskopie und anderen chemischen Analysemethoden",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Nachweisen von Faserschädigungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Farbstoffklassen, deren Echtheiten, Färbe- bzw. Drucktechnologien sowie über Farbmetrik und Rezepturen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen und Handhaben von Farbkarten, Rezepturen und einschlägigen Tabellen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bestimmen von Echtheiten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Ökolabels und über dessen Bedeutung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis des Ökolabels und über dessen Bedeutung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Maßnahmen des Qualitäts- und Umweltmanagements",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitarbeiten beim Qualitäts- und Umweltmanagement",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis von Methoden zur kontinuierlichen Prozessverbesserung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der neuesten Trends und Anforderungen im betrieblichen Produktbereich",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der einschlägigen englischen Fachausdrücke",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der betrieblichen EDV (Hard- und Software)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "46.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 BAG)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "47.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "48.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutz der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "49.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften und Normen sowie der einschlägigen Vorschriften zum Schutz des Lebens und der Gesundheit, insbesondere der berufsspezifischen Arbeitshygiene- und Sicherheitsvorschriften und den Umgang mit elektrischen Strom",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "50.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Erstversorgung bei betriebsspezifischen Arbeitsunfällen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "51.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 4
              }
            ]
          ],
          "merged_cells": true
        }
      ]

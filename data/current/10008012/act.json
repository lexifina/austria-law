      "tables": [
        {
          "cells": [
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Gemäß dem Artikel 6 Absatz 2 dieses Abkommens werden folgende Daten mitgeteilt:",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Name der Anlage,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ort der Unterbringung und Adresse der Anlage,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bezeichnung der Anlage,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "wichtigste technische Daten der Anlage,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "gegenwärtiger Status der Anlage,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Betriebsdaten,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beschreibung des Ortes der Anlage.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Im Falle eines Kernreaktors werden zusätzlich folgende Daten mitgeteilt:",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Reaktortyp,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Leistung,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beschreibung der Spaltzone",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "(z. B.: Geometrie, Brennstoff, Belastung, Anreicherung, Abbrand, Leistungsdichte),",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Typ des Reaktorgefäßes,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kühlmittel, Kühlkreisläufe (primär und sekundär),",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Typ des Dampferzeugers,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "zulässige Werte der Abgabe radioaktiver Stoffe in die Umwelt,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Systeme zur Gewährleistung der nuklearen Sicherheit.",
                "rowspan": 1,

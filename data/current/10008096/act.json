      "file": "art-002.md",
      "source_context": null,
      "identity_review_required": false,
      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "227120bb44ffa22549c0b151b44889f62801e611b2bb4f25da89f01212e0dc76",
      "sha256": "0286524d908d2d2aa7e99221eeb3e71a1ad70d70f754a72ac37106aa1b0e3e9b",
      "notes": [],
      "links": [],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "der Erkrankungen und Giftstoffe:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "der entsprechenden Berufe, Gewerbe und Verfahren:",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Vergiftungen durch Blei, feine Legierungen oder Verbindungen, sowie die unmittelbaren Folgen dieser Vergiftungen.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Behandlung bleihaltiger Erze, einschließlich bleihaltiger Rückstände in Zinkwerken.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einschmelzen von altem Zink und Blei zu Barren.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellung von Gegenständen aus geschmolzenem Blei oder bleihaltigen Legierungen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Polygraphische Gewerbe.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellung von Bleiverbindungen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellung und Ausbesserung elektrischer Akkumulatoren.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zubereitung und Verwendung von bleihaltigen Emaillen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Polieren mit Bleispänen oder bleihaltigen Stoffen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anstreicherarbeiten, bei denen bleihaltige Streichmittel, Kitte oder Farben zubereitet oder gebraucht werden.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Vergiftungen durch Quecksilber, feine Legierungen oder Verbindungen, sowie die unmittelbaren Folgen dieser Vergiftungen.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Behandlung von quecksilberhaltigen Mineralien.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellung von Quecksilberverbindungen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellung von Meß- und Laboratoriumsapparaten.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zubereitung der Rohstoffe für die Hutmacherei.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Feuervergoldung.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verwendung von Quecksilberpumpen für die Herstellung von Glühlampen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellung von Knallquecksilberzündern.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Ansteckung durch Milzbrand.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeiten bei milzbrandverseuchten Tieren.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Behandlung von Tierleichen oder tierischen Abfällen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ein- und Ausladen sowie Beförderung von Waren.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Silikose mit oder ohne Lungentuberkulose, sofern die Silikose eine entscheidende Ursache der Arbeitsunfähigkeit oder des Todes ist.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Von der Gesetzgebung als silikosegefährlich anerkannte Gewerbe oder Verfahren.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Vergiftungen durch Phosphor oder seine Verbindungen, sowie die unmittelbaren Folgen dieser Vergiftungen.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Alle Verfahren, bei denen Phosphor oder seine Verbindungen hergestellt werden, entweichen oder verwendet werden.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Vergiftungen durch Arsen oder seine Verbindungen, sowie die unmittelbaren Folgen dieser Vergiftungen.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Alle Verfahren, bei denen Arsen oder seine Verbindungen hergestellt werden, entweichen oder verwendet werden.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Vergiftungen durch Benzol oder seine Homologen, deren Nitro- und Aminoderivate, sowie die unmittelbaren Folgen dieser Vergiftungen.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Alle Verfahren, bei denen Benzol oder dessen Homologen oder deren Nitro- und Aminoderivate hergestellt werden, entweichen oder verwendet werden.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Vergiftungen durch die Halogenderivate der Kohlenwasserstoffe der Fettreihe.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Alle von der Gesetzgebung bezeichneten Verfahren, bei denen Halogenderivate der Kohlenwasserstoffe der Fettreihe hergestellt werden, entweichen oder verwendet werden.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Krankhafte Erscheinungen infolge: a) Radiums und sonstiger radioaktiver Stoffe, b) Röntgenstrahlen.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Alle Verfahren, die Personen der Wirkung von Radium, radioaktiven Stoffen oder Röntgenstrahlen aussetzen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Primärer Hautkrebs.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Alle Verfahren, bei denen mit Teer, Pech, Erdpech, Mineralölen, Paraffin oder Verbindungen, Produkten oder Rückständen dieser Stoffe umgegangen wird oder diese verwendet werden.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },

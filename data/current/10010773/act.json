      "identity_review_required": false,
      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "50b26119096604237725caffb832be27b4e4c659f1330d9c046d6f2d092fc61a",
      "sha256": "acbbafd31df245ed148d60c75583757ac1cd26269e3ae966e66e9a2049288dbb",
      "notes": [],
      "links": [],

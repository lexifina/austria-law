      "notes": [
        {
          "kind": "Langtitel",
          "text": "Bundesgesetz betreffend die Errichtung eines Fonds zur Abgeltung von Borkenkäferschäden, zur Förderung klimafitter, artenreicher Wälder und zur Stärkung der Verwendung des Rohstoffes Holz (Waldfondsgesetz) StF: BGBl. I Nr. 91/2020 (NR: GP XXVII RV 282 AB 340 S. 43. BR: AB 10396 S. 910.)"
        },
        {
          "kind": "Änderung",
          "text": "BGBl. I Nr. 152/2023 (NR: GP XXVII RV 2267 AB 2298 S. 239. BR: 11336 AB 11341 S. 960.) BGBl. I Nr. 50/2024 (NR: GP XXVII RV 2504 AB 2523 S. 259. BR: AB 11485 S. 966.) BGBl. I Nr. 25/2025 (NR: GP XXVIII RV 69 und Zu 69 AB 100 S. 30. BR: 11643 AB 11645 S. 979.) BGBl. I Nr. 62/2026 (NR: GP XXVIII RV 523 AB 561 S. 89. BR: 11838 AB 11839 S. 994.)"
        }

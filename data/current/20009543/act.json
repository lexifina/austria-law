              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachübergreifende Ausbildung (Schlüsselqualifikationen) In der Art der Vermittlung der fachlichen Kenntnisse und Fertigkeiten ist auf die Förderung folgender fachübergreifender Kompetenzen des Lehrlings Bedacht zu nehmen:",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Methodenkompetenz: zB Lösungsstrategien entwickeln, Informationen selbstständig beschaffen, auswählen und strukturieren, Entscheidungen treffen etc.",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Soziale Kompetenz: zB in Teams arbeiten, Mitarbeiter/innen führen etc.",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Personale Kompetenz: zB Selbstvertrauen und Selbstbewusstsein, Bereitschaft zur Weiterbildung, Bedürfnisse und Interessen artikulieren etc.",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kommunikative Kompetenz: zB mit Kunden/innen, Vorgesetzten, Kollegen/innen und anderen Personengruppen zielgruppengerecht kommunizieren; Englisch auf branchen- und betriebsüblichem Niveau zum Bestreiten von Alltags- und Fachgesprächen beherrschen",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeitsgrundsätze: zB Sorgfalt, Zuverlässigkeit, Verantwortungsbewusstsein, Pünktlichkeit etc.",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundenorientierung: Im Zentrum aller Tätigkeiten im Betrieb hat die Orientierung an den Bedürfnissen der Kunden/innen unter Berücksichtigung der Sicherheit zu stehen",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen von Gesprächen mit Vorgesetzten, Kollegen/innen, Kunden/innen und Lieferanten/innen unter Beachtung der fachgerechten Ausdrucksweise",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitwirken beim Beraten und Betreuen von Kunden/innen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beraten und Betreuen von Kunden/innen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsplanung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von Zeichnungen und Skizzen",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen von Skizzen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Anfertigen von einfachen Werkzeichnungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des rechnergestützten Konstruierens und Zeichnens (CAD) sowie der rechnergestützten Produktion (zB mittels CNC)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des rechnergestützten Konstruierens und Zeichnens (CAD) sowie der rechnergestützten Produktion (zB mittels CNC)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einfaches rechnergestütztes Konstruieren und Zeichnen (CAD) sowie rechnergestützte Produktion (zB mittels CNC) soweit diese Techniken vom Angebotsprogramm des Lehrbetriebes umfasst sind",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Geräte, Maschinen, Vorrichtungen, Einrichtungen und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werkstoffe und Hilfsstoffe, ihrer Eigenschaften, Verwendungsmöglichkeiten, Be- und Verarbeitungsmöglichkeiten sowie über deren fachgerechte Lagerung",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitwirken beim Bestimmen, Beurteilen und Auswählen von Hölzern, Werk- und Hilfsstoffen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Bestimmen, Beurteilen und Auswählen von Hölzern, Werk- und Hilfsstoffen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Messen, Anreißen, Hobeln, Sägen, Stemmen, Bohren, Fräsen, Furnieren, Leimen und Kleben",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von lösbaren und unlösbaren Materialverbindungen",
                "rowspan": 1,

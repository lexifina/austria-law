                "colspan": 1
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Qualitätskontrolle",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen von Funktionsprüfungen und von Qualitätskontrollen",

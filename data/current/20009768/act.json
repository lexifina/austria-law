      "tables": [
        {
          "cells": [
            [
              {
                "text": "Ausbildungs- und Prüfungsfach",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Richt-stunden-anzahl",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lehrinhalte – Schwerpunkte",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Grundlagen des Österreichischen Verfassungsrechts und der Behördenorganisation sowie des Rechts der Europäischen Union",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "16",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Überblick über die Grundprinzipien der Verfassung, den Stufenbau der Rechtsordnung, die Staatsgewalten, den Weg der Bundesgesetzgebung, die Organisation der Verwaltung und Gerichtsbarkeit, den Rechtsschutz und die Kontrolle, die Grund- und Freiheitsrechte sowie über das Recht der Europäischen Union",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Grundlagen des Dienst- und Besoldungsrechts der Bundesbediensteten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "16",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundlagen des Dienst- und Besoldungsrechts der Bundesbediensteten, insbesondere der Militärpersonen und Militär-VB",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Grundlagen des Wehrrechts, des Einsatzrechts und des Humanitären Völkerrechts",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "30",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundlagen der Wehrverfassung, des Wehrgesetzes, des Auslandseinsatzrechts, des Heeresdisziplinargesetzes, des Militärbefugnisgesetzes, des Einsatzrechts sowie des Rechts der bewaffneten Konflikte, Genfer Konvention",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Heereskunde und Gefechtsmittellehre **",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "40",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gliederung des Bundesheeres, Grundkenntnisse über Truppen– und Waffengattungen, militärische Begriffe, taktische Zeichen und Abkürzungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Politische Bildung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "20",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Nationale und internationale Sicherheitspolitik, Europäische Sicherheits- und Verteidigungspolitik, Strukturen und Aufgaben ausgewählter internationaler Organisationen, Einsätze des Bundesheeres im Rahmen internationaler Organisationen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Ausbildungsmethodik und Führungsverhalten **",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "242",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundlagen des Führungsverhaltens und der Kommunikation, Grundlagen der Rhetorik, psychologische, pädagogische und didaktische Grundlagen, Kritikgespräch, Selbst- und Fremdbild, gruppendynamische Prozesse, Ausbildungsmethoden, Vor- und Nachbereitung der Ausbildung, Ausbildung zum Sicherheitsorgan beim Scharfschießen, Ausbildung zum Ausbildner in Gefechtsdienst sowie Waffen- und Schießdienst, praktische Ausbildung bei Drill- und Standardsituationen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Führen und Aufgaben im Einsatz **",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "370",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führungsverfahren und Befehlsgebung, taktische Zeichen und Skizzen, Einsatzarten im Rahmen von friedensunterstützenden Operationen, Führung der Gruppe in den Einsatzarten Sicherung, Marsch, Aufklärung, Bewachung und Überwachung, Anordnung, Durchführung und Überwachung von allgemeinen Aufgaben im Einsatz einschließlich der Einsatzunterstützung, Führung der Gruppe unter psychischer und physischer Belastung, Führung der Gruppe im scharfen Schuss im Rahmen eines Gruppengefechtsschießens, Einsatz von Schließmitteln – Grundtechniken zur Anwendung unmittelbarer Zwangsgewalt",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Fremdsprachenausbildung **",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "180",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einfache Anwendung der Fremdsprache „Englisch“ im täglichen Dienstbetrieb (Erreichung der Leistungsstufe 1).",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Körperausbildung **",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "152",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Methodik der Körperausbildung, Verbessern der eigenen Ausdauer, Geschicklichkeit und Kraft",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Dienstbetrieb *,**",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "20",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Dienstbetrieb und Schriftverkehr, Heereskraftfahrdienst, Militärische Sicherheit, Personalvertretungsangelegenheiten, Angelegenheiten der Gleichbehandlung und des Gender Mainstreamings",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Berufsethische Bildung *,**",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "20",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gewissen und Verantwortung im militärischen Einsatz, ethische, moralische und sittliche Anforderungen an den Unteroffizier im Krieg und im Frieden, Interkulturalität",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    }
  ]
}

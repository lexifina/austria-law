              },
              {
                "text": "Betreiberstaat Verantwortlichkeiten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Anhang 1 Ziffer 1.2.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Flugpersonal und Bodenpersonal Lizenzierung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Validierung der durch den ICAO Mitgliedstaat ausgestellten Lizenzen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Anhang 6, Teil 1, Ziffer 5.2.4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Betrieb von Luftfahrzeugen im Einklang mit deren Luftfahrttüchtigkeitszertifikaten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "nicht anwendbar",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Übernahme der Zuständigkeiten des Registerstaates im Sinne von Anhang 6, Teil 1, Ziffer 5.2.4",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Anhang 6, Teil 1, Ziffer 8.1.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zuständigkeiten des Betreibers betreffend Instandhaltung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Genehmigung von Instandhaltungsbetrieben",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anerkennung von Instandhaltungsbetrieben",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Annex 6, Teil 1, Ziffer 8.2.1-8.2.4,",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Betreiber “Maintenance Control Manual” (MCM)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "nicht anwendbar",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Es ist sicherzustellen, dass Vorgaben im МСМ enthalten sind; das MCM ist zu genehmigen und eine Kopie des МСМ der österreichischen Zivilluftfahrtbehörde zu übermitteln.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Annex 6, Teil 1, Kap. 8, Ziffer 8.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Instandhaltungsprogramm",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bewilligung des Instandhaltungsprogramms",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Es ist sicherzustellen, dass die Aufgaben und Verantwortlichkeiten ordnungsgemäß im MCM geregelt sind.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Annex 6, Teil 1, Ziffer 8.4.1 und 8.4.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Instandhaltungsdokumentation",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Prüfung der Instandhaltungsdokumentation in Verbindung mit der Verlängerung von Lufttüchtigkeitszeugnissen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die Einhaltung der Erfordernisse für das Luftverkehrsbetreiberzeugnis (AOC) ist sicherzustellen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Annex 6, Teil 1 Ziffern 8.5.1 & 8.5.2",
                "rowspan": 1,
                "colspan": 1
              },

      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "4. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsorganisation, Arbeitsplanung und Arbeitsgestaltung",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Maschinen, Geräte und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von technischen Unterlagen wie von Skizzen, Zeichnungen, Plänen, Diagrammen, Fließschemata usw.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werkstoffe und Hilfsstoffe, ihrer Eigenschaften, Verwendungsmöglichkeiten und Verarbeitungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Manuelles und maschinelles Bearbeiten von Metallen und Kunststoffen wie zB Messen, Anreißen, Bohren",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erkennen und Beheben von Störungen an Maschinen und Anlagen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Wartens und Instandhaltens sowie Mitarbeiten beim Warten, Pflegen und einfachem Instandhalten der betriebsspezifischen Maschinen und Anlagen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Warten, Pflegen und einfaches Instandhalten der betriebsspezifischen Maschinen und Anlagen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus und der Funktion von Maschinenelementen sowie über deren Montage und Demontage",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen einfacher Montage- und Demontagearbeiten an betriebsspezifischen Maschinen und Anlagen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der papierspezifischen Roh- und Halbstoffe und der chemischen Additive, ihrer Eigenschaften, Verwendungsmöglichkeiten und Verarbeitungsmöglichkeiten, Einsatzgebiete sowie Umgang mit Sicherheitsdatenblättern",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Papierarten, ihrer Eigenschaften, der Erkennungsmöglichkeiten sowie des Erkennens und Behebens von Papierfehlern",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erkennen der Papierarten, ihrer Eigenschaften sowie Erkennen und Beheben von Papierfehlern",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der allgemeinen und der analytischen Chemie sowie der Physik",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen von einfachen berufsspezifischen chemischen und physikalischen Untersuchungsmethoden an Stoff- und Papierproben (wie Mahlgrad (Schopper-Riegler), flächenbezogene Masse, Reißlänge, Fasermikroskopie, Stoffdichte) mit Mess- und Arbeitsgeräten sowie Protokollieren der Messergebnisse",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen von weiterführenden berufsspezifischen chemischen und physikalischen Untersuchungsmethoden an Stoff- und Papierproben mit Mess- und Arbeitsgeräten sowie Protokollieren der Messergebnisse",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der betrieblichen Energiegewinnung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Handhabung der unterschiedlichen betrieblichen Energieformen sowie Mitarbeit beim Handhaben der betrieblichen Energieträger unter Beachtung der Sicherheitsvorschriften",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Handhaben der betrieblichen Energieträger unter Beachtung der Sicherheitsvorschriften",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Mitarbeit beim Auswählen und Überprüfen der Roh- und Halbstoffe, der chemischen Additive und sonstiger erforderlicher Materialien (zB Farbstoffe, Füllstoffe) sowie beim Herstellen der Rezepturen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Auswählen und Überprüfen der Roh- und Halbstoffe, der chemischen Additive und sonstiger erforderlicher Materialien (zB Farbstoffe, Füllstoffe) sowie Herstellen der Rezepturen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Halbstofferzeugung, der Arbeitsschritte sowie des Aufbaus und der Funktion der dazu benötigten Maschinen und Anlagen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten bei der Halbstofferzeugung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Stoffaufbereitungs-Verfahren, der Arbeitsschritte (zB Füllstoffaufbereiten, Chargen zusammenstellen) sowie des Aufbaus und der Funktion der dazu benötigten Maschinen und Anlagen (zB Zerfaserungsmaschinen)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Anfahren, Bedienen, Überwachen und Ab- bzw. Umstellen der Maschinen und Anlagen zur Stoffaufbereitung (zB Zerfaserungsmaschinen)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Anfahren, Bedienen, Überwachen und Ab- bzw. Umstellen der Maschinen und Anlagen zur Stoffaufbereitung (zB Zerfaserungs-maschinen)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Papierherstellungs-Verfahren, der Arbeitsschritte (zB Stoff- und Wasserführung einstellen, Querprofil und Blattbildung einstellen, Nasspressen überwachen, Papierbahn aufführen, Zylindertemperatur einstellen, Glätte einstellen, Tambour- oder Rollenwechsel durchführen) sowie des Aufbaus und der Funktion der dazu benötigten Maschinen und Anlagen (Papiermaschinen)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Rüsten (zB Bespannungswechsel), Anfahren, Bedienen, Überwachen und Ab- bzw. Umstellen der Maschinen und Anlagen zur Papierherstellung (Papiermaschinen)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Rüsten (zB Bespannungswechsel), Anfahren, Bedienen, Überwachen und Ab- bzw. Umstellen der Maschinen und Anlagen zur Papierherstellung (Papier-maschinen)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Papierveredelungs- und Papierausrüstungs-Verfahren, der Arbeitsschritte (zB Papierbahn einführen, Messer einstellen, Anfertigen von Klebestellen, Rollenkontrolle vornehmen, Formate einstellen) sowie des Aufbaus und der Funktion der dazu benötigten Maschinen und Anlagen (zB Streichmaschinen, Vorroller, Rollenschneidmaschinen, Querschneider, Planschneider)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Anfahren, Bedienen, Überwachen und Ab- bzw. Umstellen der Maschinen und Anlagen zur Papierveredelung und -ausrüstung (zB Streichmaschinen, Vorroller, Rollenschneidmaschinen, Querschneider, Planschneider)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Anfahren, Bedienen, Überwachen und Ab- bzw. Umstellen der Maschinen und Anlagen zur Papierveredelung und -ausrüstung (zB Streichmaschinen, Vorroller, Rollenschneidmaschinen, Querschneider, Planschneider)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Elektrotechnik, Mess-, Steuer- und Regeltechnik, der Hydraulik, Pneumatik und Elektropneumatik sowie der Prozessleittechnik",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bedienen und Überwachen von hydraulischen, pneumatischen und elektropneumatischen Steuer- und Regeleinrichtungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechnergestütztes Prozessüberwachen und Durchführen von Prozesskontrollen und Prozessoptimierungen sowie Erfassen von Betriebsdaten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Dokumentieren der produktionsrelevanten Daten (zB Störungsaufzeichnungen) sowie deren Überprüfung auf Vollständigkeit und Richtigkeit",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Maßnahmen des Qualitätsmanagements",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitarbeiten beim Qualitätsmanagement",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Mitarbeit bei der betriebsspezifischen Abluft- und Abwasserreinigung sowie der Abfallbehandlung",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Verwendung von persönlichen Schutzausrüstungen in den Produktionsanlagen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des betrieblichen Brand- und Explosionsschutzes sowie der vorbeugenden Brand- und Explosionsschutzmaßnahmen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der einschlägigen englischen Fachausdrücke",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der betrieblichen EDV (Hard- und Software)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 BAG)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufsrelevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften und Normen sowie der einschlägigen Vorschriften zum Schutz des Lebens und der Gesundheit, insbesondere der berufsspezifischen Arbeitshygiene- und Sicherheitsvorschriften und den Umgang mit elektrischen Strom",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Erstversorgung bei betriebsspezifischen Arbeitsunfällen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 4
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

              },
              {
                "text": "MONITOR",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen bzw. Verdichten eines Lagebildes hinsichtlich des Zielobjektes durch Beobachtung oder den Einsatz von Sensoren und Melden des Verhaltens des Zielobjektes.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "SHADOW",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Unerkanntes Verfolgen des Zielobjektes nach Sicht oder im",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Radar Trail“. Melden des Verhaltens des Zielobjektes und, wenn möglich, weiterer Details zum Zielobjekt (z. B. Type) an die Kontrollstelle. SHADOW kann visuell oder mit speziellem Gerät durchgeführt werden.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": true
        },
        {
          "cells": [
            [
              {
                "text": "Auftrag (TASK)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Beschreibung",
                "rowspan": 2,
                "colspan": 1
              }
            ],
            [
              {
                "text": "AUT",

                "colspan": 1
              },
              {
                "text": "CHE",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "VISUAL IDENTIFICATION (VID)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "VISUAL IDENTIFICATION (VID)",
                "rowspan": 2,
                "colspan": 1
              },
              {
                "text": "Visuelles Identifizieren des Zielobjektes und Melden an die Kontrollstelle unter Anwendung des TEFCRES-Formates gemäß Ziffer 4.1.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "ESTABLISH VISUAL CONTACT",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Das für das Abfangen und die Identifizierung zuständige Lfz begibt sich in eine Position vor der 3/9-Uhr-Linie des Zielobjektes, um Sichtkontakt mit dem abgefangenen Piloten herzustellen. (Im CHE Verfahren ist dies bereits im VID-Verfahren gewährleistet.)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "PHOTO EVIDENCE",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Dokumentation des Zielobjektes mittels bildgebender Methode.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "ESTABLISH RADIO CONTACT",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "RADIO INTERROGATION",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Versuch der Kontaktaufnahme mit dem Zielobjekt über Funk unter Anwendung des Schemas gemäß Ziffer 4.2.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": true
        },

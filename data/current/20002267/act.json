      "tables": [
        {
          "cells": [
            [
              {
                "text": "1. Bestandssituation wild lebender Pflanzen- und Tierarten und ihrer Biotope",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "1.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Stand der Erfassung wild lebender Pflanzenarten und Pflanzen- bzw. Vegetationsgesellschaften",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.1.0.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Allgemeines",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.1.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rote Listen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.1.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Listen rechtlich geschützter Arten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.1.3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verbreitungsatlanten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Stand der Erfassung wild lebender Tierarten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.2.0.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Allgemeines",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.2.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rote Listen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.2.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Listen rechtlich geschützter Arten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.2.3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verbreitungsatlanten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Stand der Erfassung von Biotopen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.3.0.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Allgemeines",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.3.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rote Listen von Biotoptypen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.3.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verzeichnisse ökologisch wertvoller Biotope einschließlich Gewässer",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Stand der Erfassung von Landschaften",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.4.0.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Allgemeines",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.4.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Inventare, Verzeichnisse, Typisierungen schützenswerter Natur- und Kulturlandschaften",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.4.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Planungen und sonstige Schutzmassnahmen für besondere Landschaften und Landschaftstypen beziehungsweise Einzelelemente der Natur- und Kulturlandschaft",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.4.3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Sanierungsbedürftige Bereiche",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Nutzung wild lebender Tier- und Pflanzenarten und/oder von Biotopen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.5.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Land- und Almwirtschaft zB Probleme/Gefahren der Nutzungsintensivierung und Brachlegung; Verluste und Gewinne",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.5.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Forstwirtschaft",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.5.3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Jagd",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.5.4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fischerei",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2. Geschützte Flächen (Fläche, Anteile am Gesamtraum, Schutzzweck, Schutzinhalte, Nutzungen, Nutzungsverteilung, Eigentumsverhältnisse)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "2.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Nationalparke",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Naturschutzgebiete",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Landschaftsschutzgebiete",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Naturparke",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Schon- und Ruhegebiete",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Geschützte Landschaftsbestandteile",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Geschützte Biotope",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Andere geschützte Flächen (zB privatrechtlich geschützte Gebiete, freiwillige Vereinbarungen, Privatverträge zur Extensivierung)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3. Organisation des Naturschutzes und der Landschaftspflege (Aufbau, Zuständigkeiten/Tätigkeiten, personelle und finanzielle Ausstattung)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "3.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Naturschutzbehörden",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Andere Fachverwaltungen mit Naturschutzaufgaben. Sonstige Einrichtungen des öffentlichen und privaten Rechts (zB Körperschaften, Stiftungen)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Naturschutzbeiräte",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Naturschutzwachten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Naturschutzverbände",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Landschaftspflegeverbände",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Sonstiges",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4. Rechtsgrundlagen (auf den jeweils zuständigen Ebenen)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verfassungsrecht",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechtsquellen (Gesetze, Verordnungen, Richtlinien – einschließlich Darstellung spezieller Inhalte zum Alpenschutz)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verbandsbeteiligung, Verbandsklage",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vollzugshinweise",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zusammenarbeit der Naturschutzbehörden mit anderen Fachverwaltungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bußgeldkataloge usw.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Landschaftspflege- und Naturschutzfonds",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Laufende und geplante Novellierungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5. Naturschutzaktivitäten (Gesamtüberblick)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "5.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Konzepte, Programme, Richtlinien zur Erhaltung der Natur im Alpenraum",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Planungen (zB Landschaftspläne, Pflege- und Entwicklungspläne)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Artenhilfsmaßnahmen und sonstige Pflege-, Sicherungs- und Gestaltungsmaßnahmen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.3.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Allgemeines",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.3.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Artenhilfsprogramme",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.3.3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Aufzucht- und Auswilderungsstationen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Strategien, Konzepte, Programme, Zusammenarbeit mit Nutzungsverantwortlichen (-gremien) (zB Extensivierungs-, Bergbauernprogramme)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Wissenschaftliche Begleitung, Dauerbeobachtung von Flächen/Arten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Eigenaktivitäten der Naturschutzverbände zum Arten- und Flächenschutz",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Finanzierungsprogramme (Mittelumfang, Ziele, Anwendungsbereiche)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6. Öffentlichkeitsarbeit (staatlich/ehrenamtlich)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "6.0.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Allgemeines",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Naturschutzakademien",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Informationszentren",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Publikationen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Sonstiges",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "7. Schlussfolgerungen, empfohlene Maßnahmen",
                "rowspan": 1,
                "colspan": 2
              }
            ]
          ],
          "merged_cells": true
        }
      ]

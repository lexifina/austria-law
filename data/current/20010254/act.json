      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "4. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachübergreifende Ausbildung (Schlüsselqualifikationen) In der Art der Vermittlung der fachlichen Kenntnisse und Fertigkeiten ist auf die Förderung folgender fachübergreifender Kompetenzen des Lehrlings Bedacht zu nehmen:",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Methodenkompetenz, zB Lösungsstrategien entwickeln, Informationen selbstständig beschaffen, auswählen und strukturieren, Entscheidungen treffen etc.",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Soziale Kompetenz, zB in Teams arbeiten etc.",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Personale Kompetenz, zB Selbstvertrauen und Selbstbewusstsein, Bereitschaft zur Weiterbildung, Bedürfnisse und Interessen artikulieren etc.",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kommunikative Kompetenz, zB mit Kunden/innen, Vorgesetzten, Kollegen/innen und anderen Personengruppen zielgruppengerecht kommunizieren; Englisch auf branchen- und betriebsüblichem Niveau zum Bestreiten von Alltags- und Fachgesprächen beherrschen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeitsgrundsätze, zB Sorgfalt, Zuverlässigkeit, Verantwortungsbewusstsein, Pünktlichkeit etc.",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "4.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundenorientierung: Im Zentrum aller Tätigkeiten im Betrieb hat die Orientierung an den Bedürfnissen der Kunden/innen unter Berücksichtigung der Sicherheit zu stehen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeits-planung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Produktionsmanagements (zB Produktionsplanung, Mengenplanung, Termin- und Kapazitätsplanung, Betriebsdatenerfassung)",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Kenntnis des Produktionsmanagements (zB Produktionsplanung, Mengenplanung, Termin- und Kapazitätsplanung, Betriebsdatenerfassung)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen und Anwenden von technischen Unterlagen (zB von Skizzen, Zeichnungen, Arbeitsanweisungen, Ablaufplänen, Bedienungsanleitungen, Wartungsplänen, Instandhaltungsplänen, Grundfließschemen, Verfahrensfließschemen, Rohrleitungs- und Instrumentenfließschemen, Symbole in Fließschemata)",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der betriebsspezifischen Vorschriften zur Arbeits- und Betriebshygiene und des richtigen Verhaltens in Bezug auf Kreuzkontamination",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden der persönlichen Schutzausrüstungen PSA (zB Hautschutz, Atemschutz) sowie aller anderen erforderlichen Sicherheitsmaßnahmen im Umgang mit Roh-, Zusatz- und Hilfsstoffen, Arbeitsmitteln, Werkzeugen, Apparaten, Maschinen und chemischen Anlagen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der berufsspezifischen allgemeinen, anorganischen, organischen und analytischen Chemie sowie Physik",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Logistik (An- und Auslieferungslogistik)",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Optimieren und Sicherstellen des Stoffflusses in der Produktion",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der betriebsspezifischen Roh-, Zusatz- und Hilfsstoffe für die Produktion, der betriebsspezifischen chemisch-technologischen Produkte, ihrer Eigenschaften, Verwendungs-, Verarbeitungs- und Lagermöglichkeiten sowie des Umgangs mit Sicherheitsdatenblättern",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus, der Funktion und der Bedienung von betriebsspezifischen Lagereinrichtungen für feste, flüssige und gasförmige Stoffe sowie des produktgerechten Abpackens bzw. Verpackens sowie Lagerns der Produkte",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der Energieträger (zB Brennstoffe, Strom, Wasserdampf, Kühlmittel) sowie der Möglichkeiten der Wärmeübertragung",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus, der Funktion und der Bedienung von Wärmetauschern und Kondensatabscheidern",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Erzeugung von Unterdruck (Vakuum) und Überdruck sowie des Aufbaus, der Funktion und der Bedienung von Maschinen zur Erzeugung von Unterdruck und Überdruck",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus und der Funktion von Rohrleitungen und Armaturen sowie über deren Normung und Kennzeichnung",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Grundkenntnisse der strömungstechnischen Vorgänge in Rohrleitungen und Armaturen (zB Strömungsarten, Druckänderungen usw.)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus, der Funktion und der Bedienung von Fördereinrichtungen für feste, flüssige und gasförmige Stoffe",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Prinzipien der Stoffaufbereitung (zB Zerkleinern, Verteilen, Mischen, Kneten, Lösen, Formgebungsverfahren usw.) sowie des Aufbaus, der Funktion und Bedienung von Apparaten zur Stoffaufbereitung",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Prinzipien der mechanischen Trennverfahren (zB Sedimentieren, Filtrieren, Zentrifugieren, Klassieren) sowie des Aufbaus, der Funktion und Bedienung von Apparaten zur Trennung von fest/fest, fest/flüssig und flüssig/flüssig Gemischen",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Prinzipien der thermischen Trennverfahren (zB Trocknen, Verdampfen, Eindampfen, Destillieren, Rektifizieren, Kristallisieren) sowie über den Aufbau, die Funktion und Bedienung von Apparaten zur thermischen Trennung",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Bedienen der betriebsspezifischen Fördereinrichtungen sowie Apparaten zur Stoffaufbereitung und mechanischen und thermischen Trennung",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Bedienen der betriebsspezifischen Fördereinrichtungen sowie Apparate zur Stoffaufbereitung und mechanischen und thermischen Trennung",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Prinzipien der physikalisch-chemischen Trennverfahren (zB Extrahieren, Ionenaustausch, Membrantechnologie) sowie des Aufbaus, der Funktion und Bedienung von Apparaten zur physikalisch-chemischen Trennung",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Prinzipien der Entstaubung (zB mechanische Entstaubung, Elektroentstaubung) und Gasreinigung (zB Absorption, Adsorption, katalytische Gasreinigung) sowie des Aufbaus, der Funktion und Bedienung von Apparaten zur Entstaubung und Gasreinigung",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Bedienen der betriebsspezifischen Apparate zur physikalisch-chemischen Trennung sowie zur Entstaubung und Gasreinigung",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Bedienen der betriebsspezifischen Apparate zur physikalisch-chemischen Trennung sowie zur Entstaubung und Gasreinigung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Prinzipien zur Reinigung von Abwasser und Abluft, des Aufbaus, der Funktion und Bedienung von Apparaten und Anlagen zur Abwasser- und Abluftreinigung sowie der Möglichkeiten zur Beseitigung von Chemieabfällen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Zusammenwirkens und der Vernetzung der Apparate und Maschinen sowie der Arbeitsabläufe und Prozesse (zB Stofffluss, Stoffumsetzung, Energieeinsatz, Abfall usw.) in den betriebsspezifischen Produktionsanlagen zur Erzeugung der Produkte",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der betriebsspezifischen Applikationen (zB zum Führen des Schichtprotokolls, für Dateneingaben, Störungsaufzeichnungen usw.)",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse über Netze und Netzwerktechnik sowie über die Datenübertragung und Datenspeicherung",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Grundkenntnisse der Möglichkeiten der intelligenten und digitalen Vernetzung (mittels Informations- und Kommunikationstechnik) von Apparaten, Maschinen und Betriebsmittel entlang der gesamten Wertschöpfungskette für eine weitestgehend selbstorganisierte Produktion",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Vorbereiten (zB Reinigen, Pflegen) der betriebsspezifischen Apparate, Maschinen und Produktionsanlagen nach Freigabe der Apparate, Maschinen und Produktionsanlagen (zB Reaktoren, Autoklaven) gemäß Sicherheitsvorschriften (Freischalten, Sichern usw.) durch befugte Personen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Vorbereiten (zB Reinigen, Pflegen) der betriebsspezifischen Apparate, Maschinen und Produktionsanlagen nach Freigabe der Apparate, Maschinen und Produktionsanlagen (zB Reaktoren, Autoklaven) gemäß Sicherheitsvorschriften (Freischalten, Sichern usw.) durch befugte Personen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Rüsten, Umrüsten, Beschicken sowie An- und Ausfahren der betriebsspezifischen Apparate, Maschinen und Produktionsanlagen (zB Reaktoren, Autoklaven)",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Rüsten, Umrüsten, Beschicken sowie An- und Ausfahren der betriebsspezifischen Apparate, Maschinen und Produktionsanlagen (zB Reaktoren, Autoklaven)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Bedienen und Überwachen (auch durch Kontrollgänge) der Arbeitsabläufe der betriebsspezifischen Produktionsanlagen (zB Reaktoren, Autoklaven)",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Bedienen und Überwachen (auch durch Kontrollgänge) der Arbeitsabläufe der betriebsspezifischen Produktionsanlagen (zB Reaktoren, Autoklaven), Erkennen und Beseitigen von einfachen Ablaufstörungen im Produktionsprozess sowie frühzeitiges Erkennen von Störungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Steuer- und Regelungstechnik sowie Pneumatik sowie der Funktion der dazu notwendigen Geräte in Bezug auf die Automatisierung von Anlagen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Prinzipien der Messung von Zustandsgrößen in Chemieanlagen (zB Temperatur, Druck, Durchfluss, Füllstand, pH-Wert usw.), des Aufbaus, der Funktion und Einsatzbereiche der Messgeräte sowie über die Erfassung, Verarbeitung, Übertragung und Anzeige der Messwerte",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Aufbaus, der grundlegenden Funktion und Komponenten sowie Kenntnis der Bedienung eines Prozessleitsystems (wie Bildschirmdarstellungen, Bedienmöglichkeiten, Datenmanagement, Eingriffsmöglichkeiten usw.)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Bedienen des betriebsspezifischen Prozessleitsystems zur Regelung und Überwachung des Produktionsprozesses sowie zum Sicherstellen der Produktqualität",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Bedienen des betriebsspezifischen Prozessleitsystems zur Regelung und Überwachung des Produktionsprozesses sowie zum Sicherstellen der Produktqualität",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Protokollieren von Betriebsdaten und Prozessaufzeichnungen sowie Überprüfen auf Vollständigkeit und Richtigkeit",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Mitarbeiten beim Auswerten (zB mittels statistischer Methoden) und Beurteilen von Betriebsdaten und Prozessaufzeichnungen sowie beim Einleiten von Korrekturmaßnahmen im Anlassfall und Erkennen von möglichen Prozessoptimierungen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse und Anwendung des betriebsspezifischen Qualitätsmanagements einschließlich Dokumentation",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der im Lehrbetrieb eingesetzten Methoden zur kontinuierlichen Verbesserung (zB der Qualität, Effizienz, Anlagensicherheit, Prozesse, Ergonomie, Rüstzeiten, Verfügbarkeit der Produktionsanlagen, Abfallminimierung, Ressourceneffizienz, des Stoffflusses und der Nachhaltigkeit)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis von Scale-up-Prozessen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Probenahme (inklusive Probenvorbereitung und Probenaufbereitung) von festen, flüssigen und gasförmigen Stoffen sowie der Probenlagerung",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Probenehmen (inklusive Probenvorbereitung und Probenaufbereitung) und beim Probenlagern",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Probenehmen (inklusive Probenvorbereitung und Probenaufbereitung) und Probenlagern",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der grundlegenden labormäßigen Methoden zur Bestimmung von Masse, Dichte, pH-Wert, Viskosität, Leitfähigkeit, Gehaltsgrößen usw.",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "46.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Durchführen grundlegender labormäßiger Methoden zur Bestimmung von Masse, Dichte, pH-Wert, Viskosität, Leitfähigkeit, Gehaltsgrößen usw.",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Durchführen grundlegender labormäßiger Methoden zur Bestimmung von Masse, Dichte, pH-Wert, Viskosität, Leitfähigkeit, Gehaltsgrößen usw.",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "47.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werkstoffe (wie Metalle und Kunststoffe) und Hilfsstoffe von Chemieanlagen, ihrer chemisch-technologischen Eigenschaften, Verwendungs- und Bearbeitungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "48.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einfaches Instandhalten der zu verwendenden Werkzeuge, Maschinen, Apparate und Produktionsanlagen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "49.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Berufsspezifisches Bearbeiten von Werkstoffen sowie Herstellen von lösbaren Verbindungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen einfacher Montage- und Demontagearbeiten an betriebsspezifischen Apparaten, Maschinen, und Produktionsanlagen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "50.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten (zB Energiekosten, Einsatzstoffkosten) deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Kenntnis der betrieblichen Kosten (zB Energiekosten, Einsatzstoffkosten) deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "51.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "52.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutz der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Wiederverwendung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "53.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des betrieblichen Brand- und Explosionsschutzes sowie der vorbeugenden Brand- und Explosionsschutzmaßnahmen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "54.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften und Normen sowie der einschlägigen Vorschriften zum Schutz des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "55.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erste-Hilfe-Ausbildung",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "56.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 BAG)",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "57.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der arbeitsrechtlichen Gesetze, insbesondere des KJBG (samt KJBG-VO), des ASchG und des GlBG",
                "rowspan": 1,
                "colspan": 5
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

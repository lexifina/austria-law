          "cells": [
            [
              {
                "text": "1. Für die Bildungsberatung an höheren Schulen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "a) bei einer Schülerinnen- und Schülerzahl von 60 bis einschließlich 100",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "50 vH,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "b) bei einer Schülerinnen- und Schülerzahl von 101 bis einschließlich 475",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "100 vH,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "c) bei einer Schülerinnen- und Schülerzahl von 476 bis einschließlich 1 000",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "200 vH,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "d) bei einer Schülerinnen- und Schülerzahl von 1 001 bis einschließlich 1 600",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "300 vH,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "e) bei einer Schülerinnen- und Schülerzahl von 1 601 bis einschließlich 2 300",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "400 vH,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "f) bei einer Schülerinnen- und Schülerzahl von 2 301 bis einschließlich 3 000",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "500 vH,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "g) bei einer Schülerinnen- und Schülerzahl von mehr als 3 000",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "600 vH;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2. für die Bildungsberatung an selbstständig geführten mittleren Schulen:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "a) bei einer Schülerinnen- und Schülerzahl von 60 bis einschließlich 110",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "50 vH,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "sofern es sich um vollorganisierte mittlere Schulen handelt, auch bei einer Schülerinnen- und Schülerzahl unter 60,",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "b) bei einer Schülerinnen- und Schülerzahl von 111 bis einschließlich 575",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "100 vH,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "c) bei einer Schülerinnen- und Schülerzahl von mehr als 575",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "200 vH.",

      "tables": [
        {
          "cells": [
            [
              {
                "text": "1. Leitung der Betriebsküchen, in denen lehrplanmäßig Betriebsküchenunterricht erteilt wird, je Schule:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2,431 Wochenstunden bis drei Klassen, in denen lehrplanmäßig Betriebsküchenunterricht erteilt wird,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "4,862 Wochenstunden ab vier Klassen, in denen lehrplanmäßig Betriebsküchenunterricht erteilt wird und dieser Unterricht in der Betriebsküche sechs Halbtage je Woche nicht überschreitet,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "7,293 Wochenstunden ab vier Klassen, in denen lehrplanmäßig Betriebsküchenunterricht erteilt wird und dieser Unterricht in der Betriebsküche sechs Halbtage je Woche überschreitet.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2. Praktikumsbetreuung an Fachschulen für Sozialberufe, bei der die Vertragslehrperson in jeder Woche der Praxis Schülerinnen und Schüler auswärts betreut:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "0,275 Wochenstunden je Schülerin oder Schüler.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },

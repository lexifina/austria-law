      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "1. für Lehr- bzw. Unterrichtsveranstaltungen, für die eine L PH-Verwendungsgruppe vorgesehen ist",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "41,1 €",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2. für fachwissenschaftliche und fachdidaktische Lehr- bzw. Unterrichtsveranstaltungen, soweit sie nicht unter Z 1 fallen, für Lehr- bzw. Unterrichtsveranstaltungen der Schulpraxis sowie für didaktische Lehrveranstaltungen im Rahmen der Lehrgänge für Unterrichtspraktikanten an Pädagogischen Hochschulen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "29,4 €",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3. für die Lehrtätigkeit bzw. den Unterricht in einer praktischen Lehr- bzw. Unterrichtsveranstaltung oder in einer Fertigkeit",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "20,2 €.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "für den ersten bis dritten Halbtag je",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "21,8 €",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "für den vierten bis sechsten Halbtag je",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "16,7 €",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "für den siebenten und die folgenden Halbtage je",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "14,5 €.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "für eine Praxisstunde mit einem Schüler",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1,5 €",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "für eine Praxisstunde mit zwei Schülern",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2,2 €",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "und für eine Praxisstunde mit drei oder mehr Schülern",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2,9 €.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },

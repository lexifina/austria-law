      "tables": [
        {
          "cells": [
            [
              {
                "text": "1. Erythrozytenzubereitungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die unter 1.1 bis 1.8 aufgeführten Blutbestandteile können in Blutspendeeinrichtungen weiterverarbeitet werden und sind entsprechend zu kennzeichnen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erythrozyten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erythrozyten, buffy-coat-frei",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erythrozyten, leukozytendepletiert",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erythrozyten, in Additivlösung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erythrozyten, buffy-coat-frei, in Additivlösung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erythrozyten, leukozytendepletiert, in Additivlösung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.7",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Apherese-Erythrozyten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.8",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vollblut",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2. Thrombozytenzubereitungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die unter 2.1 bis 2.6 aufgeführten Bestandteile können in Blutspendeeinrichtungen weiterverarbeitet werden und sind entsprechend zu kennzeichnen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Apherese-Thrombozyten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Apherese-Thrombozyten, leukozytendepletiert",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Pool-Thrombozyten, rückgewonnen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Pool-Thrombozyten, rückgewonnen, leukozytendepletiert",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Thrombozyten, rückgewonnen, Einzelspende",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Thrombozyten, rückgewonnen, Einzelspende, leukozytendepletiert",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3. Plasmazubereitungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die unter 3.1 bis 3.3 aufgeführten Bestandteile können in Blutspendeeinrichtungen weiterverarbeitet werden und sind entsprechend zu kennzeichnen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gefrorenes Frischplasma",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gefrorenes Frischplasma, kryopräzipitatarm",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kryopräzipitat",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Apherese-Granulozyten",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "Bestandteil",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Qualitätsmessungen erforderlich Die erforderliche Probenahmehäufigkeit für alle Messungen ist anhand der statistischen Prozessüberwachung zu bestimmen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Annehmbare Ergebnisse bei der Qualitätsmessung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Erythrozyten",
                "rowspan": 3,
                "colspan": 1
              },
              {
                "text": "Volumen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Entsprechend den Lagermerkmalen, um das Produkt innerhalb der Spezifikationen für Hämoglobin und Hämolyse zu halten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Hämoglobin (*)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mindestens 45 g je Einheit",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Hämolyse",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Weniger als 0,8 % der Erythrozytenmasse am Ende der Haltbarkeit",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Erythrozyten, buffy-coatfrei",
                "rowspan": 3,
                "colspan": 1
              },
              {
                "text": "Volumen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Entsprechend den Lagermerkmalen, um das Produkt innerhalb der Spezifikationen für Hämoglobin und Hämolyse zu halten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Hämoglobin (*)",
                "rowspan": 1,
                "colspan": 1
              },

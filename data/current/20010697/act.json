      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fachübergreifende Ausbildung (Schlüsselqualifikationen) In der Art der Vermittlung der fachlichen Kenntnisse und Fertigkeiten ist auf die Förderung folgender fachübergreifender Kompetenzen des Lehrlings Bedacht zu nehmen:",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Methodenkompetenz, zB Lösungsstrategien entwickeln, Informationen selbstständig beschaffen, auswählen und strukturieren, Entscheidungen treffen etc.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Soziale Kompetenz, zB in Teams arbeiten, Mitarbeiter/innen führen etc.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.3",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Personale Kompetenz, zB Selbstvertrauen und Selbstbewusstsein, Bereitschaft zur Weiterbildung, Bedürfnisse und Interessen artikulieren etc.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.4",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kommunikative Kompetenz, zB mit Kunden/innen, Vorgesetzten, Kollegen/innen und anderen Personengruppen zielgruppengerecht kommunizieren; Englisch auf branchen- und betriebsüblichem Niveau zum Bestreiten von Alltags- und Fachgesprächen beherrschen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.5",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Arbeitsgrundsätze, zB Sorgfalt, Zuverlässigkeit, Verantwortungsbewusstsein, Pünktlichkeit etc.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.6",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundenorientierung: Im Zentrum aller Tätigkeiten im Betrieb hat die Orientierung an den Bedürfnissen der Kunden/innen unter Berücksichtigung der Sicherheit zu stehen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsplanung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der branchenspezifischen Rechtsvorschriften",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der branchen-spezifischen Rechts-vorschriften insbesondere Verbraucherinformations-verordnung (LMIV)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Vorschriften zur Personal- und Betriebshygiene (Hygieneverordnung) und der Wichtigkeit von Hygienemaßnahmen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden der betriebsspezifischen Maßnahmen zur Personal- und Betriebshygiene (Hygieneverordnung) unter Beachtung der vorgeschriebenen Anwendungsrichtlinien und Schutzmaßnahmen im Umgang mit Reinigungs- und Desinfektionsmitteln",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Geräte, Maschinen, Vorrichtungen, Einrichtungen und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus und der Funktion der in der Bäckerei eingesetzten Geräte, Apparate und Maschinen wie zB Waagen, Knetmaschinen, Rührmaschinen, Schleifmaschinen, Backöfen, Backgeräte, Dampfkammern, Gärschrankanlagen, Semmel- und Brotanlagen, Kühl- und Tiefkühlanlagen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Reinigen, Pflegen und Vorbereiten der in der Bäckerei eingesetzten Geräte, Apparate und Maschinen wie zB Waagen, Knetmaschinen, Rührmaschinen, Schleifmaschinen, Backöfen, Backgeräte, Dampfkammern, Gärschrankanlagen, Semmel- und Brotanlagen, Kühl- und Tiefkühlanlagen sowie Erkennen und Beseitigen von einfachen Ablaufstörungen im Produktionsprozess",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Roh-, Hilfsstoffe und Halbfabrikate (wie zB Mahlprodukte, Milch- und Milchprodukte, Fettstoffe, Eier, Honig, Zucker, Früchte, Gewürze, Aromen, Gelier- und Verdickungsmittel, Lockerungsmittel, Hefe, Salz, Backmittel), ihrer Eigenschaften, Lagerungs- (Temperatur, Feuchtigkeit, Licht) und Verwendungsmöglichkeiten sowie der Verpackungsmaterialien und Betriebsmittel",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betriebsspezifischen Beschaffungsmöglichkeiten und der Ermittlung des Bedarfs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der betriebs-spezifischen Beschaffungs-möglichkeiten und der organisatorischen Durchführung der Beschaffung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Ermitteln des Bedarfs an Roh- und Hilfsstoffen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vorbereiten von und Mitarbeiten bei Bestellungen von Roh- und Hilfsstoffen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen von Bestellungen von Roh- und Hilfsstoffen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Auswählen, Annehmen und Prüfen auf Verwendbarkeit und Lagerung der Roh- und Hilfsstoffe",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Auswählen, Annehmen und Prüfen auf Verwendbarkeit und Lagerung der Roh- und Hilfsstoffe",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Rezepturen und Backzeiten für Brot, Gebäck und Feinbackwaren (Feingebäck)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der berufsspezifischen Mathematik wie zB Rezepturberechnungen, Mischungsanteile",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Abmessen und Abwägen sowie Vorbehandeln von Roh- und Hilfsstoffen (wie zB Mahlprodukte, Milch- und Milchprodukte, Fettstoffe, Eier, Honig, Zucker, Früchte, Gewürze, Aromen, Gelier- und Verdickungsmittel, Lockerungsmittel, Hefe, Salz, Backmittel) und Halbfabrikaten gemäß Rezepturen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Händisches und maschinelles Zubereiten (mittels Knetmaschinen, Rührmaschinen) von Teigen für Gebäck, Brot, Feinbackwaren (Feingebäck) sowie von Massen (insbesondere Biskuit- und Sandmassen)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Triebführungsarten, Gärverzögerung, Gärunterbrechung, Teiglockerungsarten (Sauerteig, Hefe), Teigruhe (Ruhezeit, Luftfeuchtigkeit, Temperatur)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Steuern und Überwachen des Gärvorganges (zB mittels Gärschrankanlagen), der Teiglockerung und der Teigruhe",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Aufbereiten (zB Pressen, Schleifen mit Schleifmaschine, Zusammenziehen, Brotwirken) von Teigen für die maschinelle Formung und für die Handformung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Herstellung und des Einsatzes von Vorteigen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen und Einsetzen von Vorteigen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Maschinelles Formen sowie Handformen von verschiedenen Gebäcksorten, Brot und Feinbackwaren (Feingebäck)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Backarten (freigeschoben, angeschoben), der Vorgänge während des Backprozesses und des Abkühlungsprozesses",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herrichten, Heizen und Beschicken von Backöfen, Backgeräten oder Dampfkammern zur Herstellung von Brot, Gebäck und Feinbackwaren (Feingebäck)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Überwachen und Steuern des Backprozesses sowie Entleeren von Backöfen, Backgeräten oder Dampfkammern",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen und Vorbereiten von Überzügen und Füllungen für Feinbackwaren (Feingebäck)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verarbeiten von Überzügen und Füllungen für Feinbackwaren (Feingebäck) durch Füllen, Bestreichen, Glasieren und Zuckern",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Herstellens von als Imbissen garnierten Erzeugnissen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Fehlermöglichkeiten und deren Erkennungsmöglichkeiten an Teigen und Backprodukten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erkennen von Fehlern an Teigen und Backprodukten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der produktgerechten Verpackung und Lagerung von Backprodukten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Produktgerechtes Verpacken sowie Lagern der Produkte",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Kühltechnik und der Frischhalteverpackungs-technik zum Frischhalten von Backprodukten",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kühlen, Tiefkühlen und Auftauen von Backprodukten und Halbfabrikaten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Rüsten, An- und Ausfahren und Bedienen der betriebsspezifischen Produktionsanlagen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Rüsten, An- und Ausfahren und Bedienen der betriebsspezifischen Produktionsanlagen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen von Gesprächen mit Vorgesetzten, Kollegen, Kunden und Lieferanten unter Beachtung der fachgerechten Ausdrucksweise",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der verkaufsgerechten Warenpräsentation",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Qualitätssicherung einschließlich der Reklamationsbearbeitung und Durchführung von betriebsspezifischen, qualitätssichernden Maßnahmen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der betriebsspezifischen Hard- und Software",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften insbesondere des Brandschutzes sowie der sonstigen in Betracht kommenden Vorschriften zum Schutze des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "46.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Erstversorgung bei betriebsspezifischen Arbeitsunfällen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "47.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "48.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Rechte und Pflichten (§§ 9 und 10 Berufsausbildungsgesetz)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "49.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der arbeitsrechtlichen Gesetze, insbesondere des KJBG (samt KJBG-VO), des ASchG und des GlBG",
                "rowspan": 1,
                "colspan": 3
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

              },
              {
                "text": "4. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kunden-kreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Fachübergreifende Ausbildung (Schlüsselqualifikationen) In der Art der Vermittlung der fachlichen Kenntnisse und Fertigkeiten ist auf die Förderung folgender fachübergreifender Kompetenzen des Lehrlings Bedacht zu nehmen:",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.1",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Methodenkompetenz, zB Lösungsstrategien entwickeln, Informationen selbstständig beschaffen, auswählen und strukturieren, Entscheidungen treffen etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.2",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Soziale Kompetenz, zB in Teams arbeiten, Mitarbeiter/innen führen etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.3",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Personale Kompetenz, zB Selbstvertrauen und Selbstbewusstsein, Bereitschaft zur Weiterbildung, Bedürfnisse und Interessen artikulieren etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.4",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kommunikative Kompetenz, zB mit Kunden/innen, Vorgesetzten, Kollegen/innen und anderen Personengruppen zielgruppengerecht kommunizieren; Englisch auf branchen- und betriebsüblichem Niveau zum Bestreiten von Alltags- und Fachgesprächen beherrschen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.5",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Arbeitsgrundsätze, zB Sorgfalt, Zuverlässigkeit, Verantwortungsbewusstsein, Pünktlichkeit etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.6",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kundenorientierung: Im Zentrum aller Tätigkeiten im Betrieb hat die Orientierung an den Bedürfnissen der Kunden/innen unter Berücksichtigung der Sicherheit zu stehen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "4.7",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Interkulturelle Kompetenz, zB Umgehen mit anderen Kulturen, Verhaltensweisen und Märkten etc.",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Arbeits-planung und Arbeits-vorbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse des Produktionsmanagements (wie zB Produktionsplanung, Mengenplanung, Termin- und Kapazitätsplanung, Fertigungssteuerung, Betriebsdatenerfassung)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis des Produktionsmanagements (wie zB Produktionsplanung, Mengenplanung, Termin- und Kapazitätsplanung, Fertigungssteuerung, Betriebsdatenerfassung)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Planen des Einsatzes der Werkzeuge, Vorrichtungen und technischen Fertigungshilfen für Fertigungs-maschinen und Fertigungsanlagen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Planen des Einsatzes der Werkzeuge, Vorrichtungen und technischen Fertigungshilfen für Fertigungs-maschinen und Fertigungsanlagen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Lesen und Anwenden von technischen Unterlagen wie zB von Skizzen, Zeichnungen, Arbeitsanweisungen, Ablaufplänen, Bedienungsanleitungen, Wartungsplänen, Instandhaltungsplänen, Schaltplänen auch unter Nutzung von mobilen Endgeräten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Erstellen von Skizzen und einfachen Zeichnungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse über CAD",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Auswählen, Annehmen, Prüfen auf Verwendbarkeit und Lagern der betriebsspezifischen Roh-, Zusatz- und Hilfsstoffe",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Auswählen, Annehmen, Prüfen auf Verwendbarkeit und Lagern der betriebsspezifischen Roh-, Zusatz- und Hilfsstoffe",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse des Aufbaus, der Funktion und der Bedienung der betriebsspezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen), des betrieblichen Produkt- und Informationsflusses und der hergestellten Produkte",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Aufbaus, der Funktion und der Bedienung der betriebsspezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen), des betrieblichen Produkt- und Informationsflusses und der hergestellten Produkte",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitarbeiten beim Vorbereiten (zB Reinigen, Pflegen usw.) der betriebsspezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vorbereiten (zB Reinigen, Pflegen usw.) der betriebsspezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitarbeiten beim Rüsten, Umrüsten, Beschicken sowie An- und Ausfahren der betriebsspezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Rüsten, Umrüsten, Beschicken sowie An- und Ausfahren der betriebsspezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Mitarbeiten beim Bedienen und Überwachen der Arbeitsabläufe von betriebsspezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen) sowie beim Erkennen und Beseitigen von einfachen Ablaufstörungen im Produktionsprozess",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Bedienen und Überwachen der Arbeitsabläufe von betriebsspezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen) sowie Erkennen und Beseitigen von einfachen Ablaufstörungen im Produktionsprozess",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Programmierens von Fertigungsmaschinen und Fertigungsanlagen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Mitarbeiten beim Programmieren von Fertigungsmaschinen und Fertigungsanlagen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Steuern des Produktionsprozesses und Durchführen von Prozesskontrollen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten beim Überwachen und Sicherstellen der Produktqualität",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Überwachen und Sicherstellen der Produktqualität",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Protokollieren, Darstellen und Bewerten von Arbeitsergebnissen auch unter Anwendung digitaler Informations- und Kommunikationstechnik",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis und Mitarbeiten beim Auswerten (zB mittels statistischer Methoden und Kennzahlen) und Beurteilen von Betriebsdaten und Prozessaufzeichnungen, beim Einleiten von Korrekturmaßnahmen im Anlassfall sowie beim Erkennen und Formulieren von möglichen Prozessoptimierungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Auswerten (zB mittels statistischer Methoden und Kennzahlen) und Beurteilen von Betriebsdaten und Prozessaufzeichnungen, Einleiten von Korrekturmaßnahmen im Anlassfall sowie Erkennen und Formulieren von möglichen Prozessoptimierungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Arbeitsbehelfe, Maschinen, Vorrichtungen und Geräte",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Werkstoffe (wie Metalle und Kunststoffe) und Hilfsstoffe, ihrer Eigenschaften, Verwendungsmöglichkeiten und Bearbeitungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Manuelles und maschinelles Bearbeiten von Metallen und Kunststoffen wie Messen, Bohren, Drehen, Fräsen, Schleifen, thermisches Verbinden, Trennen unter Verwendung von Bearbeitungsmaschinen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse der frühzeitigen Erkennung von Störungen an betriebs-spezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen) sowie der einzuleitenden Maßnahmen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der frühzeitigen Erkennung von Störungen an betriebsspezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen) sowie der einzuleitenden Maßnahmen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis des vorbeugenden Wartens (Wartungspläne) und Instandhaltens sowie Mitarbeiten beim Warten, Pflegen und einfachem Instandhalten der betriebsspezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Warten, Pflegen und einfaches Instandhalten der betriebsspezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen einfacher Montage- und Demontagearbeiten an betriebsspezifischen Produktionsanlagen (Fertigungsmaschinen, Fertigungsanlagen)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeiten bei der Störungsaufzeichnung und bei der Abarbeitung von Wartungsplänen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse der Elektrotechnik, Hydraulik und Pneumatik",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse der wichtigsten elektrischen und elektronischen Bauteile und Baugruppen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Zusammenwirkens und der Vernetzung der Apparate und Maschinen sowie der Arbeitsabläufe und Prozesse (zB Stofffluss, Stoffumsetzung, Energieeinsatz, Abfall usw.) in den betriebsspezifischen Produktionsanlagen zur Erzeugung der Produkte",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der betriebsspezifischen Applikationen (zB zum Führen des Schichtprotokolls, für Dateneingaben, Störungsaufzeichnungen usw.)",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse über Netze und Netzwerktechnik sowie über die Datenübertragung und Datenspeicherung (insbesondere Handhaben personenbezogener Produktionsdaten)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse der Möglichkeiten der intelligenten und digitalen Vernetzung (mittels Informations- und Kommunikationstechnik) von Apparaten, Maschinen und Betriebsmitteln entlang der gesamten Wertschöpfungskette für eine weitestgehend selbstorganisierte Produktion",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der elektrischen, pneumatischen und hydraulischen Antriebe",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Bedienen und Überwachen von elektrischen, pneumatischen und hydraulischen Antrieben",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Mess-, Steuer- und Regelungstechnik sowie der Funktion der dazu notwendigen Geräte in Bezug auf die Automatisierung von Anlagen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Bedienen und Überwachen von Mess-, Steuer- und Regelungseinrichtungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Möglichkeiten und Einsatzbereiche der Automatisierungstechnik in Bezug auf Assistenzsysteme wie zB Roboter, Datenbrillen, Manipulations- und Transportsysteme",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Logistik (An- und Auslieferungslogistik)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Optimieren und Sicherstellen des Materialflusses in der Produktion",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse des betriebsspezifischen Qualitätsmanagements einschließlich Dokumentation",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis und Mitarbeiten beim betriebsspezifischen Qualitätsmanagement einschließlich Dokumentation",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der im Lehrbetrieb eingesetzten Methoden zur kontinuierlichen Verbesserung (zB der Qualität, Effizienz, Anlagensicherheit, Prozesse, Ergonomie, Rüstzeiten, Verfügbarkeit der Produktionsanlagen, Abfallminimierung, Ressourceneffizienz, Stofffluss, Nachhaltigkeit, ganzheitliches Produktionssystem)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis zentraler betriebswirtschaftlicher Begriffe und Kennzahlen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis und Anwendung der betrieblichen Informations- und Kommunikationstechnik (zB ERP-Systeme, Logistiksysteme und Büroanwendungen)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Durchführen von administrativen Arbeiten mit Hilfe der betrieblichen Informations- und Kommunikationstechnik",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Einhalten der betrieblichen Compliance-Richtlinien",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und über deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis des betrieblichen Brand- und Explosionsschutzes sowie der vorbeugenden Brand- und Explosionsschutzmaßnahmen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften und Normen sowie der einschlägigen Vorschriften zum Schutz des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "46.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden der persönlichen Schutzausrüstungen (PSA, zB Augen- und Hautschutz, Gehörschutz) sowie aller anderen erforderlichen Sicherheitsmaßnahmen im Umgang mit Roh-, Zusatz- und Hilfsstoffen, Arbeitsmitteln, Werkzeugen, Fertigungsmaschinen oder Fertigungsanlagen",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "47.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Erstversorgung bei betriebsspezifischen Arbeitsunfällen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "48.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 BAG)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "49.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse der arbeitsrechtlichen Gesetze, insbesondere des KJBG (samt KJBG-VO), des ASchG und des GlBG",
                "rowspan": 1,
                "colspan": 4
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

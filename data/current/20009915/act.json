      "notes": [],
      "links": [],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "1. für Universitäten bis 1 000 Studierende",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "7 000 Euro",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2. für Universitäten über 1 000 bis 5 000 Studierende, zusätzlich zum Betrag gemäß Z 1 pro weitere angefangene 1 000 Studierende je",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2 600 Euro",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3. für Universitäten über 5 000 bis 30 000 Studierende, zusätzlich zu den Beträgen gemäß Z 1 und 2 pro weitere angefangene 1 000 Studierenden zwischen 5 000 und 30 000 Studierende je",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1 700 Euro",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4. für Universitäten über 30 000 Studierende, zusätzlich zu den Beträgen gemäß Z 1, 2 und 3 pro weitere angefangene 1 000 Studierende über 30 000 Studierende je",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "430 Euro",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],

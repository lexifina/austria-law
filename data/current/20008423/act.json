      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsplanung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen von Gesprächen mit Vorgesetzten, Kollegen/innen, Kunden/innen und Lieferanten/innen unter Beachtung der fachgerechten Ausdrucksweise",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kundengerechtes Verhalten und kundengerechte Kommunikation (zB Führen von Beratungsgesprächen, Betreuen von Kunden/innen, Behandeln von Reklamationen)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben, Warten, Pflegen und Instandhalten der zu verwendenden Werkzeuge, Maschinen, Geräte, Vorrichtungen, Einrichtungen und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der zu verwendenden Werk- und Hilfsstoffe, ihrer Erzeugung, ihrer chemischen und physikalischen Eigenschaften, Verwendungs-, und Verarbeitungsmöglichkeiten sowie über deren fachgerechte Lagerung",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Farbenlehre",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Farbenlehre (Farbenordnung, Farbcodierungs- und Farbmischsysteme)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der fachgerechten Logistik",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zubereiten der Werk- und Hilfsstoffe",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Reinigen, Schleifen, Abdecken sowie Entfernen von vorhandenen Beschichtungen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mischen und Nuancieren der Beschichtungsstoffe nach Muster",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Entfernen von vorhandenen Oxidschichten und Applizieren von Korrosionsschutzmaterialien",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Instandsetzen von Untergründen von Hand und mechanisch, wie Grundieren, Spachteln, Füllern, usw.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Aufbringen von Füllmaterial mittels Applikationsgeräten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Auftragen von Grund-materialien",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Applizieren von Grund- und Deckmaterialien in verschiedenen Techniken (wie zB durch Streichen, Spritzen, Tauchen, Fluten) auf verschiedenen Untergründen mittels verschiedener Arbeitstechniken",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausführen von Abdeckarbeiten mit Zierelementen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beschichten mit Applikationsgeräten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von manuellen Beschichtungen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausführen von Oberflächen-beschichtungsarbeiten mit Beschichtungsgeräten",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Manuelles und maschinelles Polieren",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen von Grund- und Finisharbeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erkennen von Beschichtungs-fehlern",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Prüfen und Analysieren von Fehlern bei Oberflächenstörungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beschichten von Holz, Metall, Kunststoff und anderen Werkstoffen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Instandsetzen von Oberflächen (Korrosionsschutz, Grundieren, Spachteln, Füllern, Schleifen, mit verschiedenen Applikationsverfahren)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kontrollieren und Prüfen der ausgeführten Arbeiten sowie Erkennen und Beheben von Mängeln",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Physikalische und chemische Grundkenntnisse der Werkstofftrocknung",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Aufbringen von Werkstoffen mit unterschiedlichen Verfahrenstechniken",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Herstellung von Schablonen, Maskiertechnik und Dekorationstechniken nach Designvorlage",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausführen von Beschichtungen nach Schablonen und Pausen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausführen von Sonder- und Speziallackierungen auf vorbereiteten Untergründen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gestalten und Designen von Sonderlackierungen (zB mittels Airbrushtechnik) auf vorbereiteten Untergründen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erstellen von Arbeitsberichten und Arbeitsaufträgen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der betriebsspezifischen Soft- und Hardware",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Bedienung der elektronischen Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen von Arbeiten mit elektronischen Arbeitsbehelfen (zB EDV-Anlagen, Farbmischcomputern, Farbmessgeräten, Berechnungssystemen usw.)",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Anfertigens von Folien",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Demontieren und Montieren von Beschlägen welche den Lackierprozess beeinflussen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen und Anwenden von technischen Unterlagen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis einschlägiger fremdsprachiger Fachbegriffe",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Qualitätssicherung einschließlich der Reklamationsbearbeitung und Durchführung von betriebsspezifischen, qualitätssichernden Maßnahmen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften und Maßnahmen zum Schutz des Lebens und der Gesundheit, insbesondere über den Brand- und Explosionsschutz sowie der sonstigen in Betracht kommenden Vorschriften, Verarbeitungsrichtlinien und Sicherheitsdatenblätter",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "46.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutz der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "47.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 BAG)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "48.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 3
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

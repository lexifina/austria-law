      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "3e3f1fd8766903b162c96c128976d6b8f3b8cb89851d67f31f063b7803986519",
      "sha256": "75bf63499a90588a872f8f0dfd60411f08889dd9e2876b388683a0838b523467",
      "notes": [],

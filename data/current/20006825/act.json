      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "4. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsplanung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit bei der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen von Gesprächen mit Vorgesetzten, Kollegen und Lieferanten unter Beachtung der fachgerechten Ausdrucksweise",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Arbeitsbehelfe, Geräte, Maschinen und Anlagen sowie Grundkenntnisse der frühzeitigen Erkennungsmöglichkeiten von Störungen an Maschinen, Geräten und Anlagen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Kenntnis der vorbeugenden Wartung (Wartungspläne) und Instandhaltung sowie Mitarbeit bei der Wartung, Pflege und Instandhaltung der betriebsspezifischen Maschinen, Geräte und Anlagen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werk- (Metalle, Legierungen) und Hilfsstoffe, ihrer physikalischen und chemischen Eigenschaften, Verwendungs- und Verarbeitungsmöglichkeiten sowie über deren fachgerechte Lagerung",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen, Interpretieren und Anfertigen von einfachen Skizzen und Werkzeichnungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen, Interpretieren und Anfertigen von Skizzen und Werkzeichnungen sowie gießgerechtes Überarbeiten von Gussteilzeichnungen (Formschräge, Formteilung, Schrumpf- und Bearbeitungszugaben)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Durchführen von werkstoffspezifischen Anschnitt-, Modul- und Speiser-berechnungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von technischen Unterlagen wie z. B. Plänen, Bedienungsanleitungen, Handbüchern, Wartungsanleitungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse des rechnergestützten Konstruierens und Zeichnens (CAD)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des rechnergestützten Konstruierens und Zeichnens (CAD)",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundausbildung in der Werkstoffbearbeitung wie z. B. Sägen, Feilen, Drehen, Bohren, Schleifen, Messen und Anreißen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Herstellens von einschlägigen unlösbaren Verbindungen (wie z. B. Gasschmelzschweißen, Schutz-gasschweißen, Elektroschweißen) unter Beachtung der Gefahren und unter Anwendung der Maßnahmen zur Unfallverhütung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden von Trenntechniken wie z. B. Trennen mit Winkelschleifern, Brennschneidern unter Beachtung der Gefahren und unter Anwendung der Maßnahmen zur Unfallverhütung",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse des Robotereinsatzes in Gießereien",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Prüfung von Werk- und Hilfsstoffen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der praktischen Prüfung von Werk- und Hilfsstoffen mittels chemischer und physikalischer Prüfverfahren wie z. B. Sandkontrolle und Härteprüfungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der verschiedensten Formgebungs-technologien und deren Anwendungen für den Metallguss",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Formgebungstechnologien und deren Anwendungen wie z. B. Handformtechnik, Maschinenformtechnik, Dauerformen, Feinguss, Kokillen- und Druckguss",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Anschnitt- und Speisertechnik",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Anwenden der Anschnitt- und Speisertechnik (gerichtete Erstarrung, Kühlkokillen sowie das Setzen von Form- und Kernentlüftungen)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Grundkenntnisse der Erstarrungssimulation",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Modellwerkstoffe und -einrichtungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Prüfen und Vorbereiten von Modellen sowie Instandsetzen von Modelleinrichtungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Form- und Kern-werkstoffe",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Aufbereitung, Verarbeitung und Prüfung von Form- und Kernwerkstoffen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen einfacher Formen und Kerne",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von mehrteiligen Formen, Formbehelfen und schwierigen Kernen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von komplizierten Formen, Kernen und Kernstücken",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Zusammenbauen von Formen, Einlegen von Kernen und Gießfertigmachen (Säubern, Ver-klammern, Beschweren) der Formen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Aufbereiten und Auftragen von Form- und Kernüberzügen; Zusammenbauen von Formen, Einlegen von Kernen und Gießfertigmachen (Säubern, Verklammern, Beschweren) der Formen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Schmelzens, Legierens und den Schmelzbehandlungen metallischer Gusswerkstoffe",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Schmelz- und Warmhalteeinrichtungen sowie deren Funktion (zB Elektroöfen, Kupolöfen, Flammöfen, Lichtbogenöfen, Induktionsöfen)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Rüsten, An- und Ausfahren und Bedienen der betriebsspezifischen Produktionsanlagen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Rüsten, An- und Ausfahren und Bedienen der betriebsspezifischen Produktionsanlagen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Vergießtechniken",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vorbereiten des Gießprozesses wie zB Gießtemperatur, Gießzeit, Pfannenmanagement sowie Abschlacken und Abgießen der Formen und Beachtung der Anweisungen und Vorschriften",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis des Schmelztransportes, Pfannenmanagements und der Gieß-vorrichtungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ausleeren der Formen und Anwenden von Maßnahmen zum Entkernen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Nach-bearbeitens der Gussteile wie z. B. Strahlen, Reinigen, Putzen, Schleifen, Entgraten sowie der mechanischen Bearbeitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Nachbearbeiten der Gussteile wie zB Strahlen, Reinigen, Putzen, Schleifen, Entgraten",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Oberflächen- und Wärmebehandlung von Gussteilen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Elektrotechnik, Pneumatik und Hydraulik",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Kenntnis der Pneumatik und Hydraulik",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Mess-, Steuer- und Regelungstechnik",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Bedienen und Überwachen von Mess-, Steuer- und Regelungseinrichtungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Anlagenspezifische Kenntnis der Mess-, Steuer- und Regelungstechnik",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der betrieblichen EDV",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Protokollieren und grafisches Auswerten von Arbeitsergebnissen sowie deren Dokumentation auch unter Anwendung der betriebsspezifischen EDV",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Entstehens und Vermeidens von Gussfehlern sowie des Beurteilens (wie z. B. auf Maßhaltigkeit, Oberflächenbeschaffenheit) von Gussteilen",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "Setzen von Maßnahmen zum Abstellen von Gussfehlern",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse des Qualitätsmanagements",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit bei der Qualitätssicherung wie z. B. von Gusskontrollen auf Maßhaltigkeit, Härte, Oberflächenbeschaffenheit und Dichte",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Durchführen von speziellen Qualitäts-sicherungsmaßnahmen wie z. B. Schliff-kontrollen, Ultra-schallprüfungen oder Radioskopie",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Bedienung der Hebe- und Transporteinrichtungen (Stapler, Kräne) sowie Hinweise über die Gefahren beim Transport",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Umgang mit Hebe- und Transport-einrichtungen (Stapler, Kräne) unter Berücksichtigung der von diesen Einrichtungen ausgehenden Gefahren",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Anwendung der einschlägigen englischen Fachausdrücke",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften insbesondere des Brandschutzes sowie der sonstigen in Betracht kommenden Vorschriften zum Schutze des Lebens und der Gesundheit",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Erstversorgung bei betriebsspezifischen Arbeitsunfällen",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 BAG)",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 4
              }
            ]
          ],
          "merged_cells": true
        },
        {
          "cells": [
            [
              {

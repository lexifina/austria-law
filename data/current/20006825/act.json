                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Sandregenerierung und Entsorgung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,

                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis und Mitarbeit bei der Überwachung und Steuerung der Sandkreisläufe",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },

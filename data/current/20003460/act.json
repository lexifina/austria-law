      "file": "art-009.md",
      "source_context": null,
      "identity_review_required": false,
      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "a52eb169dd4e17153f8ebe5e7012779d312636045808b589954779bc706c6d5f",
      "sha256": "b9a932967c398690700cfd1e6a425363e751d49432834c61638d501fe8679122",
      "notes": [],
      "links": [],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "1. für die Unterbringung und Verpflegung in einer organisierten Unterkunft pro Person und Tag",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 25,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2. für die Verpflegung bei individueller Unterbringung pro Person und Monat",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "für Erwachsene",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 260,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "für Minderjährige",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 145,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "für unbegleitete Minderjährige",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 260,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3. für die Miete bei individueller Unterbringung pro Monat",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "für eine Einzelperson",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 165,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "für Familien (ab zwei Personen) gesamt",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 330,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4. für Taschengeld pro Person und Monat",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 40,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5. für Überbrückungshilfe bei Rückkehr, einmalig pro Person",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 370,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6. für die Sonderunterbringung für pflegebedürftige Personen, pro Person und Tag",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 112,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6a. für die Sonderbetreuung in organisierten Unterkünften zusätzlich zu Z 1 pro Person und Tag",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 35,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "7. für die Unterbringung, Verpflegung und Betreuung unbegleiteter minderjähriger Fremder pro Person und Tag",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 112,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "7a. für die Unterbringung, Verpflegung und Betreuung von unbegleiteten minderjährigen Fremden in Einrichtungen im Auftrag der Kinder- und Jugendhilfe gemäß Art. 7 Abs. 2 letzter Satz pro Person und Tag",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 130,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "8. für die Krankenversicherung maximal in Höhe des gemäß §§ 9 und 51 ASVG jeweils festgesetzten Beitragssatzes (derzeit 7,3 % inklusive Zusatzbetrag).",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "9. für Information, Beratung und soziale Betreuung (exkl. Dolmetscherkosten) nach einem maximalen Betreuerschlüssel von",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1:140",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "10. für die zum Schulbesuch erforderlichen Fahrtkosten – bis zu einer Kostentragung nach dem Familienlastenausgleichsgesetz (FLAG) – die Tarifsätze der jeweiligen Verkehrsunternehmen.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "11. für Schulbedarf pro Kind und Jahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 200,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "12. für Freizeitaktivitäten in organisierten Quartieren pro Person/Monat",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 10,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13. für Deutschkurse für unbegleitete minderjährige Fremde mit maximal 200 Unterrichtseinheiten und pro Einheit pro Person",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 3,63",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14. für notwendige Bekleidungshilfe jährlich pro Person",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "€ 150,--",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "15. für Rückreise nach den Kostenhöchstsätzen der Internationalen Organisation für Migration (IOM) und",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "16. für Kosten gemäß Art. 2 Abs. 1 Z 5 pro Person und Tag maximal der gemäß § 19 Abs. 2 FPG-DV jeweils festgelegte Betrag.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },

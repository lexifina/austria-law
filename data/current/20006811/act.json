      "tables": [
        {
          "cells": [
            [
              {
                "text": "Pos.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "2. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3. Lehrjahr",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Betriebs- und Rechtsform des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des organisatorischen Aufbaus und der Aufgaben und Zuständigkeiten der einzelnen Betriebsbereiche",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einführung in die Aufgaben, die Branchenstellung und das Angebot des Lehrbetriebs",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Marktposition und des Kundenkreises des Lehrbetriebes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ergonomisches Gestalten des Arbeitsplatzes",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Arbeitsplanung und Arbeitsvorbereitung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Durchführen der Arbeitsplanung; Festlegen von Arbeitsschritten, Arbeitsmitteln und Arbeitsmethoden",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Handhaben und Instandhalten der zu verwendenden Werkzeuge, Geräte, Maschinen, Einrichtungen und Arbeitsbehelfe",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Werk- (Eisen- und Nichteisenmetalle, Nichtmetalle, Verbundwerkstoffe) und Hilfsstoffe (Schmieröle, Schmierfette, Reinigungsstoffe, Brennstoffe), ihrer Eigenschaften, Verwendungs-, Verarbeitungs- und Bearbeitungsmöglichkeiten unter Beachtung von einschlägigen Verarbeitungsrichtlinien",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Führen von Gesprächen mit Vorgesetzten, Tierärzten, Kollegen, Kunden und Lieferanten unter Beachtung der fachgerechten Ausdrucksweise",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beraten und Informieren von Kunden in Fragen zB der Hufpflege, des Hufbeschlages und der Pferdehaltung",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der wichtigsten rechtlichen Vorschriften wie zB des Tierschutzgesetzes",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Anatomie des Pferdes sowie der Funktion der Knochen, der Bänder, Sehnen und Muskeln der Gliedmaßen sowie der Abweichungen hinsichtlich Esel und Rind",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Reit- und Fahrsportes sowie deren Auswirkungen auf den Hufbeschlag",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Exterieur-beurteilung und der Konsequenzen von Exterieurfehlern",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Beurteilung der Hornqualität",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Beurteilen und Bewerten der Hornqualität",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beurteilen und Bewerten der Hornqualität",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Gangarten des Pferdes sowie deren Beurteilung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Beurteilen, Analysieren und Skizzieren der Gangarten des Pferdes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Pferdehaltung und des Umganges mit Pferden auch unter Berücksichtigung der Sicherheitsaspekte",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Futtermittellehre, der Pferde-fütterung und des Dopings",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der allgemeinen Erkrankungen des Pferdes, der Huferkrankungen und ihrer Symptome, deren Erkennung sowie des PAT-Wertes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der gängigen Therapien bei Huf-erkrankungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "20.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Maßnahmen bei der Vernagelung (Nagelstich, Nageldruck)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Treffen von Maßnahmen bei Vernagelung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "21.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Lahmheit, der Lahmheituntersuchung und der Lahmheitsgrade",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit bei der Zangenprobe",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "22.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Hufpflege, der Beschlagsbedürftigkeit und der Beschlagsperiode",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "23.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Umgehen, Vorstellen und Vorführen von Pferden",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der aktuellen Ausbildungsmethoden für Pferde",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "24.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis des Umgangs mit schwierigen Pferden sowie der Anwendung von Hilfs- und Zwangsmittel zur Sicherheit",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Umgehen mit schwierigen Pferden auch unter Anwendung von Hilfs- und Zwangsmitteln zur Sicherheit",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "25.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Besonderheiten des Charakters der Esel und Rinder sowie deren Hufe bzw. Klauen und Eisen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Umgehen mit Eseln und Rindern sowie Bearbeiten von Eselhufen und Rinderklauen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "26.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Chemie, Elektrotechnik und Kalorik",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "27.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anfertigen von Skizzen wie zB Hufskizzen, Beschlagsskizzen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "28.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lesen von technischen Unterlagen wie von Skizzen, Zeichnungen, Plänen, usw.",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "29.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Einrichtungen eines mobilen und stationären Beschlagplatzes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einrichten eines mobilen und stationären Beschlagplatzes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "30.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Messen und Prüfen von mechanischen Größen unter Anwendung von Mess- und Prüfmitteln sowie Messen von Temperaturen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "31.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Manuelles und maschinelles Bearbeiten von Werkstoffen wie zB Anreißen, Feilen, Sägen, Meißeln, Raspeln, Trennschneiden, Brennschneiden, Gewindeschneiden, Senken, Schleifen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "32.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Glüh- und Anlassfarben",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "33.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Schmieden und Warmbehandeln von Werkstoffen wie zB Wärmebehandeln, Härten, Glühen, Feuerführen und Warmmachen des Schmiedestückes, Strecken, Breiten, Spitzen, Stauchen, Lochen, Spalten, Richten, Biegen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "34.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen bzw. Optimieren von Beschlagswerkzeug",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "35.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von einschlägigen lösbaren (Schraub- und Nietverbindungen)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von unlösbaren Verbindungen (wie zB Gasschmelzschweißen, Schutzgasschweißen, Elektroschweißen, Feuerschweißen, Hartlöten) unter Beachtung der Gefahren und unter Anwendung der Maßnahmen zur Unfallverhütung",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "36.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Hufeisen- und Hufnägelarten, Hufeinlagen, Polsterungen, ihrer Herstellung und Anwendung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "37.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von Hufeisen nach Normen sowie Kalt- oder Warmrichten und -biegen von Hufeisen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "38.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mitarbeit beim Analysieren und Beurteilen der alten Beschläge, des Pferdes in statischen und dynamischen Zustand sowie des zu beschlagenden Hufes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Analysieren und Beurteilen der alten Beschläge, des Pferdes in statischen und dynamischen Zustand sowie des zu beschlagenden Hufes",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "39.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Entfernen der alten Beschläge und Auswählen der neuen passenden Hufeisen; Vernieten der Hufnägel",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Korrigieren (Strahl pflegen, Sohle putzen, Tragrand kürzen) des Hufes und Beraspeln der Hufwand",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "40.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Versehen der Hufeisen mit den erforderlichen Bohrungen und Anfassungen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "41.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zurichten des Hufeisen gemäß Hufform, Anbringen der Hufeisen sowie Warmaufrichten des Hufeisen auf den Huf",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "42.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Auswählen der Nägel für Huf und Hufeisen, Aufnageln und Vernieten der Hufeisen sowie Endbearbeiten",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "43.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Prüfen des frisch beschlagenen Pferdes im statischen und dynamischen Zustand",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "44.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Spezialbeschläge und deren Anwendung für unterschiedliche Sportdisziplinen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen von Spezialbeschlägen wie zB für Sprung- und Fahrpferde, Arbeitspferde, Esel, Maultiere, Ponys",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "45.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Winterbeschläge und der gängigen Schnee-Einlagen und deren Anwendungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "46.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der abnormen Gangarten und Stellungen und der Korrekturbeschläge (Streifeisen, Eisen für Zehenschleifer, Stegeisen usw.)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Herstellen und Beschlagen von Korrekturbeschlägen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "47.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anwenden der gängigen Hufpflege- und Hufschutzprodukte",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "48.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erstellen von Anboten und/oder Informationen über die betrieblichen Leistungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "49.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der betrieblichen Kosten, deren Beeinflussbarkeit und deren Auswirkungen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "50.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der Qualitätssicherung einschließlich der Reklamationsbearbeitung und Durchführung von betriebsspezifischen, qualitätssichernden Maßnahmen",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "51.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis über Inhalt und Ziel der Ausbildung sowie über wesentliche einschlägige Weiterbildungsmöglichkeiten",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "52.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der einschlägigen Sicherheitsvorschriften und der sonstigen in Betracht kommenden Vorschriften zum Schutze des Lebens und der Gesundheit sowie über den Brandschutz",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "53.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der Erstversorgung bei betriebsspezifischen Arbeitsunfällen",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "54.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für den Lehrberuf relevanten Maßnahmen und Vorschriften zum Schutze der Umwelt: Grundkenntnisse der betrieblichen Maßnahmen zum sinnvollen Energieeinsatz im berufs-relevanten Arbeitsbereich; Grundkenntnisse der im berufsrelevanten Arbeitsbereich anfallenden Reststoffe und deren Trennung, Verwertung sowie über die Entsorgung des Abfalls",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "55.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kenntnis der sich aus dem Lehrvertrag ergebenden Verpflichtungen (§§ 9 und 10 BAG)",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "56.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Grundkenntnisse der aushangpflichtigen arbeitsrechtlichen Vorschriften",
                "rowspan": 1,
                "colspan": 3
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },

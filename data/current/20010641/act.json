      "file": "anl-3.md",
      "source_context": null,
      "identity_review_required": false,
      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "1cfbb072b85f57d46c455419457a59afa55eebc473c00bf275dfc83eb44e7d53",
      "sha256": "14aee6ec310a84c5a48c330a7bc809a354638ad97a9e188515e15c888e749d7c",
      "notes": [],
      "links": [
        {
          "text": "BGBl. Nr. 598/1993",
          "url": "https://ogd.ris.bka.gv.at/Dokumente/BgblPdf/1993_598_0/1993_598_0.pdf"
        }
      ],
      "images": [],
      "source_extensions": [],
      "tables": [
        {
          "cells": [
            [
              {
                "text": "Mitgliedstaat",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verkehrsrechte",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Bulgarien",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten an zwei zu benennenden Punkten, die als Zwischenlandepunkte auf dem Weg nach und/oder Punkte über Sofia hinaus angeflogen werden können.",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Tschechische Republik",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten an bis zu vier von Kanada auszuwählenden Punkten, die als Zwischenlandepunkte auf dem Weg nach Prag oder Punkte über Prag hinaus angeflogen werden können, sowie an einem zusätzlichen Punkt in der Tschechischen Republik.",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Dänemark",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen Kopenhagen und a) Amsterdam und Helsinki oder b) Amsterdam und Moskau. Amsterdam kann als Zwischenlandepunkt oder als Punkt darüber hinaus angeflogen werden. Helsinki und Moskau sind als Punkte darüber hinaus anzufliegen.",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Deutschland",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit können zwischen Zwischenlandepunkten in Europa und Punkten in der Bundesrepublik Deutschland sowie zwischen Punkten in der Bundesrepublik Deutschland und Punkten darüber hinaus ausgeübt werden.",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "Griechenland",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten an Zwischenlandepunkten auf dem Weg nach Athen und/oder Punkten darüber hinaus und an zwei zusätzlichen Punkten in Griechenland, ausgenommen Punkte in der Türkei und in Israel. Die Gesamtzahl der Zwischenlandepunkte und der Punkte darüber hinaus, die gleichzeitig mit Rechten der fünften Freiheit angeflogen werden können, darf nicht mehr als fünf betragen, wobei vier Punkte davon Zwischenlandepunkte sein können.",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "Irland",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen Punkten in Irland und Zwischenlandepunkten sowie zwischen Punkten in Irland und Punkten darüber hinaus. Bei Nurfrachtdiensten besteht das Recht, internationale Beförderungen zwischen Punkten in Irland und Punkten in Drittstaaten ohne die Auflage der Bedienung eines Punktes in Kanada durchzuführen.",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "Italien",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen zwei Zwischenlandepunkten in Europa und Rom und/oder Mailand. Zwischenlandepunkte mit Rechten der fünften Freiheit können auch als Punkte darüber hinaus bedient werden.",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "Polen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen Warschau und zwei Zwischenlandepunkten in Europa, die von Kanada aus folgender Liste auszuwählen sind: Brüssel, Kopenhagen, Prag, Shannon, Stockholm, Wien, Zürich.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "Portugal",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen Punkten in Portugal und Zwischenlandepunkten sowie zwischen Punkten in Portugal und Punkten über Portugal hinaus.",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Spanien",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Für Zwischenlandepunkte und Punkte darüber hinaus gelten Rechte der fünften Freiheit: a) zwischen Madrid und drei zusätzlichen Punkten in Spanien und Punkten in Europa (außer München, Dänemark, Schweden, Norwegen, Italien und den Republiken der ehemaligen UDSSR) sowie b) zwischen Madrid und einem anderen Punkt in Spanien und Punkten in Afrika und im Nahen Osten, wie von der ICAO in Dokument 9060-AT/723 festgelegt. Gleichzeitig dürfen an höchstens vier Punkten Rechte der fünften Freiheit wahrgenommen werden.",
                "rowspan": 1,
                "colspan": 3
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Schweden",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen Stockholm und: a) Amsterdam und Helsinki oder b) Amsterdam und Moskau. Amsterdam kann als Zwischenlandepunkt oder als Punkt darüber hinaus angeflogen werden. Helsinki und Moskau sind als Punkte darüber hinaus anzufliegen.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 3
              }
            ],
            [
              {
                "text": "Vereinigtes Königreich",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen Punkten im Vereinigten Königreich und Zwischenlandepunkten sowie zwischen Punkten im Vereinigten Königreich und Punkten darüber hinaus. Bei Nurfrachtdiensten besteht das Recht, internationale Beförderungen zwischen Punkten im Vereinigten Königreich und Punkten in Drittstaaten ohne die Auflage der Bedienung eines Punktes in Kanada durchzuführen.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 3
              }
            ]
          ],
          "merged_cells": true
        },
        {
          "cells": [
            [
              {
                "text": "Mitgliedstaat",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verkehrsrechte",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "Belgien",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen Montreal und zwei Punkten in den Vereinigten Staaten von Amerika östlich von und einschließlich Chicago sowie nördlich von und einschließlich Washington D.C.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "Bulgarien",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit können an einem Punkt darüber hinaus in den Vereinigten Staaten von Amerika östlich von und ausgenommen Chicago sowie nördlich von und einschließlich Washington D.C. wahrgenommen werden. Bei gemeinsamer Terminalnutzung für Montreal und Ottawa stehen keine Rechte der fünften Freiheit zur Verfügung. An Zwischenlandepunkten stehen keine Rechte der fünften Freiheit zur Verfügung.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "Tschechische Republik",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen Montreal und zwei Punkten in den Vereinigten Staaten von Amerika nördlich von und einschließlich Washington D.C. sowie östlich von und einschließlich Chicago.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 4
              }
            ],
            [
              {
                "text": "Dänemark",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen Montreal und Chicago sowie zwischen Montreal und Seattle. Chicago kann als Zwischenlandepunkt oder als Punkt darüber hinaus angeflogen werden. Seattle darf nur als Punkt darüber hinaus angeflogen werden.",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Deutschland",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten nur zwischen Montreal und einem Punkt darüber hinaus in Florida. Als Alternative stehen Punkte mit Rechten der fünften Freiheit zwischen Montreal und zwei Punkten darüber hinaus im Kontinentalgebiet der Vereinigten Staaten von Amerika zur Verfügung, ausgenommen Punkte in den Bundesstaaten Kalifornien, Colorado, Florida, Georgia, Oregon, Texas und Washington.",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Griechenland",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen Montreal und Boston oder zwischen Montreal und Chicago oder zwischen Punkten nach Toronto und einem von der Hellenischen Republik zu benennenden Punkt in den Vereinigten Staaten von Amerika, ausgenommen Punkte in Kalifornien, Texas und Florida.",
                "rowspan": 1,
                "colspan": 4
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              }
            ],
            [
              {
                "text": "Irland",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen Punkten in Kanada und Zwischenlandepunkten sowie zwischen Punkten in Kanada und Punkten darüber hinaus. Bei Nurfrachtdiensten besteht das Recht, internationale Beförderungen zwischen Punkten in Kanada und Punkten in Drittstaaten ohne die Auflage der Bedienung eines Punktes in Irland durchzuführen.",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Italien",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen zwei Zwischenlandepunkten im Nordosten der Vereinigten Staaten von Amerika (nördlich von und einschließlich Washington, östlich von und einschließlich Chicago) und Montreal und/oder Toronto. Zwischenlandepunkte mit Rechten der fünften Freiheit können auch als Punkte darüber hinaus bedient werden.",
                "rowspan": 1,
                "colspan": 5
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Polen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechte der fünften Freiheit gelten zwischen Montreal und New York als Zwischenlandepunkt oder Punkt darüber hinaus.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 5
              }
            ],
            [
              {
                "text": "Portugal",
                "rowspan": 1,

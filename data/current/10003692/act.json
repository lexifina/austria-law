                "colspan": 1
              }
            ],
            [
              {
                "text": "Artikel 5ter:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Abschriften der im internationale Register eingetragenen Angaben; Recherchen nach älteren Registrierungen; Auszüge aus dem internationalen Register",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Artikel 6:",
                "rowspan": 1,
                "colspan": 1
              },
              {

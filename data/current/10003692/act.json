              {
                "text": "Artikel 4:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Wirkung der internationalen Registrierung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Artikel 4bis:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Ersetzung einer nationalen oder regionalen Eintragung durch eine internationale Registrierung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Artikel 5:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Schutzverweigerung und Ungültigerklärung der Wirkungen der internationalen Registrierung in bezug auf bestimmte Vertragsparteien",

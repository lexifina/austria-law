                "colspan": 1
              }
            ],
            [
              {
                "text": "Artikel 5bis:",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Belege für die Rechtmäßigkeit des Gebrauchs gewisser Markenbestandteile",

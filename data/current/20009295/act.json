              {
                "text": "Aufwendungen für Kapitalanlagen und Zinsenaufwendungen (§ 146 Abs. 5 Posten IV.3. VAG 2016);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "+",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Sonstige versicherungstechnische Erträge (§ 146 Abs. 4 Posten III.4. VAG 2016);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Aufwendungen für Versicherungsfälle (§ 146 Abs. 4 Posten III.5. VAG 2016);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erhöhung von versicherungstechnischen Rückstellungen (§ 146 Abs. 4 Posten III.6. VAG 2016) abzüglich der Aufwendungen für die Dotierung der Zinszusatzrückstellung gemäß § 3 der Versicherungsunternehmen-Höchstzinssatzverordnung – VU-HZV, BGBl. II Nr. 266/2016, in der jeweils geltenden Fassung;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "7.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "+",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verminderung von versicherungstechnischen Rückstellungen (§ 146 Abs. 4 Posten III.7. VAG 2016) abzüglich der Erträge aus der Auflösung der Zinszusatzrückstellung gemäß § 3 VU-HZV;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Aufwendungen für den Versicherungsbetrieb (§ 146 Abs. 4 Posten III.9. VAG 2016);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Sonstige versicherungstechnische Aufwendungen (§ 146 Abs. 4 Posten III.11. VAG 2016);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "+",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Sonstige nichtversicherungstechnische Erträge (§ 146 Abs. 5 Posten IV.5. VAG 2016);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "11.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Sonstige nichtversicherungstechnische Aufwendungen (§ 146 Abs. 5 Posten IV.6. VAG 2016);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Steuern vom Einkommen und vom Ertrag (§ 146 Abs. 5 Posten IV.11. VAG 2016);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "+",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Auflösung der Risikorücklage gemäß § 143 VAG 2016 (§146 Abs. 5 Posten IV.13.a. VAG 2016);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zuweisung an die Risikorücklage gemäß § 143 VAG 2016 (§ 146 Abs. 5 Posten IV.14.a. VAG 2016);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Aufwendungen für die Dotierung der Zinszusatzrückstellung gemäß Abs. 3 Z 3;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "+",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Erträge aus der Auflösung der Zinszusatzrückstellung gemäß § 3 Abs. 6 VU-HZV;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "–",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anrechnung von Überdotierungen oder negativen Mindestbemessungsgrundlagen aus früheren Geschäftsjahren gemäß Abs. 6.",
                "rowspan": 1,

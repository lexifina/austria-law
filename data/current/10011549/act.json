              },
              {
                "text": "0,2 + 0,02 log10 V (oder entsprechend dem Tabellenwert in Anhang 2).",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "Vc =",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zahlungwert des in Kubikmeter gemessenen Inhalts aller Laderäume,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "K2 =",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "0,2 + 0,02 log tief 10 V tief c (oder entsprechend dem Tabellenwert in Anhang 2),",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "K3 =",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "1,25 ,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "H =",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Seitenhöhe mittschiffs gemäß Regel 2 Abs. 2 (in Meter),",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "T =",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Tiefgang mittschiffs gemäß Absatz 2 der vorliegenden Regel (in Meter),",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "N1 =",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anzahl der Fahrgäste in Kabinen mit nicht mehr als 8 Betten,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "N2 =",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Anzahl der sonstigen Fahrgäste,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "N1 + N2 =",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gesamtzahl der nach dem Fahrgastzeugnis zulässigen Fahrgäste; falls die Summe vonN1 und N2 kleiner als 13 ist, bleibt sie unberücksichtigt,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "BRZ =",
                "rowspan": 1,
                "colspan": 1

      "tables": [
        {
          "cells": [
            [
              {
                "text": "I.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Für Arbeitsplätze der Verwendungs- bzw. Entlohnungsgruppe A1 und v1 (höherer auswärtiger Dienst)",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "Kursinhalte",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Mind. UE",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Basislehrgang A1/v1 der Verwaltungsakademie des Bundes in der aktuellen Fassung für diese Verwendungs- bzw. Entlohnungsgruppen einschließlich einer vorgesehenen Prüfung.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "80",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Inhalte u.a.: Einführung, Grundzüge des Verfassungsrechts, Allgemeines Verwaltungsverfahrensrecht, Grundlagen des Unionsrechts, Dienstrecht und Compliance, Haushaltsrecht",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Alternative: Basislehrgang A1/v1 für rechtskundige Bedienstete v1 der Verwaltungsakademie des Bundes in der aktuellen Fassung für diese Verwendungs- bzw. Entlohnungsgruppen einschließlich einer vorgesehenen Prüfung.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "80",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Inhalte u.a.: Einführung, Legistik und Rechtserzeugungsprozess, Rechtsschutz im öffentlichen Recht, Vertiefung des Unionsrechts, Dienstrecht und Compliance, Haushaltsrecht",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Wahlpflichtmodule zu Soft Skills",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "36",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Verhandlungstechnik in deutscher oder englischer Sprache im berufsspezifischen Kontext",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "8",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Kommunikation, Rhetorik, Präsentationstechniken",
                "rowspan": 1,
                "colspan": 1

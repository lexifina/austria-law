                "text": "2. Palmöl",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Elaeis guineensis Elaeis olifera",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3. Sal",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Shorea robusta",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4. Shea",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Butyrospermum parkii",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5. Kokum gurgi",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Garcinia indica",
                "rowspan": 1,
                "colspan": 1
              }
            ],

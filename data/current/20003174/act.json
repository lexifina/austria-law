              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.1.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fructose- und Glucosegehalt (Summe)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Blütenhonig",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "mindestens 60 g/100 g,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Honigtauhonig, allein oder in Mischung mit Blütenhonig",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "mindestens 45 g/100 g.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1.2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Saccharosegehalt",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Im Allgemeinen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "höchstens 5 g/100 g.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Honig von Robinie (Robinia pseudoacacia), Luzerne (Medicago sativa), Banksia menziesii,Süßklee (Hedysarum), Roter Eukalyptus (Eucalyptus camadulensis), Eucryphia lucida, Eucryphia milliganii, Citrus spp.",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "höchstens 10 g/100 g,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Honig von Lavendel (Lavendula spp.), Borretsch (Borago officinalis",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "höchstens 15 g/100 g.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Wassergehalt",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Im Allgemeinen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "höchstens 20%,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Honig von Heidekraut (Calluna) und Backhonig im Allgemeine",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "höchstens 23%,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Backhonig von Heidekraut (Calluna)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "höchstens 25%.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gehalt an wasserunlöslichen Stoffen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Im Allgemeinen",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "höchstens 0,1 g/100 g,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Presshonig",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "höchstens 0,5 g/100 g.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Elektrische Leitfähigkeit",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Nachstehend nicht aufgeführte Honigarten und Mischungen dieser Honigarten",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "höchstens 0,8 mS/cm,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Honigtauhonig und Kastanienhonig und Mischungen dieser Honigarten mit Ausnahme der nachstehend angeführten Honigarten",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "mindestens 0,8 mS/cm.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "– Ausnahmen: Honig von Erdbeerbaum (Erica), Eukalyptus, Linden (Tilia spp), Heidekraut (Calluna vulgaris), (Leptospermum), Teebaum (Melaleuca spp.)",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,

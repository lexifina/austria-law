              {
                "text": "",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gehalt an freien Säuren",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "",

      "tables": [
        {
          "cells": [
            [
              {
                "text": "Wirkungsdimension gesamtwirtschaftliche Aspekte wirtschaftspolitischer Auswirkungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Fragen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "1) Nachfrage",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Hat die Regelung/das Vorhaben Auswirkungen auf die öffentliche Nachfrage oder indirekt auf die private oder Auslandsnachfrage aufgrund budgetär wirksamer Maßnahmen in den nächsten fünf Jahren?",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "2) Angebot und gesamtwirtschaftliche Rahmenbedingungen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Hat die Regelung/das Vorhaben Auswirkungen auf die gesamtwirtschaftlichen Rahmenbedingungen, sodass das Wachstumspotential beeinflusst wird, etwa das Angebot an Kapital und Arbeit bzw. die Produktivität dieser Produktionsfaktoren?",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]
    },

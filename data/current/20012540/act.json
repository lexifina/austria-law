                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Projekt- oder Teamleitung für kleine Teams oder Gruppen, laufendes Feedback an Projekt-/Teammitglieder",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Weiterentwicklung des eigenen Tätigkeitsfeldes oder Betriebes durch innovative Herangehensweisen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Planungs-, Koordinations-, Leitungs- und Entwicklungsanforderungen",
                "rowspan": 3,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Nachrangige Bedeutung von Planungs-, Koordinations- und Leitungsanforderungen",
                "rowspan": 2,
                "colspan": 1
              },
              {
                "text": "Vorrangige Bedeutung von Planungs-, Koordinations- und Leitungsanforderungen",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Verantwortung für die strategische Steuerung von Abteilungen und/oder ganzen Betrieben",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Detailbeschreibung der Qualifikationen nach Lernergebnissen",

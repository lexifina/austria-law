      "tables": [
        {
          "cells": [
            [
              {
                "text": "Nummer des finnländischen Tarifes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Warenbezeichnung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Prozentsatz der Ermäßigung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "481",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Schachteln, Gürtel, Teile zu Gürteln und Hosenträgern, Etuis, Brieftaschen und Portemonnaies sowie Taschen mit oder ohne Einrichtung, aus Leder, auch in Verbindung mit anderen Materialien. Im Stückgewicht bis höchstens 0.5 kg",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "75 v. H.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "945",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bijouteriewaren aller Art mit Ausschluß solcher aus Gold, Silber oder Platin, wie Armbänder, Broschen, Hemdbrustknöpfe, Krawattennadeln, Hals- und Uhrketten, Hutspangen, Haarspangen und anderer Haarzierat, nicht zu anderen Nummern gehörend, Manschettenknöpfe, Uhrhaken, Uhrhälter sowie andere für den persönlichen Gebrauch bestimmte Schmuckgegenstände",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "80 v. H.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "Nummer des österreichischen Tarifes",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Warenbezeichnung",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zölle in Kronen pro 100 kg",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "aus 298 b/1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Sperrholz, sofern dessen beide äußeren Platten aus Birkenholz und die inneren Platten aus Birken-, Kiefern-, Fichten- oder Espenholz bestehen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "10,–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "aus 302 Anm. 1",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zwirnspulen",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "4,–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "aus 510 a",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Kasein",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "frei",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "aus 548 a/2",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Skier",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "50,–",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Diskusse und Speere",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "35,–",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        }
      ]

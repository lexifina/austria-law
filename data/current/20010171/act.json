      "identity_basis": "source_designation_and_context",
      "source_fingerprint": "335937c92a90e132c2ec77a06023aa3cd1ecb5e0138bb5c861856360a93fd70f",
      "sha256": "bacbf32219d798cb79099d62600efbbcfd80ecb8e30e653d7adc6643b8faf278",
      "notes": [],

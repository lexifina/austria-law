      "tables": [
        {
          "cells": [
            [
              {
                "text": "60 Punkte",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "für die Beamtin oder Vertragsbedienstete bzw. den Beamten oder Vertragsbediensteten,",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "21 Punkte",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "für die Ehepartnerin oder den Ehepartner bzw. für die eingetragene Partnerin oder den eingetragenen Partner, für den sie oder er Anspruch auf Ehegattenzuschlag gemäß § 21a Z 7 GehG hat, und",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "12 Punkte",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "für jedes Kind, für das sie oder er Anspruch auf Kinderzuschlag gemäß § 21a Z 8 GehG hat.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "10 Punkte",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "(Ortsklasse I) bei einer Verwendung in allen Orten, die nicht ausdrücklich einer höheren Ortsklasse zugeordnet sind;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "35 Punkte",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "(Ortsklasse II) bei einer Verwendung in Ankara, Astana, Baku, Bogotá, Brasilia, Buenos Aires, Caracas, Chengdu, Chişinău, Guatemala, Havanna, Istanbul, Kiew, Lima, Mexiko, Minsk, Moskau, Peking, Santiago de Chile, Santo Domingo, Sao Paulo, Shanghai, Tel Aviv oder Tiflis;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "70 Punkte",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "(Ortsklasse III) bei einer Verwendung in Abu Dhabi, Abuja, Addis Abeba, Algier, Amman, Bagdad, Bangkok, Beirut, Dakar, Damaskus, Doha, Hanoi, Islamabad, Jakarta, Kairo, Kapstadt, Kuala Lumpur, Kuwait, Manila, Maskat, Nairobi, New Delhi, Pretoria, Rabat, Riyadh, Teheran, Tunis oder Tripolis.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": false
        },
        {
          "cells": [
            [
              {
                "text": "Objektivierter Wohnbedarf",
                "rowspan": 1,
                "colspan": 2
              },
              {
                "text": "Vorgabe",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Beamtin bzw. Beamter oder Vertragsbedienstete bzw. Vertragsbediensteter",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "60 Punkte",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Ehegattin bzw. Ehegatte oder eingetragene Partnerin bzw. eingetragener Partner",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "(21 Punkte)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "___ Punkte",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Kind(er)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "(pro Kind 12 Punkte)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "___ Punkte",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Ortsklasse I, II oder III",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "(10, 35 oder 70 Punkte)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "___ Punkte",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "Allfälliger Raumbedarf gemäß § 2 Abs. 3 Z 1 bis 7d",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "(10 oder 20 Punkte)",
                "rowspan": 1,
                "colspan": 1
              },
              {

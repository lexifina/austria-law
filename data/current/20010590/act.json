      "tables": [
        {
          "cells": [
            [
              {
                "text": "∆iB1 = k * ∆u1",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "∆iB2 = k * ∆u2",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "∆iB1...zusätzlicher Blindstrom im Mitsystem",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "∆iB2...zusätzlicher Blindstrom im Gegensystem",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "∆u1...Änderung der Mitsystemspannung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "∆u2...Änderung der Gegensystemspannung",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "k…Verstärkungsfaktor (2 ≤ k ≤ 6); einstellbar in Schritten von 0,5 (ausgenommen Stromerzeugungsanlagen mit direkt gekoppelten Asynchrongeneratoren bei asymmetrischen Fehlern)",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],

      "notes": [
        {
          "kind": "Langtitel",
          "text": "ÜBEREINKOMMEN über den Beitritt der Portugiesischen Republik zu dem am 19. Juni 1990 in Schengen unterzeichneten Übereinkommen zur Durchführung des Übereinkommens von Schengen vom 14. Juni 1985 zwischen den Regierungen der Staaten der Benelux-Wirtschaftsunion, der Bundesrepublik Deutschland und der Französischen Republik betreffend den schrittweisen Abbau der Kontrollen an den gemeinsamen Grenzen, dem die Italienische Republik mit dem am 27. November 1990 in Paris unterzeichneten Übereinkommen beigetreten ist StF: BGBl. III Nr. 90/1997 (NR: GP XX RV 501 AB 542 S. 52. BR: AB 5374 S. 620.)"
        },
        {
          "kind": "Änderung",
          "text": "(Anm.: etwaige idF-Liste siehe Schengener Übereinkommen - Durchführung - Beitritt Österreich, BGBl. III Nr. 90/1997)"
        },
        {
          "kind": "Vertragsparteien",
          "text": "Mitgliedstaaten siehe Schengener Übereinkommen - Durchführung - Beitritt Österreich, BGBl. III Nr. 90/1997"
        }
      ],

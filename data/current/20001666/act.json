              }
            ],
            [
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Republik Österreich.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "3.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Lehrlingsfürsorgeaktion beim Bundesministerium für soziale Verwaltung („Wiener Zeitung“ Nr. 92 vom 22. April 1922).",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Republik Österreich.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "4.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Blindenerziehungsinstituts-Fonds, Taubstummeninstituts-Fonds.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Oesterreichische Nationalbank.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "5.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Pensionsfonds der Oesterreichischen Nationalbank (Art. 99 und 100 der dem Bundesgesetz BGBl. Nr. 823/1922 angeschlossenen Satzungen).",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Milchwirtschaftsfond (§ 2 des Milchwirtschaftsgesetzes, BGBl. Nr. 167/1950).",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "6.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Milchausgleichsfonds Milchausgleichsfondsgesetz 1934, BGBl. Nr. 17/1935); Österreichische Ausfuhrorganisation für Molkereierzeugnisse (§ 5 des Bundesgesetzes vom 8. Juni 1934, BGBl. II Nr. 76); Wiener Milchverkehrsstelle (§ 14 des Milchverkehrsgesetzes, BGBl. II Nr. 210/1934).",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "7. a)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Österreichischer Bauernbund.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "7. a)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Reichsbauernbund (§ 36 des Bundesgesetzes BGBl. Nr. 304/1935 über die Einrichtung des Berufstandes Land- und Forstwirtschaft);",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "b)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "die entsprechende Landesgruppe des Österreichischen Bauernbundes.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "b)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Landesbauernbünde (§ 9 des vorangeführten Bundesgesetzes und die hiezu ergangenen Ausführungsgesetze).",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Österreichischer Gewerkschaftsbund, mit der Maßgabe, daß in die Rechte an jenen in Rückstellung begriffenen oder rückgestellten Vermögen, die aus dem Vermögen der zufolge Art. 38 der Gewerbeordnungs-Novelle 1935, BGBl. Nr. 548, aufgelösten Gehilfenversammlungen (Gehilfenausschüsse) herrühren, die entsprechenden Gehilfenausschüsse (BGBl. Nr. 87/1950) mit ihrer Einrichtung eintreten, und mit der weiteren Maßgabe, daß von dem übrigen rückgestellten Vermögen je ein Sechstel dem Restitutionsfonds der Freien Gewerkschaften und dem Restitutionsfonds der Zentralkommission der christlichen Arbeiter- und Angestelltenorganisationen Österreichs (§§ 3 und 4 des Ersten Rückgabegesetz, BGBl. Nr. 55/1947) zu Übertragen oder mit dem Verkehrswert abzulösen ist.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "8.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gewerkschaftsbund der österreichischen Arbeiter und Angestellten (BGBl. I Nr. 132 und 243/1934 und Nr. 276/1935); Hauptkörperschaft der öffentlichen Bediensteten (Beamtenbund) und Fachkörperschaften (Kameradschaften) (§ 3 des Bundesgesetzes BGBl. II Nr. 294/1934); juristische Personen (Abs. 2), in deren Aufgabenbereich die Vertretung der arbeitsrechtlichen, wirtschaftlichen und sozialen Interessen der Arbeiter und Angestellten gefallen ist, soweit auf das Vermögen keine Rückgabeansprüche oder Rückstellungsansprüche anderer in Spalte A dieser Aufstellung oder des § 1 des 2. Rückstellungsanspruchsgesetzes genannten Vermögensträger bestehen; Werksumlagefonds nach § 21 des Bundesgesetzes über die Errichtung von Werksgemeinschaften, BGBl. II Nr. 153/1934, soweit es sich um einen nicht mehr bestehenden Betrieb handelt.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Betriebsratsfonds auf Grund des § 24 des Betriebsrätegesetzes, (BGBl. Nr. 97/1947).",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "9.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Werksumlagefonds nach § 21 des Bundesgesetzes über die Errichtung von Werksgemeinschaften, BGBl. II Nr. 153/1934, soweit es sich um den gleichen Betrieb handelt.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Urlaubskasse der Arbeiter in der Bauwirtschaft (BGBl. Nr. 81/1946).",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "10.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Bauarbeiter-Urlaubs- und Fürsorgekommission.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "11. a)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Restitutionsfonds der Sozialdemokratischen Organisationen beziehungsweise Restitutionsfonds der Freien Gewerkschaften (§§ 2 und 3 des Ersten Rückgabegesetzes, BGBl. Nr. 55/1947).",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "11. a)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Juristische Personen (Abs. 2), die nach ihren Statuten, Satzungen, Widmungsurkunden oder ihrer langjährigen Übung Zwecken der Sozialdemokratischen Arbeiterpartei beziehungsweise der freien Gewerkschaften gedient haben, auch dann, wenn deren Leitungen (Vereinsvorstände, Gesellschafter usw.) nach dem 12. Feber 1934 aus politischen Gründen verändert worden sind und ihre Rechtspersönlichkeit nach dem 13. März 1938 verloren und nicht wiedererlangt haben;",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "b)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Restitutionsfonds der Zentralkommission der christlichen Arbeiter- und Angestelltenorganisationen Österreichs (§ 4 des Ersten Rückgabegesetzes, BGBl. Nr. 55/1947).",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "b)",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "juristische Personen (Abs. 2), die nach ihren Statuten, Satzungen, Widmungsurkunden oder ihrer langjährigen Übung Zwecken der katholischen oder sonstigen christlichen Arbeiter- und Angestelltenorganisationen, jedoch nicht ausschließlich religiösen Zwecken (§ 1 Ziffer 4 des 2. Rückstellungsanspruchsgesetzes), gedient haben.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Zentralorganisation der Kriegsopferverbände Österreichs.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "12.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Einheitsverband der Kriegsopfer Österreichs (BGBl. Nr. 79/1936 und Nr. 203/1936).",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Der zuständige Landesverband der Österreichischen Gesellschaft vom Roten Kreuze.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "13.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Juristische Personen (Abs. 2) auf dem Gebiete des freiwilligen Rettungswesens, deren Aufgaben von einer Organisation der Österreichischen Gesellschaft vom Roten Kreuze übernommen worden sind.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die KÖB – Österreichische Staatseisenbahnen–Omnibusverkehrsgesellschaft m. b. H. mit der Maßgabe, daß das Bundesbahnsozialwerk mit seiner Einrichtung in die Rechte an dem in Rückstellung begriffenen oder rückgestellten Vermögen eintritt.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "14.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für die Bediensteten der Eisenbahnen oder deren Angehörige bestandenen Stiftungen, Fonds und sonstigen Einrichtungen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Wohlfahrtsfonds der Bundespolizei.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "15.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für die Bediensteten der Bundespolizei oder deren Angehörige bestandenen Stiftungen, Fonds und sonstigen Einrichtungen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Gendarmeriejubiläumsfonds 1949.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "16.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die für die Bediensteten der Bundespolizei oder deren Angehörige bestandenen Stiftungen, Fonds und sonstigen Einrichtungen.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Die nach dem Sitze der aufgelösten juristischen Person zuständige Ärztekammer (§ 20 des Ärztegesetzes vom 30. März 1949, BGBl. Nr. 92).",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "17.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Juristische Personen (Abs. 2), die karitativen beziehungsweise sozialen Zwecken der Ärzteschaft eines Bundeslandes gedient haben.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Rechtsanwaltskammer Wien.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "18.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Witwen- und Waisen-Pensions-Gesellschaft des juridischen Doktoren-Kollegiums in Wien.",
                "rowspan": 1,
                "colspan": 1
              }
            ],
            [
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Verband Österreichische Turnerschaft.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "19.",
                "rowspan": 1,
                "colspan": 1
              },
              {
                "text": "Vereine, die im „Reichsverband der christlich-deutschen Turnerschaft Österreichs“ zusammengeschlossen waren und nicht reaktiviert worden sind.",
                "rowspan": 1,
                "colspan": 1
              }
            ]
          ],
          "merged_cells": true
        }
      ]
    },
